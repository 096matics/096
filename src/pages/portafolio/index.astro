---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectorCard from '../../components/SectorCard.astro';

const sectores = await getCollection('sectores');
---

<Layout title="Portafolio">
	<Header />
	<main class="mx-auto max-w-5xl px-6 py-16">
		<p class="text-sm tracking-widest text-amber-400 uppercase">Portafolio</p>
		<h1 class="mt-3 text-3xl font-semibold text-white">Ejemplos por sector</h1>
		<p class="mt-3 max-w-xl text-zinc-400">
			Así se vería la tarjeta NFC en tu negocio. Elige el sector más parecido al tuyo.
		</p>
		<div class="mt-10 grid gap-4 sm:grid-cols-2">
			{
				sectores.map((s) => (
					<SectorCard
						slug={s.id}
						titulo={s.data.titulo}
						resumen={s.data.resumen}
						negocioEjemplo={s.data.negocioEjemplo}
						colorHex={s.data.colorHex}
					/>
				))
			}
		</div>
	</main>
	<Footer />
</Layout>
