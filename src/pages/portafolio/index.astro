---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PlantillaCard from '../../components/PlantillaCard.astro';
import { ordenarPorSector } from '../../lib/ordenSectores';

const plantillas = await getCollection('plantillas');
const personalItems = plantillas.filter((p) => p.data.categoria === 'personal' && p.data.estado === 'publico');
// solo sectores con diseño ya entregado; lo "proximamente" va aparte para no mezclarlo como si
// ya existiera junto a lo que sí está en producción. Las reseñas de Google, al ser uno de los dos
// productos principales, se destacan arriba aunque sigan en camino; el resto de próximamente va abajo.
const sectorItems = plantillas.filter((p) => p.data.categoria === 'sector' && p.data.estado === 'publico');
const resenasItems = plantillas.filter((p) => p.data.categoria === 'sector' && p.data.estado === 'proximamente' && p.data.sector === 'Reseñas Google');
const otrosProximamenteItems = plantillas.filter(
	(p) => p.data.categoria === 'sector' && p.data.estado === 'proximamente' && p.data.sector !== 'Reseñas Google'
);

function agruparPorSector(items: typeof sectorItems) {
	const grupos = new Map<string, typeof sectorItems>();
	for (const item of items) {
		const clave = item.data.sector ?? 'Otros';
		if (!grupos.has(clave)) grupos.set(clave, []);
		grupos.get(clave)!.push(item);
	}
	return grupos;
}
const grupos = ordenarPorSector([...agruparPorSector(sectorItems).entries()]);
const gruposOtrosProximamente = ordenarPorSector([...agruparPorSector(otrosProximamenteItems).entries()]);

// un único selector de sector en vez de dos listados largos por separado: cada sector
// junta lo real ya entregado y lo que aún está en camino, y solo se ve un panel a la vez.
type Item = (typeof sectorItems)[number];
const porSector = new Map<string, { real: Item[]; proximamente: Item[] }>();
for (const [sector, items] of grupos) porSector.set(sector, { real: items, proximamente: [] });
for (const [sector, items] of gruposOtrosProximamente) {
	const entry = porSector.get(sector) ?? { real: [], proximamente: [] };
	entry.proximamente = items;
	porSector.set(sector, entry);
}
const sectoresOrdenados = ordenarPorSector([...porSector.entries()]);

function slugSector(sector: string) {
	return sector
		.toLowerCase()
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');
}
---

<Layout title="Portafolio">
	<Header />
	<main class="mx-auto max-w-6xl px-6 py-16">
		<p class="text-sm tracking-widest text-amber-400 uppercase">Portafolio</p>
		<h1 class="mt-3 text-3xl font-semibold text-white">Plantillas y ejemplos reales</h1>
		<p class="mt-3 max-w-xl text-zinc-400">
			Así se ven nuestras tarjetas NFC en la práctica. Para que no se te mezclen: primero el
			equipo, luego las reseñas de Google, después los ejemplos ya entregados por sector.
		</p>

		{
			personalItems.length > 0 && (
				<section class="mt-14">
					<div class="flex items-center gap-2.5">
						<span class="h-2 w-2 shrink-0 rounded-full bg-indigo-400" />
						<h2 class="text-sm font-bold tracking-widest text-indigo-300 uppercase">Nuestro equipo</h2>
					</div>
					<p class="mt-1.5 text-sm text-zinc-500">Tarjetas personales, no ejemplos de negocio — las nuestras.</p>
					<div class="mt-6 grid gap-8 sm:grid-cols-3">
						{personalItems.map((p) => (
							<a href={p.data.ruta} class="team-card group block text-center">
								<div class="relative mx-auto aspect-square w-full max-w-[210px] overflow-hidden rounded-full border border-white/10 bg-zinc-900">
									{p.data.imagen && (
										<img
											src={p.data.imagen}
											alt={p.data.nombre}
											class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
											loading="lazy"
										/>
									)}
									<span class="pointer-events-none absolute inset-0 rounded-full ring-1 ring-inset ring-white/10 transition-all duration-300 group-hover:ring-indigo-400/50" />
								</div>
								<h3 class="mt-4 text-base font-semibold text-white">{p.data.nombre}</h3>
								<p class="mt-1 text-xs text-zinc-500">{p.data.descripcion}</p>
								<span class="mt-2 inline-block text-xs font-semibold text-indigo-300 transition-colors group-hover:text-indigo-200">Ver tarjeta →</span>
							</a>
						))}
					</div>
				</section>
			)
		}

		{
			resenasItems.length > 0 && (
				<section class="mt-14 rounded-3xl border border-amber-400/15 bg-amber-500/[0.03] p-6 sm:p-8">
					<div class="flex items-center gap-2.5">
						<span class="h-2 w-2 shrink-0 animate-pulse rounded-full bg-amber-400" />
						<h2 class="text-sm font-bold tracking-widest text-amber-300 uppercase">Reseñas de Google</h2>
					</div>
					<p class="mt-1.5 max-w-xl text-sm text-zinc-500">
						El otro camino de la tarjeta, en marcha — estos estilos se están terminando de pulir y
						todavía no están disponibles para pedir.
					</p>
					<div class="mt-6 grid gap-4 sm:grid-cols-3">
						{resenasItems.map((p) => (
							<div class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 opacity-70">
								{p.data.imagen && <img src={p.data.imagen} alt={p.data.nombre} class="aspect-[4/5] w-full object-cover grayscale" loading="lazy" />}
								<div class="p-5">
									<span class="inline-block rounded-full border border-zinc-700 bg-zinc-900 px-2 py-0.5 text-[10px] font-bold tracking-wide text-zinc-500 uppercase">
										Próximamente
									</span>
									<h3 class="mt-2 text-base font-medium text-zinc-300">{p.data.nombre}</h3>
									<p class="mt-1 text-sm text-zinc-500">{p.data.descripcion}</p>
								</div>
							</div>
						))}
					</div>
				</section>
			)
		}

		{
			sectoresOrdenados.length > 0 && (
				<section class="mt-10">
					<div class="flex items-center gap-2.5">
						<span class="h-2 w-2 shrink-0 rounded-full bg-white" />
						<h2 class="text-sm font-bold tracking-widest text-zinc-300 uppercase">Por sector</h2>
					</div>
					<p class="mt-1.5 text-sm text-zinc-500">Todos los sectores, uno detrás de otro — salta a uno si ya sabes cuál buscas.</p>

					<div class="sector-picker mt-6 flex flex-wrap gap-2">
						{sectoresOrdenados.map(([sector, entry]) => (
							<a
								href={`#sector-${slugSector(sector)}`}
								class="sector-chip rounded-full border border-zinc-800 bg-white/[0.03] px-3.5 py-1.5 text-xs font-medium text-zinc-400 transition-colors hover:border-zinc-600 hover:text-white"
							>
								{sector}
								{entry.real.length === 0 && <span class="ml-1.5 inline-block h-1.5 w-1.5 rounded-full bg-zinc-500 align-middle" title="Próximamente" />}
							</a>
						))}
					</div>

					<div class="mt-4 divide-y divide-zinc-900">
						{sectoresOrdenados.map(([sector, entry]) => (
							<div id={`sector-${slugSector(sector)}`} class="scroll-mt-24 py-8 first:pt-6">
								<h3 class="text-lg font-semibold text-white">{sector}</h3>
								{entry.real.length > 0 && (
									<div class="mt-4 grid gap-4 sm:grid-cols-3">
										{entry.real.map((p) => (
											<PlantillaCard
												nombre={p.data.nombre}
												descripcion={p.data.descripcion}
												sector={sector}
												colorHex={p.data.colorHex}
												imagen={p.data.imagen}
												ruta={p.data.ruta}
											/>
										))}
									</div>
								)}
								{entry.proximamente.length > 0 && (
									<div class={entry.real.length > 0 ? 'mt-6' : 'mt-4'}>
										{entry.real.length > 0 && (
											<p class="text-xs font-semibold tracking-wide text-zinc-500 uppercase">También en camino en este sector</p>
										)}
										<div class="mt-3 grid gap-4 sm:grid-cols-3">
											{entry.proximamente.map((p) => (
												<div class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 opacity-60">
													{p.data.imagen && <img src={p.data.imagen} alt={p.data.nombre} class="aspect-[4/5] w-full object-cover grayscale" loading="lazy" />}
													<div class="p-5">
														<span class="inline-block rounded-full border border-zinc-700 bg-zinc-900 px-2 py-0.5 text-[10px] font-bold tracking-wide text-zinc-500 uppercase">
															Próximamente
														</span>
														<h3 class="mt-2 text-base font-medium text-zinc-300">{p.data.nombre}</h3>
														<p class="mt-1 text-sm text-zinc-500">{p.data.descripcion}</p>
													</div>
												</div>
											))}
										</div>
									</div>
								)}
							</div>
						))}
					</div>
				</section>
			)
		}
	</main>
	<Footer />
</Layout>
