---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import Mecanismo from '../components/landing/Mecanismo.astro';
import PortafolioPreview from '../components/landing/PortafolioPreview.astro';
import QuienesSomos from '../components/landing/QuienesSomos.astro';
import Proceso from '../components/landing/Proceso.astro';
import ProductoFuturo from '../components/landing/ProductoFuturo.astro';
import Objeciones from '../components/landing/Objeciones.astro';
import Contacto from '../components/landing/Contacto.astro';
---

<Layout title="Tarjetas NFC para negocios locales">
	<div class="ambient-glow" aria-hidden="true"></div>
	<div class="bg-grid" aria-hidden="true"></div>
	<div class="grain-overlay" aria-hidden="true"></div>

	<Nav />

	<main>
		<!-- Antes: el problema y la promesa de un solo toque -->
		<Hero />
		<!-- El toque: el mecanismo se bifurca en dos resultados posibles -->
		<Mecanismo />
		<PortafolioPreview />
		<!-- Quién hay detrás, antes de pedir el compromiso -->
		<QuienesSomos />
		<!-- La logística: cómo se instala de verdad -->
		<Proceso />
		<ProductoFuturo />
		<Objeciones />
		<Contacto />
	</main>

	<footer class="border-t border-zinc-800 py-8">
		<div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-5 text-center sm:px-6">
			<p class="text-xs text-zinc-600">© {new Date().getFullYear()} 096matics · Sagunto, Valencia</p>
		</div>
	</footer>
</Layout>
