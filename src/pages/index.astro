---
import Layout from '../layouts/Layout.astro';
import Pulso from '../components/landing/Pulso.astro';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import ProductoBlock from '../components/landing/ProductoBlock.astro';
import QuienesSomos from '../components/landing/QuienesSomos.astro';
import PortafolioPreview from '../components/landing/PortafolioPreview.astro';
import Contacto from '../components/landing/Contacto.astro';
---

<Layout title="Tarjetas NFC para negocios locales">
	<Pulso />
	<Nav />
	<main class="landing-pager">
		<div class="ambient-glow" aria-hidden="true"></div>
		<div class="grain-overlay" aria-hidden="true"></div>
		<div class="pager-track" id="pagerTrack">
			<Hero />
			<div class="pager-spacer" aria-hidden="true"></div>

			<ProductoBlock
				id="producto-personal"
				navLabel="Tarjetas personales"
				numero="Producto 1 · Tarjetas personales"
				titulo="Tu contacto, en un toque"
				descripcion="Una tarjeta NFC de presentación digital para profesionales: un toque y tu cliente guarda tu teléfono, email, redes o web, sin repartir tarjetas de papel."
				paraQuien="Para autónomos, comerciales y equipos que quieren dar una buena primera impresión."
				accent="brand"
				accentHex="#6366f1"
				glowA="#6366f1"
				glowB="#8b5cf6"
				mockupTipo="contacto"
				mockupNegocio="tu perfil"
				ctaTexto="Pide tu tarjeta personal"
				ctaMensaje="Hola, quiero una tarjeta NFC personal"
				pasos={[
					{ titulo: 'Acerca la tarjeta', descripcion: 'Un toque del móvil de la otra persona sobre tu tarjeta.' },
					{
						titulo: 'Se abre tu perfil',
						descripcion: 'Tu landing personal se carga al instante, sin apps ni códigos QR.',
					},
					{
						titulo: 'Guarda tu contacto',
						descripcion: 'Con un botón, tus datos quedan guardados en su móvil para siempre.',
					},
				]}
			/>
			<div class="pager-spacer" aria-hidden="true"></div>

			<ProductoBlock
				id="producto-google"
				navLabel="Reseñas Google"
				numero="Producto 2 · Reseñas de Google"
				titulo="Reseñas de Google, sin fricción"
				descripcion="Tu cliente acerca el móvil a la tarjeta y aterriza directo en la ventana de dejar una reseña en tu ficha de Google. Sin apps, sin buscar el nombre del negocio, sin escribir nada a mano."
				paraQuien="Pensado para negocios con pocas reseñas que necesitan reputación online rápido."
				accent="amber"
				accentHex="#f59e0b"
				glowA="#f59e0b"
				glowB="#fb7185"
				mockupTipo="resena"
				mockupNegocio="tu negocio"
				ctaTexto="Pide tu tarjeta de reseñas"
				ctaMensaje="Hola, quiero tarjetas NFC para reseñas de Google"
				conStats={true}
				pasos={[
					{ titulo: 'Acerca la tarjeta', descripcion: 'Un toque del móvil de tu cliente sobre la tarjeta NFC.' },
					{
						titulo: 'Se abre tu ficha de Google',
						descripcion: 'Directo a dejar la reseña, sin apps ni buscar el nombre del negocio.',
					},
					{
						titulo: 'Reseña publicada',
						descripcion: 'En menos de 10 segundos, antes de que se levante de la mesa.',
					},
				]}
			/>

			<div class="pager-spacer" aria-hidden="true"></div>
			<QuienesSomos />
			<div class="pager-spacer" aria-hidden="true"></div>
			<PortafolioPreview />
			<div class="pager-spacer" aria-hidden="true"></div>
			<Contacto />
		</div>
	</main>
</Layout>

<script>
	const root = document.querySelector('.landing-pager') as HTMLElement | null;
	const track = document.getElementById('pagerTrack');
	const ambientGlow = document.querySelector('.ambient-glow') as HTMLElement | null;
	const sideNavTrack = document.querySelector('.side-nav-track') as HTMLElement | null;
	const sideNav = document.getElementById('landingSideNav');
	const sideNavList = document.getElementById('landingSideNavList');
	const sideNavLogo = document.getElementById('landingSideNavLogo');
	const sideNavIndicator = document.getElementById('landingSideNavIndicator');
	const sideNavRail = document.querySelector('.side-nav-rail') as HTMLElement | null;

	if (root && track) {
		const pages = Array.from(track.querySelectorAll<HTMLElement>('[data-page]'));
		const MS_PER_100VH = 950; // ritmo del "viaje": ms por cada 100dvh recorrido
		const MIN_DURATION = 1100;
		const MAX_DURATION = 2400;
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let current = 0;
		let locked = false;
		let indicatorMidY = 0; // último centro Y conocido del punto (sin el ajuste de -5 del radio)

		function durationFor(distancePx: number) {
			const ratio = distancePx / window.innerHeight;
			return Math.min(MAX_DURATION, Math.max(MIN_DURATION, ratio * MS_PER_100VH));
		}

		function updateAccent(page: HTMLElement, durationMs: number) {
			const a = page.dataset.glowA ?? '#6366f1';
			const b = page.dataset.glowB ?? '#a855f7';
			if (ambientGlow) {
				ambientGlow.style.transitionDuration = `${durationMs}ms`;
				ambientGlow.style.setProperty('--glow-a', a);
				ambientGlow.style.setProperty('--glow-b', b);
			}
			if (sideNavTrack) {
				sideNavTrack.style.transitionDuration = `${durationMs}ms`;
				sideNavTrack.style.setProperty('--dot-a', a);
				sideNavTrack.style.setProperty('--dot-b', b);
			}
		}
		updateAccent(pages[0], 0);

		const navButtons: HTMLButtonElement[] = [];
		pages.forEach((p, i) => {
			const label = p.dataset.nav;
			if (!label || !sideNavList) return;
			const li = document.createElement('li');
			const btn = document.createElement('button');
			btn.className = 'side-nav-item';
			btn.innerHTML = `<span class="side-nav-label">${label}</span>`;
			btn.addEventListener('click', () => goToPage(i));
			li.appendChild(btn);
			sideNavList.appendChild(li);
			navButtons.push(btn);
		});

		function setActiveNav(index: number): number | null {
			const label = pages[index]?.dataset.nav;
			let activeBtn: HTMLButtonElement | null = null;
			navButtons.forEach((btn) => {
				const btnLabel = btn.querySelector('.side-nav-label')?.textContent;
				const isActive = !!label && btnLabel === label;
				btn.classList.toggle('active', isActive);
				if (isActive) activeBtn = btn;
			});
			let activeMid: number | null = null;
			if (navButtons.length > 0) {
				// el tamaño/hueco de los items también transiciona (el activo crece y empuja a los demás);
				// medimos las posiciones FINALES desactivando esas transiciones un instante, sin repintar
				sideNavTrack?.classList.add('nav-measuring');
				const first = navButtons[0];
				const last = navButtons[navButtons.length - 1];
				// redondeamos a px enteros: el punto (posicionado con transform) y la línea/palabra
				// (en flujo normal) pueden redondear los subpíxeles de forma distinta y verse desalineados
				const firstMid = Math.round(first.offsetTop + first.offsetHeight / 2);
				const lastMid = Math.round(last.offsetTop + last.offsetHeight / 2);
				activeMid = activeBtn ? Math.round(activeBtn.offsetTop + activeBtn.offsetHeight / 2) : null;
				sideNavTrack?.classList.remove('nav-measuring');

				if (sideNavRail) {
					sideNavRail.style.top = `${firstMid}px`;
					sideNavRail.style.bottom = 'auto';
					sideNavRail.style.height = `${lastMid - firstMid}px`;
				}
				if (activeMid !== null && sideNavIndicator) {
					indicatorMidY = activeMid;
					sideNavIndicator.style.transform = `translateY(${activeMid - 5}px)`;
					sideNavIndicator.classList.add('is-visible');
				}
			}
			return activeMid;
		}

		function goToPage(index: number) {
			index = Math.max(0, Math.min(pages.length - 1, index));
			if (index === current || locked) return;
			locked = true;

			const oldPage = pages[current];
			const newPage = pages[index];
			const distance = Math.abs(newPage.offsetTop - oldPage.offsetTop);
			const duration = durationFor(distance);
			current = index;

			newPage.scrollTop = 0;
			const indicatorFromY = indicatorMidY;
			const indicatorToY = setActiveNav(current);
			updateAccent(newPage, duration);

			newPage.classList.remove('is-revealing');
			void newPage.offsetWidth;
			newPage.classList.add('is-revealing');

			if (prefersReducedMotion) {
				track.style.transition = 'none';
				track.style.transform = `translateY(-${newPage.offsetTop}px)`;
				void track.offsetWidth;
				track.style.transition = '';
				window.setTimeout(() => {
					locked = false;
				}, duration);
				return;
			}

			// viaje en dos tramos dentro de una única animación nativa: aceleramos hasta el punto intermedio
			// (la página vacía), una pequeña pausa ahí, y frenamos hasta el destino — el carril y el punto de
			// la barra lateral comparten exactamente los mismos tiempos para no desincronizarse nunca
			const midOffset = (oldPage.offsetTop + newPage.offsetTop) / 2;
			const PAUSE_MS = 90;
			const phase1 = Math.max(250, duration * 0.42);
			const phase2 = Math.max(300, duration - phase1 - PAUSE_MS);
			const total = phase1 + PAUSE_MS + phase2;
			const off1 = phase1 / total;
			const off2 = (phase1 + PAUSE_MS) / total;
			const EASE_IN = 'cubic-bezier(0.6, 0, 1, 0.4)';
			const EASE_OUT = 'cubic-bezier(0, 0.6, 0.4, 1)';

			ambientGlow?.classList.add('is-paused');

			track.getAnimations().forEach((a) => a.cancel());
			const trackAnim = track.animate(
				[
					{ transform: `translateY(-${oldPage.offsetTop}px)`, offset: 0, easing: EASE_IN },
					{ transform: `translateY(-${midOffset}px)`, offset: off1 },
					{ transform: `translateY(-${midOffset}px)`, offset: off2, easing: EASE_OUT },
					{ transform: `translateY(-${newPage.offsetTop}px)`, offset: 1 },
				],
				{ duration: total, fill: 'forwards' }
			);
			trackAnim.onfinish = () => {
				track.style.transform = `translateY(-${newPage.offsetTop}px)`;
			};

			if (sideNavIndicator && indicatorToY !== null) {
				const midIndY = (indicatorFromY + indicatorToY) / 2;
				sideNavIndicator.getAnimations().forEach((a) => a.cancel());
				const indAnim = sideNavIndicator.animate(
					[
						{ transform: `translateY(${indicatorFromY - 5}px)`, offset: 0, easing: EASE_IN },
						{ transform: `translateY(${midIndY - 5}px)`, offset: off1 },
						{ transform: `translateY(${midIndY - 5}px)`, offset: off2, easing: EASE_OUT },
						{ transform: `translateY(${indicatorToY - 5}px)`, offset: 1 },
					],
					{ duration: total, fill: 'forwards' }
				);
				indAnim.onfinish = () => {
					sideNavIndicator.style.transform = `translateY(${indicatorToY - 5}px)`;
				};
			}

			window.setTimeout(() => {
				ambientGlow?.classList.remove('is-paused');
				locked = false;
			}, total);
		}

		// El logo del lateral te devuelve al principio: reaparece el pulso de entrada
		sideNavLogo?.addEventListener('click', () => {
			pages.forEach((p) => p.classList.remove('is-revealing'));
			track.style.transition = 'none';
			track.style.transform = 'translateY(0)';
			void track.offsetWidth;
			track.style.transition = '';
			current = 0;
			locked = false;
			setActiveNav(0);
			updateAccent(pages[0], 0);
			sideNav?.classList.add('opacity-0');
			const pulso = document.getElementById('pulso');
			if (pulso) {
				document.documentElement.classList.add('overflow-hidden');
				pulso.classList.remove('pulso-exit');
			}
		});

		function atTop(page: HTMLElement) {
			return page.scrollTop <= 1;
		}
		function atBottom(page: HTMLElement) {
			return Math.ceil(page.scrollTop + page.clientHeight) >= page.scrollHeight - 1;
		}

		let wheelBuffer = 0;
		window.addEventListener(
			'wheel',
			(e) => {
				const page = pages[current];
				if (locked) {
					e.preventDefault();
					return;
				}
				if (e.deltaY > 0 && !atBottom(page)) return;
				if (e.deltaY < 0 && !atTop(page)) return;
				e.preventDefault();
				wheelBuffer += e.deltaY;
				if (Math.abs(wheelBuffer) > 34) {
					goToPage(current + (wheelBuffer > 0 ? 1 : -1));
					wheelBuffer = 0;
				}
			},
			{ passive: false }
		);

		let touchStartY: number | null = null;
		let touchStartedAtEdge = false;
		window.addEventListener(
			'touchstart',
			(e) => {
				touchStartY = e.touches[0].clientY;
				const page = pages[current];
				touchStartedAtEdge = atTop(page) || atBottom(page);
			},
			{ passive: true }
		);
		window.addEventListener(
			'touchmove',
			(e) => {
				if (locked) {
					e.preventDefault();
					return;
				}
				if (touchStartY === null) return;
				const page = pages[current];
				const dy = touchStartY - e.touches[0].clientY;
				const goingDown = dy > 0;
				if (goingDown && !atBottom(page)) return;
				if (!goingDown && !atTop(page)) return;
				e.preventDefault();
			},
			{ passive: false }
		);
		window.addEventListener(
			'touchend',
			(e) => {
				if (touchStartY === null || locked) {
					touchStartY = null;
					return;
				}
				const page = pages[current];
				const dy = touchStartY - e.changedTouches[0].clientY;
				const goingDown = dy > 0;
				const canAdvance = goingDown ? atBottom(page) : atTop(page);
				if (canAdvance && Math.abs(dy) > 40) {
					goToPage(current + (goingDown ? 1 : -1));
				}
				touchStartY = null;
			},
			{ passive: true }
		);

		window.addEventListener('keydown', (e) => {
			if (locked) return;
			const page = pages[current];
			if ((e.key === 'ArrowDown' || e.key === 'PageDown') && atBottom(page)) {
				e.preventDefault();
				goToPage(current + 1);
			}
			if ((e.key === 'ArrowUp' || e.key === 'PageUp') && atTop(page)) {
				e.preventDefault();
				goToPage(current - 1);
			}
		});

		// enlaces internos (#producto-personal, etc.) navegan por el paginador en vez de saltar
		document.querySelectorAll('a[href^="#"]').forEach((a) => {
			a.addEventListener('click', (e) => {
				const href = a.getAttribute('href');
				const idx = pages.findIndex((p) => `#${p.id}` === href);
				if (idx === -1) return;
				e.preventDefault();
				goToPage(idx);
			});
		});

		window.addEventListener('pulso:dismissed', () => {
			sideNav?.classList.remove('opacity-0');
			const first = pages[current];
			first.classList.remove('is-revealing');
			void first.offsetWidth;
			first.classList.add('is-revealing');
			setActiveNav(current);
		});

		// Si llegamos desde un enlace tipo /#contacto, nos saltamos el pulso y vamos directos a esa sección
		const hashTarget = window.location.hash
			? pages.findIndex((p) => `#${p.id}` === window.location.hash)
			: -1;
		if (hashTarget > 0) {
			const jumpToHash = () => {
				current = hashTarget;
				const target = pages[hashTarget];
				// el navegador hace su propio scroll nativo al hash antes de que corra este script; lo anulamos
				root.scrollTop = 0;
				target.scrollTop = 0;
				track.style.transition = 'none';
				track.style.transform = `translateY(-${target.offsetTop}px)`;
				void track.offsetWidth;
				track.style.transition = '';
				updateAccent(target, 0);
				document.getElementById('pulso')?.click();
			};
			// el viewport (dvh) puede tardar un poco en asentarse tras la carga inicial; esperamos a que
			// la página esté totalmente cargada y a un par de frames más antes de medir posiciones
			const runJump = () => requestAnimationFrame(() => requestAnimationFrame(jumpToHash));
			if (document.readyState === 'complete') {
				runJump();
			} else {
				window.addEventListener('load', runJump);
			}
		}
	}
</script>
