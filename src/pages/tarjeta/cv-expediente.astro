---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Ficha profesional — Conductor · 096matics</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--paper: #fafaf7;
				--navy: #1b3a5c;
				--navy-dim: #3e5a78;
				--ink: #232323;
				--ink-dim: rgba(35, 35, 35, 0.62);
				--ink-faint: rgba(35, 35, 35, 0.4);
				--line: rgba(27, 58, 92, 0.18);
				--gold: #b08a3e;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				overflow: hidden;
				overscroll-behavior: none;
				background: #e4e1d8;
			}
			body {
				height: 100dvh;
				font-family: 'IBM Plex Sans', sans-serif;
				color: var(--ink);
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 18px;
			}
			.sheet {
				width: 100%;
				max-width: 380px;
				background: var(--paper);
				border: 1px solid var(--line);
				box-shadow: 0 25px 50px -22px rgba(27, 58, 92, 0.35);
				animation: paperDrop 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
			}
			@keyframes paperDrop {
				from {
					opacity: 0;
					transform: translateY(-60px) rotate(-3deg);
				}
				to {
					opacity: 1;
					transform: translateY(0) rotate(0deg);
				}
			}
			@media (max-height: 700px) {
				body {
					padding: 12px;
				}
			}
			.doc-header {
				background: var(--navy);
				color: #fff;
				padding: 12px 18px;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			.doc-title {
				font-size: 10px;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				opacity: 0.85;
			}
			.doc-ref {
				font-size: 9.5px;
				opacity: 0.6;
				font-family: 'IBM Plex Sans', sans-serif;
			}
			.body {
				padding: 22px 20px 20px;
			}
			.top-row {
				display: flex;
				gap: 14px;
				margin-bottom: 18px;
				padding-bottom: 18px;
				border-bottom: 1px solid var(--line);
			}
			.photo {
				width: 76px;
				height: 96px;
				border: 1px solid var(--line);
				background: linear-gradient(160deg, #dfe3e8, #c7ccd3);
				flex-shrink: 0;
			}
			.id-block {
				padding-top: 2px;
			}
			.name {
				font-family: 'Source Serif 4', serif;
				font-size: 19px;
				font-weight: 700;
				margin: 0 0 3px;
				line-height: 1.2;
			}
			.role {
				font-size: 11.5px;
				color: var(--navy-dim);
				font-weight: 600;
				margin: 0 0 8px;
			}
			.available {
				display: inline-flex;
				align-items: center;
				gap: 5px;
				font-size: 9.5px;
				font-weight: 600;
				letter-spacing: 0.02em;
				color: var(--navy);
				border: 1px solid var(--navy);
				padding: 3px 8px;
			}
			.available .dot {
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: var(--navy);
			}
			.section {
				margin-bottom: 16px;
			}
			.section-label {
				font-size: 9.5px;
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--navy);
				margin: 0 0 8px;
				display: flex;
				align-items: center;
				gap: 8px;
			}
			.section-label::after {
				content: '';
				flex: 1;
				height: 1px;
				background: var(--line);
			}
			.data-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 10px 16px;
			}
			.data-item label {
				display: block;
				font-size: 8.5px;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--ink-faint);
				margin-bottom: 2px;
			}
			.data-item span {
				font-size: 12.5px;
				color: var(--ink);
			}
			.cert-list {
				display: flex;
				flex-direction: column;
				gap: 7px;
			}
			.cert-item {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 12px;
				opacity: 0;
				animation: certFadeUp 0.5s ease forwards;
			}
			.cert-item:nth-child(1) {
				animation-delay: 0.5s;
			}
			.cert-item:nth-child(2) {
				animation-delay: 0.62s;
			}
			.cert-item:nth-child(3) {
				animation-delay: 0.74s;
			}
			.cert-item:nth-child(4) {
				animation-delay: 0.86s;
			}
			@keyframes certFadeUp {
				from {
					opacity: 0;
					transform: translateY(6px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			.cert-item .seal {
				width: 16px;
				height: 16px;
				border-radius: 50%;
				border: 1.4px solid var(--gold);
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
			}
			.cert-item .seal svg {
				width: 9px;
				height: 9px;
				color: var(--gold);
			}
			.cert-item .cert-note {
				color: var(--ink-faint);
				font-size: 10.5px;
			}
			.quote {
				font-family: 'Source Serif 4', serif;
				font-style: italic;
				font-size: 12.5px;
				color: var(--ink-dim);
				line-height: 1.55;
				margin: 0;
				padding-left: 12px;
				border-left: 2px solid var(--gold);
			}
			.contact-row {
				display: flex;
				gap: 8px;
				margin-top: 4px;
			}
			.btn {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 7px;
				padding: 11px;
				text-decoration: none;
				font-size: 12px;
				font-weight: 600;
			}
			.btn svg {
				width: 14px;
				height: 14px;
			}
			.btn.primary {
				background: var(--navy);
				color: #fff;
			}
			.btn.secondary {
				background: transparent;
				color: var(--navy);
				border: 1px solid var(--navy);
			}
			.doc-footer {
				text-align: center;
				padding: 10px;
				font-size: 8.5px;
				letter-spacing: 0.08em;
				color: var(--ink-faint);
				border-top: 1px solid var(--line);
			}
		</style>
	</head>
	<body>
		<div class="sheet">
			<div class="doc-header">
				<span class="doc-title">Ficha profesional</span>
				<span class="doc-ref">Ref. 096-CV-01</span>
			</div>

			<div class="body">
				<div class="top-row">
					<div class="photo"></div>
					<div class="id-block">
						<p class="name">[Nombre del<br />conductor]</p>
						<p class="role">Conductor profesional</p>
						<span class="available"><span class="dot"></span>Disponible</span>
					</div>
				</div>

				<div class="section">
					<p class="section-label">Perfil</p>
					<div class="data-grid">
						<div class="data-item"><label>Experiencia</label><span>[XX] años</span></div>
						<div class="data-item"><label>Rutas</label><span>Nacional</span></div>
						<div class="data-item"><label>Vehículo</label><span>[Tráiler / rígido...]</span></div>
						<div class="data-item"><label>Disponibilidad</label><span>Inmediata</span></div>
					</div>
				</div>

				<div class="section">
					<p class="section-label">Carnets y certificados</p>
					<div class="cert-list">
						<div class="cert-item">
							<span class="seal"
								><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
									><polyline points="20 6 9 17 4 12"></polyline></svg
								></span
							>
							Carnet C+E
						</div>
						<div class="cert-item">
							<span class="seal"
								><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
									><polyline points="20 6 9 17 4 12"></polyline></svg
								></span
							>
							CAP <span class="cert-note">— vigente</span>
						</div>
						<div class="cert-item">
							<span class="seal"
								><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
									><polyline points="20 6 9 17 4 12"></polyline></svg
								></span
							>
							ADR <span class="cert-note">— mercancías peligrosas</span>
						</div>
						<div class="cert-item">
							<span class="seal"
								><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
									><polyline points="20 6 9 17 4 12"></polyline></svg
								></span
							>
							Tacógrafo digital
						</div>
					</div>
				</div>

				<div class="section">
					<p class="section-label">Nota personal</p>
					<p class="quote">
						"[Frase personal del conductor — puntualidad, cuidado con la carga, experiencia en rutas
						largas...]"
					</p>
				</div>

				<div class="contact-row">
					<a class="btn primary" href="tel:+34727700065">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
							><path
								d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
							></path></svg
						>
						Llamar
					</a>
					<a class="btn secondary" href="https://wa.me/34727700065" target="_blank">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
							><path
								d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
							></path></svg
						>
						WhatsApp
					</a>
				</div>
			</div>

			<div class="doc-footer">096matics · Ficha digital verificada</div>
		</div>
	</body>
</html>
