---
const whatsapp = 'https://wa.me/34727700065?text=' + encodeURIComponent('Hola, me interesa la plantilla Arcade');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Pixel Bar — 096matics</title>
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
		<style>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				overflow: hidden;
				overscroll-behavior: none;
				background: #05020a;
			}
			body {
				height: 100dvh;
				font-family: 'IBM Plex Sans', sans-serif;
				color: #f2f0ff;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 24px 14px;
				position: relative;
				background:
					radial-gradient(ellipse 500px 340px at 50% 20%, rgba(255, 0, 200, 0.18), transparent 65%),
					radial-gradient(ellipse 500px 340px at 50% 90%, rgba(0, 220, 255, 0.14), transparent 65%),
					#05020a;
			}
			body::before {
				content: '';
				position: absolute;
				inset: 0;
				background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 3px);
				pointer-events: none;
				z-index: 5;
			}
			.cab {
				width: 100%;
				max-width: 380px;
				border: 3px solid #ff2ec4;
				border-radius: 18px;
				background: #0c0616;
				box-shadow:
					0 0 0 4px #05020a,
					0 0 40px rgba(255, 46, 196, 0.35),
					0 30px 70px -25px rgba(0, 0, 0, 0.8);
				padding: 22px 20px 24px;
				position: relative;
				animation: flicker 2.4s ease-in-out infinite;
			}
			@keyframes flicker {
				0%,
				96%,
				100% {
					box-shadow:
						0 0 0 4px #05020a,
						0 0 40px rgba(255, 46, 196, 0.35),
						0 30px 70px -25px rgba(0, 0, 0, 0.8);
				}
				97% {
					box-shadow:
						0 0 0 4px #05020a,
						0 0 18px rgba(255, 46, 196, 0.2),
						0 30px 70px -25px rgba(0, 0, 0, 0.8);
				}
			}
			.title {
				font-family: 'Press Start 2P', monospace;
				font-size: 10px;
				text-align: center;
				color: #ffe94d;
				letter-spacing: 0.05em;
				margin: 0 0 6px;
				text-shadow: 2px 2px 0 #ff2ec4;
			}
			.name {
				font-family: 'Press Start 2P', monospace;
				font-size: 15px;
				text-align: center;
				color: #00e5ff;
				margin: 0 0 16px;
				text-shadow: 2px 2px 0 #ff2ec4;
				line-height: 1.6;
				animation: nameGlitch 5s ease-in-out infinite;
			}
			@keyframes nameGlitch {
				0%,
				92%,
				100% {
					text-shadow: 2px 2px 0 #ff2ec4;
					transform: translate(0, 0);
				}
				93% {
					text-shadow:
						-2px 0 0 #ff2ec4,
						2px 0 0 #00e5ff;
					transform: translate(-1px, 0);
				}
				95% {
					text-shadow:
						2px 0 0 #ff2ec4,
						-2px 0 0 #00e5ff;
					transform: translate(1px, 0);
				}
				97% {
					text-shadow: 2px 2px 0 #ff2ec4;
					transform: translate(0, 0);
				}
			}
			.screen {
				background: #05020a;
				border: 2px solid rgba(0, 229, 255, 0.4);
				border-radius: 8px;
				padding: 14px 12px;
				margin-bottom: 18px;
			}
			.row {
				display: flex;
				justify-content: space-between;
				font-size: 11px;
				padding: 5px 0;
				border-bottom: 1px dashed rgba(242, 240, 255, 0.15);
				color: #f2f0ff;
			}
			.row:last-child {
				border-bottom: none;
			}
			.row b {
				color: #ffe94d;
			}
			.links {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 8px;
				margin-bottom: 16px;
			}
			.links a {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 6px;
				padding: 10px;
				border-radius: 6px;
				text-decoration: none;
				font-size: 11px;
				font-weight: 500;
				background: rgba(242, 240, 255, 0.06);
				border: 1px solid rgba(242, 240, 255, 0.15);
				color: #f2f0ff;
			}
			.links svg {
				width: 14px;
				height: 14px;
			}
			.start {
				display: block;
				text-align: center;
				padding: 14px;
				border-radius: 8px;
				text-decoration: none;
				font-family: 'Press Start 2P', monospace;
				font-size: 11px;
				color: #05020a;
				background: #ffe94d;
				animation: blinkbtn 1.1s step-end infinite;
				letter-spacing: 0.02em;
			}
			@keyframes blinkbtn {
				50% {
					background: #fff6b8;
				}
			}
			.coin {
				text-align: center;
				margin-top: 10px;
				font-size: 10px;
				color: rgba(242, 240, 255, 0.45);
				font-family: 'Press Start 2P', monospace;
			}
			.footer {
				text-align: center;
				margin-top: 14px;
				font-size: 9px;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgba(242, 240, 255, 0.3);
			}
		</style>
	</head>
	<body>
		<div>
			<div class="cab">
				<p class="title">◆ INSERT COIN ◆</p>
				<h1 class="name">PIXEL<br />BAR</h1>
				<div class="screen">
					<div class="row"><span>Horario</span><b>18:00 – 02:00</b></div>
					<div class="row"><span>Dirección</span><b>C. Mayor 12</b></div>
					<div class="row"><span>Hoy</span><b>Torneo retro 21h</b></div>
				</div>
				<div class="links">
					<a href="https://instagram.com" target="_blank">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
							><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"
							></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg
						>
						Instagram
					</a>
					<a href="tel:+34727700065">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
							><path
								d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
							></path></svg
						>
						Llamar
					</a>
				</div>
				<a class="start" href={whatsapp} target="_blank">▶ PRESS START</a>
				<p class="coin">1 TOQUE = 1 CRÉDITO</p>
			</div>
			<p class="footer">096matics · Tarjeta digital</p>
		</div>
	</body>
</html>
