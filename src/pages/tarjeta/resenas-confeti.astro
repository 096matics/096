---
const whatsapp =
	'https://wa.me/34727700065?text=' + encodeURIComponent('Hola, quiero tarjetas NFC para reseñas de Google (Confeti)');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Café Marina — 096matics</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<style>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				overflow: hidden;
				overscroll-behavior: none;
			}
			body {
				height: 100dvh;
				background: linear-gradient(160deg, #ff5f6d 0%, #ffc371 55%, #ff9a3d 100%);
				font-family: 'IBM Plex Sans', sans-serif;
				color: #3a1502;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 32px 16px;
				position: relative;
			}
			.confetti {
				position: absolute;
				inset: 0;
				overflow: hidden;
				pointer-events: none;
			}
			.confetti i {
				position: absolute;
				top: -20px;
				width: 8px;
				height: 14px;
				opacity: 0;
				animation: fall 2.6s ease-in forwards;
				border-radius: 2px;
			}
			@keyframes fall {
				0% {
					opacity: 0;
					transform: translateY(0) rotate(0deg);
				}
				10% {
					opacity: 1;
				}
				100% {
					opacity: 0;
					transform: translateY(420px) rotate(340deg);
				}
			}
			.card {
				width: 100%;
				max-width: 400px;
				position: relative;
				z-index: 2;
				animation: pop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
			}
			@keyframes pop {
				0% {
					opacity: 0;
					transform: scale(0.8);
				}
				100% {
					opacity: 1;
					transform: scale(1);
				}
			}
			.panel {
				background: #fff8ef;
				border-radius: 28px;
				padding: 30px 26px 26px;
				text-align: center;
				box-shadow: 0 30px 60px -20px rgba(90, 20, 0, 0.45);
			}
			.badge {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 56px;
				height: 56px;
				border-radius: 50%;
				background: linear-gradient(135deg, #ff5f6d, #ff9a3d);
				color: #fff;
				font-family: 'Fredoka', sans-serif;
				font-weight: 700;
				font-size: 22px;
				margin-bottom: 12px;
				animation: badgeWiggle 3.4s ease-in-out 1s infinite;
			}
			@keyframes badgeWiggle {
				0%,
				85%,
				100% {
					transform: rotate(0deg) scale(1);
				}
				90% {
					transform: rotate(-8deg) scale(1.05);
				}
				95% {
					transform: rotate(6deg) scale(1.05);
				}
			}
			.name {
				font-family: 'Fredoka', sans-serif;
				font-weight: 700;
				font-size: 24px;
				margin: 0 0 2px;
				color: #3a1502;
			}
			.role {
				font-size: 12.5px;
				color: #a35a2c;
				margin: 0 0 18px;
			}
			.rating {
				font-family: 'Fredoka', sans-serif;
				font-size: 46px;
				font-weight: 700;
				color: #ff7a1a;
				line-height: 1;
				margin-bottom: 4px;
			}
			.stars {
				display: flex;
				justify-content: center;
				gap: 4px;
				margin-bottom: 6px;
			}
			.stars svg {
				width: 22px;
				height: 22px;
				opacity: 0;
				animation: starPop 0.4s ease forwards;
			}
			.stars svg:nth-child(1) {
				animation-delay: 0.5s;
			}
			.stars svg:nth-child(2) {
				animation-delay: 0.6s;
			}
			.stars svg:nth-child(3) {
				animation-delay: 0.7s;
			}
			.stars svg:nth-child(4) {
				animation-delay: 0.8s;
			}
			.stars svg:nth-child(5) {
				animation-delay: 0.9s;
			}
			@keyframes starPop {
				0% {
					opacity: 0;
					transform: scale(0) rotate(-30deg);
				}
				60% {
					transform: scale(1.3) rotate(8deg);
				}
				100% {
					opacity: 1;
					transform: scale(1) rotate(0);
				}
			}
			.count {
				font-size: 12px;
				color: #a35a2c;
				margin-bottom: 22px;
			}
			.cta {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				padding: 15px;
				border-radius: 999px;
				background: linear-gradient(135deg, #ff5f6d, #ff9a3d);
				color: #fff;
				text-decoration: none;
				font-weight: 600;
				font-size: 14px;
				box-shadow: 0 14px 30px -12px rgba(255, 95, 40, 0.6);
			}
			.cta svg {
				width: 16px;
				height: 16px;
			}
			.sub {
				margin-top: 12px;
				font-size: 11px;
				color: #b57a53;
			}
			.footer {
				text-align: center;
				margin-top: 16px;
				font-size: 9.5px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: rgba(58, 21, 2, 0.4);
			}
		</style>
	</head>
	<body>
		<div class="confetti" id="confetti"></div>
		<div class="card">
			<div class="panel">
				<div class="badge">CM</div>
				<h1 class="name">Café Marina</h1>
				<p class="role">Sagunto, Valencia</p>
				<p class="rating">4.9</p>
				<div class="stars">
					<svg viewBox="0 0 20 20" fill="#ff9a3d"
						><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z"></path></svg
					>
					<svg viewBox="0 0 20 20" fill="#ff9a3d"
						><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z"></path></svg
					>
					<svg viewBox="0 0 20 20" fill="#ff9a3d"
						><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z"></path></svg
					>
					<svg viewBox="0 0 20 20" fill="#ff9a3d"
						><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z"></path></svg
					>
					<svg viewBox="0 0 20 20" fill="#ff9a3d"
						><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z"></path></svg
					>
				</div>
				<p class="count">126 reseñas en Google</p>
				<a class="cta" href={whatsapp} target="_blank">
					<svg viewBox="0 0 20 20" fill="currentColor"
						><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z"></path></svg
					>
					Déjanos tu reseña
				</a>
				<p class="sub">Te lleva directo a la ficha, tarda 20 segundos</p>
			</div>
		</div>
		<p class="footer" style="position:absolute;bottom:18px;left:0;right:0;">096matics · Tarjeta digital</p>
		<script>
			const colors = ['#ff5f6d', '#ffc371', '#ff9a3d', '#fff8ef', '#3a1502'];
			const box = document.getElementById('confetti');
			if (box) {
				for (let i = 0; i < 26; i++) {
					const el = document.createElement('i');
					el.style.left = Math.random() * 100 + '%';
					el.style.background = colors[i % colors.length];
					el.style.animationDelay = 0.4 + Math.random() * 0.6 + 's';
					el.style.transform = `rotate(${Math.random() * 360}deg)`;
					box.appendChild(el);
				}
			}
		</script>
	</body>
</html>
