---
const whatsapp = 'https://wa.me/34727700065?text=' + encodeURIComponent('Hola, me interesa la plantilla de Inmobiliarias (Color)');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Marc Ferrer · 096matics</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--cream: #fbf5ea;
				--ink: #211b17;
				--ink-dim: rgba(33, 27, 23, 0.6);
				--coral: #ff6e5a;
				--violet: #6c4ba6;
				--yellow: #ffc94a;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				overflow: hidden;
				overscroll-behavior: none;
				background: var(--cream);
			}
			body {
				height: 100dvh;
				font-family: 'IBM Plex Sans', sans-serif;
				color: var(--ink);
				display: flex;
				flex-direction: column;
				background: var(--cream);
				animation: pageIn 0.6s ease forwards;
			}
			@keyframes pageIn {
				from {
					opacity: 0;
				}
				to {
					opacity: 1;
				}
			}
			.hero {
				position: relative;
				flex: 1 1 52%;
				overflow: hidden;
			}
			.blob {
				position: absolute;
				border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
			}
			.blob.coral {
				width: 230px;
				height: 230px;
				background: var(--coral);
				top: -60px;
				left: -60px;
			}
			.blob.violet {
				width: 190px;
				height: 190px;
				background: var(--violet);
				bottom: -70px;
				right: -50px;
				border-radius: 44% 56% 62% 38% / 45% 41% 59% 55%;
				opacity: 0.92;
			}
			.blob.yellow {
				width: 110px;
				height: 110px;
				background: var(--yellow);
				top: 8%;
				right: 12%;
				border-radius: 53% 47% 34% 66% / 53% 36% 64% 47%;
			}
			.blob.outline {
				width: 150px;
				height: 150px;
				border: 2px solid var(--ink);
				top: 38%;
				left: 4%;
				border-radius: 41% 59% 57% 43% / 51% 45% 55% 49%;
				opacity: 0.35;
			}
			.photo-blob {
				position: absolute;
				width: 172px;
				height: 172px;
				left: 50%;
				top: 46%;
				transform: translate(-50%, -50%);
				border-radius: 63% 37% 54% 46% / 46% 55% 45% 54%;
				overflow: hidden;
				border: 5px solid var(--cream);
				box-shadow: 0 22px 44px -18px rgba(33, 27, 23, 0.35);
				background: linear-gradient(150deg, #e4dacb, #c9bca5);
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: 'IBM Plex Sans', sans-serif;
				font-size: 11px;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: rgba(33, 27, 23, 0.4);
				text-align: center;
			}
			.tag {
				position: absolute;
				top: 16px;
				left: 16px;
				background: var(--ink);
				color: var(--cream);
				font-size: 10.5px;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				padding: 6px 12px;
				border-radius: 999px;
				z-index: 2;
			}
			.name-overlay {
				position: absolute;
				left: 0;
				right: 0;
				bottom: -14px;
				z-index: 2;
				text-align: center;
				pointer-events: none;
			}
			.name-overlay h1 {
				font-family: 'Archivo Black', sans-serif;
				font-size: clamp(34px, 13vw, 64px);
				line-height: 0.88;
				text-transform: uppercase;
				margin: 0;
				color: var(--ink);
				letter-spacing: -0.01em;
				overflow-wrap: break-word;
				word-break: break-word;
			}
			.name-overlay .accent-word {
				color: var(--coral);
			}
			.panel {
				flex: 1 1 48%;
				background: var(--cream);
				padding: 34px 22px 18px;
				display: flex;
				flex-direction: column;
			}
			.role-line {
				text-align: center;
				font-size: 13px;
				color: var(--ink-dim);
				margin: 0 0 16px;
			}
			.role-line b {
				color: var(--ink);
				font-weight: 600;
			}
			.specialties {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 7px;
				margin-bottom: 18px;
			}
			.chip {
				font-size: 10.5px;
				font-weight: 500;
				padding: 6px 13px;
				border-radius: 999px;
				color: var(--ink);
				border: 1.5px solid var(--ink);
			}
			.chip:nth-child(2) {
				background: var(--yellow);
				border-color: var(--yellow);
			}
			.chip:nth-child(3) {
				background: var(--coral);
				border-color: var(--coral);
				color: var(--cream);
			}
			.contact-row {
				display: flex;
				justify-content: center;
				gap: 12px;
				margin-bottom: 20px;
			}
			.contact-btn {
				width: 48px;
				height: 48px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				background: var(--cream);
				border: 2px solid var(--ink);
				color: var(--ink);
				text-decoration: none;
				transition:
					background 0.15s ease,
					color 0.15s ease,
					transform 0.15s ease;
			}
			.contact-btn:hover {
				background: var(--ink);
				color: var(--cream);
				transform: translateY(-2px) rotate(-4deg);
			}
			.contact-btn svg {
				width: 19px;
				height: 19px;
			}
			.save-link {
				display: block;
				text-align: center;
				font-size: 11.5px;
				color: var(--violet);
				text-decoration: underline;
				margin-bottom: 16px;
			}
			.cta {
				display: block;
				text-align: center;
				padding: 15px;
				background: var(--ink);
				color: var(--cream);
				text-decoration: none;
				font-weight: 600;
				font-size: 14px;
				border-radius: 999px 999px 40px 999px;
			}
			.cta:hover {
				background: var(--violet);
			}
		</style>
	</head>
	<body>
		<div class="hero">
			<div class="blob coral"></div>
			<div class="blob violet"></div>
			<div class="blob yellow"></div>
			<div class="blob outline"></div>

			<span class="tag">Agente inmobiliario</span>

			<div class="photo-blob">Foto del agente</div>

			<div class="name-overlay">
				<h1>Marc<br /><span class="accent-word">Ferrer</span></h1>
			</div>
		</div>

		<div class="panel">
			<p class="role-line"><b>Costa Norte Propiedades</b> · Valencia</p>

			<div class="specialties">
				<span class="chip">Pisos</span>
				<span class="chip">Chalets</span>
				<span class="chip">Obra nueva</span>
				<span class="chip">Locales</span>
			</div>

			<div class="contact-row">
				<a class="contact-btn" href="tel:+34727700065" aria-label="Llamar">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
						><path
							d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
						></path></svg
					>
				</a>
				<a class="contact-btn" href="https://wa.me/34727700065" target="_blank" aria-label="WhatsApp">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
						><path
							d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
						></path></svg
					>
				</a>
				<a class="contact-btn" href="mailto:contacto@096matics.com" aria-label="Email">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
						><path d="M22 6l-10 7L2 6"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg
					>
				</a>
			</div>

			<a
				class="save-link"
				download="marc-ferrer.vcf"
				href="data:text/vcard;charset=utf-8,BEGIN%3AVCARD%0AVERSION%3A3.0%0AN%3AFerrer%3BMarc%3B%3B%3B%0AFN%3AMarc%20Ferrer%0AORG%3ACosta%20Norte%20Propiedades%0ATITLE%3AAgente%20inmobiliario%0ATEL%3BTYPE%3DCELL%3A%2B34727700065%0AEND%3AVCARD"
				>↓ Guardar contacto</a
			>

			<a class="cta" href={whatsapp} target="_blank">Ver propiedades disponibles</a>
		</div>
	</body>
</html>
