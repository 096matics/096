  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23526a5d'/%3E%3Cpath d='M16 8l8 7h-2.5v8h-4v-5h-3v5h-4v-8H8z' fill='%23fff'/%3E%3C/svg%3E" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style is:global>
    /* is:global: el hero crea burbujas de chat y filas de leads por JS, y esos
       nodos no llevan el atributo de ámbito de Astro, así que con estilos con
       ámbito salían sin formato. Esta página es independiente: global equivale
       al comportamiento del HTML original. */

    /* ============ Base ============ */
    :root{
      --bg:#fbfbf8;
      --surface:#ffffff;
      --surface-soft:#f1f4ee;
      --text:#22313a;
      --muted:#66727a;
      --line:#dfe5df;
      --accent:#6d8677;
      --accent-dark:#526a5d;
      --accent-soft:#dfe8e1;
      --ok:#2f9e63;
      --star:#e0a63c;
      --footer-bg:#1c2721;
      --shadow:0 18px 50px rgba(36,52,45,.08);
      --radius:20px;
      --max:1180px;
      --ease:cubic-bezier(.16,1,.3,1);
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--bg);overflow-x:clip}
    body{
      margin:0;
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      background:var(--bg);
      color:var(--text);
      line-height:1.5;
      -webkit-font-smoothing:antialiased;
      overflow-x:clip;
    }
    a{text-decoration:none;color:inherit}
    img{max-width:100%;display:block}
    ::selection{background:var(--accent);color:#fff}
    :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
    ::-webkit-scrollbar{width:10px}
    ::-webkit-scrollbar-track{background:var(--bg)}
    ::-webkit-scrollbar-thumb{background:#c3cfc5;border-radius:8px;border:2px solid var(--bg)}
    ::-webkit-scrollbar-thumb:hover{background:#a9b9ad}
    h2{text-wrap:balance}
    .container{width:min(var(--max),calc(100% - 40px));margin:auto}
    section[id]{scroll-margin-top:92px}

    .ic{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

    .skip-link{position:fixed;top:-60px;left:16px;z-index:200;background:var(--accent-dark);color:#fff;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:700;transition:top .25s}
    .skip-link:focus{top:12px}

    .progress{position:fixed;top:0;left:0;height:3px;width:0;z-index:120;background:linear-gradient(90deg,var(--accent),var(--accent-dark))}

    /* ============ Navegación ============ */
    .nav{
      position:sticky;top:0;z-index:50;
      background:rgba(251,251,248,.88);
      backdrop-filter:blur(14px);
      border-bottom:1px solid rgba(223,229,223,.72);
      transition:box-shadow .3s;
    }
    .nav.scrolled{box-shadow:0 10px 30px rgba(36,52,45,.07)}
    .nav-inner{height:76px;display:flex;align-items:center;justify-content:space-between}
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-.03em}
    .brand-mark{width:28px;height:28px;border:2px solid var(--accent);border-radius:8px 8px 10px 10px;position:relative}
    .brand-mark:before{content:"";position:absolute;width:9px;height:9px;border-left:2px solid var(--accent);border-top:2px solid var(--accent);transform:rotate(45deg);left:7px;top:-5px;background:var(--bg)}
    .brand-mark:after{content:"";position:absolute;width:5px;height:8px;border:2px solid var(--accent);border-bottom:0;border-radius:4px 4px 0 0;left:9px;bottom:0}
    .nav-links{display:flex;gap:34px;font-size:14px;color:#6c757c}
    .nav-links a{position:relative;transition:color .2s;padding:4px 0}
    .nav-links a::after{content:"";position:absolute;left:0;bottom:-2px;width:0;height:2px;background:var(--accent);border-radius:2px;transition:width .25s var(--ease)}
    .nav-links a:hover,.nav-links a.active{color:var(--text)}
    .nav-links a.active::after,.nav-links a:hover::after{width:100%}
    .nav-cta{display:inline-flex;align-items:center;gap:8px}
    .only-mobile{display:none}

    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      min-height:46px;padding:0 22px;border-radius:999px;border:1px solid transparent;
      font-size:14px;font-weight:700;cursor:pointer;transition:.25s ease;
    }
    .btn-primary{background:var(--accent);color:#fff;box-shadow:0 8px 20px rgba(82,106,93,.22)}
    .btn-primary:hover{background:var(--accent-dark);transform:translateY(-1px);box-shadow:0 12px 26px rgba(82,106,93,.3)}
    .btn-primary:active{transform:scale(.98)}
    .btn-secondary{border-color:#b9c6bd;background:transparent;color:var(--text)}
    .btn-secondary:hover{background:#fff;transform:translateY(-1px)}
    .btn-block{width:100%}
    .btn .arrow{display:inline-block;transition:transform .25s ease}
    .btn:hover .arrow{transform:translateX(4px)}
    .mobile-toggle{display:none;background:none;border:0;font-size:24px;cursor:pointer;color:var(--text)}

    /* ============ Hero ============ */
    .hero{padding:88px 0 84px;position:relative}
    .hero::before{
      content:"";position:absolute;inset:0;pointer-events:none;z-index:0;
      background:
        radial-gradient(560px 380px at 88% 10%, rgba(109,134,119,.16), transparent 65%),
        radial-gradient(520px 340px at 6% 88%, rgba(109,134,119,.10), transparent 60%);
    }
    .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1.08fr;gap:72px;align-items:center}
    .hero-copy-col > *{opacity:1;animation:fadeUp .8s var(--ease) both}
    .hero-copy-col > *:nth-child(2){animation-delay:.1s}
    .hero-copy-col > *:nth-child(3){animation-delay:.2s}
    .hero-copy-col > *:nth-child(4){animation-delay:.3s}
    .hero-copy-col > *:nth-child(5){animation-delay:.4s}
    .eyebrow{display:inline-flex;padding:8px 13px;border-radius:999px;background:#e4e9e4;color:var(--accent-dark);font-size:12px;font-weight:700}
    h1{font-size:clamp(42px,5.2vw,68px);line-height:1.04;letter-spacing:-.06em;margin:18px 0 22px}
    h1 span{color:var(--accent)}
    .hero-copy{font-size:18px;color:var(--muted);max-width:580px}
    .hero-actions{display:flex;gap:12px;margin-top:30px;flex-wrap:wrap}
    .hero-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:38px}
    .benefit{display:flex;gap:10px;align-items:flex-start}
    .benefit-dot{width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:#edf2ed;color:var(--accent-dark);flex-shrink:0}
    .benefit-dot .ic{width:15px;height:15px}
    .benefit strong{display:block;font-size:12px}
    .benefit small{color:var(--muted);font-size:11px}

    /* ---- Visual del hero: panel arriba-izquierda + móvil abajo-derecha ---- */
    .hero-visual{position:relative;min-height:580px}
    .dashboard{
      position:absolute;left:0;right:88px;top:0;background:var(--surface);
      border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);padding:18px;
      opacity:1;
      animation:fadeUp .9s .35s var(--ease) both;
    }
    .dash-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;flex-wrap:wrap}
    .dash-title{display:flex;align-items:center;gap:8px;font-weight:800;font-size:14px}
    .dash-tabs{display:flex;gap:8px;font-size:10px;flex-wrap:wrap}
    .pill{padding:6px 9px;border-radius:999px;background:#eef2ed;color:#526a5d;font-weight:700}
    .pill.live{display:inline-flex;align-items:center;gap:5px}
    .pill.live::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--ok);animation:pulse 2.2s infinite}
    .live-dot{width:7px;height:7px;border-radius:50%;background:var(--ok);flex-shrink:0;animation:pulse 2.2s infinite}
    .dash-table{display:grid;gap:10px;max-height:264px;overflow:hidden}
    .lead-row{
      display:grid;grid-template-columns:36px 1fr auto;gap:12px;align-items:center;
      padding:10px;border:1px solid #edf0ed;border-radius:14px;background:#fff;
      transition:opacity .5s ease,transform .5s var(--ease);
    }
    .lead-row > div:nth-child(2){min-width:0}
    .lead-name{font-size:12px;font-weight:700}
    .lead-meta{font-size:10px;color:var(--muted)}
    .lead-name,.lead-meta{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-size:10px;font-weight:800;color:#fff;background:var(--av,#93a89a);flex-shrink:0}
    .status{font-size:10px;font-weight:700;padding:5px 8px;border-radius:999px;background:#e7efe8;color:#5b7464}
    .status.yellow{background:#f4ede0;color:#9b7745}.status.blue{background:#e8eef3;color:#637c90}
    .lead-row.new{opacity:0;transform:translateY(-14px) scale(.97)}
    .lead-row.new.show{opacity:1;transform:none}

    .phone{
      position:absolute;right:0;bottom:0;width:210px;background:#111;
      border:6px solid #111;border-radius:30px;padding:9px;z-index:2;
      box-shadow:0 24px 60px rgba(0,0,0,.2);
      opacity:1;
      animation:fadeUp .9s .55s var(--ease) both, float 6.5s 1.6s ease-in-out infinite;
    }
    .phone-screen{background:#f7f8f6;border-radius:22px;overflow:hidden;display:flex;flex-direction:column}
    .phone-head{display:flex;align-items:center;gap:8px;padding:14px;border-bottom:1px solid #e7ebe6;background:#fff;font-size:10px;font-weight:800}
    .chat{padding:12px;height:288px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden}
    .bubble{max-width:88%;padding:9px 10px;border-radius:13px;font-size:10px;margin-bottom:10px;animation:bubbleIn .35s var(--ease)}
    .bubble.in{background:#fff;border:1px solid #e5e9e5}
    .bubble.out{margin-left:auto;background:#dce9df}
    .bubble.typing{display:flex;gap:4px;padding:12px}
    .bubble.typing span{width:6px;height:6px;border-radius:50%;background:#9db1a3;animation:blink 1.2s infinite}
    .bubble.typing span:nth-child(2){animation-delay:.2s}
    .bubble.typing span:nth-child(3){animation-delay:.4s}
    .chat-input{padding:10px;border-top:1px solid #e7ebe6;background:#fff;font-size:9px;color:#9aa19d}

    /* ============ Franja de integraciones (marquesina) ============ */
    .logos{background:#fff;border-bottom:1px solid var(--line);padding:26px 0}
    .logos-caption{text-align:center;font-size:11px;color:var(--muted);margin:0 0 16px;letter-spacing:.05em;text-transform:uppercase;font-weight:700}
    .logos-viewport{
      overflow:hidden;
      -webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
      mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
    }
    .logos-track{display:flex;width:max-content}
    .js .logos-track{animation:marquee 32s linear infinite}
    .logos-track:hover{animation-play-state:paused}
    .logos-set{display:flex;align-items:center;gap:64px;padding-right:64px}
    .logo-item{color:#8d9a91;font-weight:800;font-size:15px;letter-spacing:-.02em;white-space:nowrap;opacity:.8;transition:opacity .2s}
    .logo-item:hover{opacity:1}

    /* ============ Secciones ============ */
    .section{padding:94px 0}
    .section-soft{background:var(--surface-soft)}
    .section-kicker{font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:var(--accent)}
    h2{font-size:clamp(34px,4vw,48px);line-height:1.08;letter-spacing:-.05em;margin:12px 0 18px}
    .section-lead{font-size:16px;color:var(--muted);max-width:690px}

    /* ============ Características ============ */
    .features{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:42px}
    .card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px;transition:transform .35s var(--ease),box-shadow .35s,border-color .35s}
    .card:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:#c8d5ca}
    .icon{
      width:40px;height:40px;border-radius:12px;background:#edf2ed;display:grid;place-items:center;
      color:var(--accent-dark);margin-bottom:18px;
      transition:background .35s,color .35s,transform .35s var(--ease);
    }
    .icon .ic{width:18px;height:18px}
    .card:hover .icon{background:var(--accent);color:#fff;transform:translateY(-2px) rotate(-4deg)}
    .card h3{font-size:16px;margin:0 0 8px}
    .card p{font-size:13px;color:var(--muted);margin:0}

    /* ============ Proceso ============ */
    .process{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center}
    .steps{margin-top:34px;display:grid;gap:18px}
    /* Bola más grande (40px), número de 16px con line-height:1 (centrado perfecto,
       sin recortes) y anillo del color del fondo que la separa de la línea */
    .step{display:grid;grid-template-columns:40px 1fr;gap:16px;align-items:start;position:relative}
    .step-num{
      width:40px;height:40px;border-radius:50%;
      background:var(--accent-dark);color:#fff;
      display:grid;place-items:center;
      font-size:16px;font-weight:800;line-height:1;
      position:relative;z-index:2;
      box-shadow:0 0 0 6px var(--surface-soft);
      transition:transform .3s var(--ease);
    }
    .step:hover .step-num{transform:scale(1.1)}
    /* La línea va por TRAMOS entre bola y bola (nunca pasa por debajo del número)
       y se dibuja en cascada al entrar en pantalla */
    .step:not(:last-child)::after{
      content:"";position:absolute;left:19px;top:46px;bottom:-12px;width:2px;border-radius:2px;
      background:var(--accent-soft);
      transform:scaleY(0);transform-origin:top;
      transition:transform .5s var(--ease);
    }
    .steps.in .step:not(:last-child)::after{transform:scaleY(1)}
    .steps.in .step:nth-child(1)::after{transition-delay:.35s}
    .steps.in .step:nth-child(2)::after{transition-delay:.55s}
    .steps.in .step:nth-child(3)::after{transition-delay:.75s}
    .step strong{display:block;font-size:14px}
    .step span{display:block;color:var(--muted);font-size:12px;margin-top:3px}
    .showcase{position:relative}
    .showcase img{width:100%;aspect-ratio:1.35;border-radius:22px;object-fit:cover;background:#e6e9e4}
    .showcase-card{
      position:absolute;right:22px;bottom:28px;background:#fff;border:1px solid var(--line);
      border-radius:18px;padding:20px;width:min(320px,70%);box-shadow:var(--shadow);
    }
    .showcase-card strong{display:block;font-size:15px}
    .showcase-card ul{padding:0;margin:12px 0 0;list-style:none;display:grid;gap:8px;font-size:11px;color:var(--muted)}
    .showcase-card li:before{content:"✓";color:var(--accent);font-weight:800;margin-right:7px}

    /* ============ Estadísticas ============ */
    .stats{background:var(--accent-dark);color:#fff;padding:64px 0}
    .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
    .stat{padding:4px 28px;border-left:1px solid rgba(255,255,255,.16)}
    .stat:first-child{border-left:0;padding-left:0}
    .stat strong{display:block;font-size:clamp(34px,4.2vw,48px);font-weight:800;letter-spacing:-.04em;margin-bottom:6px}
    .stat span{font-size:13px;color:#c9d6cc;line-height:1.5;display:block}

    /* ============ Testimonios ============ */
    /*.stars{color:var(--star);letter-spacing:3px;font-size:13px;margin-bottom:12px}
    .quote{font-size:13px;line-height:1.65;color:#5d696f}
    .person{display:flex;align-items:center;gap:10px;margin-top:20px}
    .person .avatar{width:34px;height:34px;font-size:9px}
    .person strong{font-size:11px}
    .person span{font-size:10px;color:var(--muted);display:block} */

    /* ============ Presupuesto ============ */
    .budget{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:42px;align-items:stretch}
    .budget-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:30px;display:flex;flex-direction:column;gap:14px;transition:transform .35s var(--ease),box-shadow .35s}
    .budget-card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
    .budget-range{border-color:#aab9af;box-shadow:var(--shadow)}
    .budget-label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:var(--accent)}
    .budget-range .price{font-size:clamp(30px,3.4vw,42px);font-weight:800;letter-spacing:-.05em}
    .budget-explain{font-size:13px;color:var(--muted);margin:0}
    .budget-note{font-size:11.5px;color:var(--muted);margin:0;text-align:center}
    .budget-card h3{margin:0;font-size:17px}
    .budget-list{margin:4px 0 0;padding:0;list-style:none;display:grid;gap:16px}
    .budget-list li{display:grid;gap:2px}
    .budget-list span{color:var(--muted);font-size:12px}

    /* ============ FAQ ============ */
    .faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:42px}
    .faq{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;transition:border-color .25s}
    .faq:hover{border-color:#c8d5ca}
    .faq button{
      width:100%;background:none;border:0;padding:17px 18px;text-align:left;
      display:flex;justify-content:space-between;align-items:center;gap:14px;
      font:inherit;font-size:13px;font-weight:700;color:var(--text);cursor:pointer;
    }
    .faq button:hover{color:var(--accent-dark)}
    .faq-icon{transition:transform .3s var(--ease);color:var(--accent);font-size:16px;flex-shrink:0}
    .faq.open .faq-icon{transform:rotate(45deg)}
    .faq .answer{display:grid;grid-template-rows:0fr;transition:grid-template-rows .4s var(--ease)}
    .faq .answer > div{overflow:hidden;min-height:0}
    .faq .answer p{margin:0;padding:0 18px 18px;font-size:12.5px;color:var(--muted);line-height:1.65}
    .faq.open .answer{grid-template-rows:1fr}
    .faq-note{margin-top:26px;font-size:13px;color:var(--muted)}
    .faq-note a{color:var(--accent-dark);font-weight:700}
    .faq-note a:hover{text-decoration:underline}

    /* ============ Contacto ============ */
    .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
    .perks{list-style:none;padding:0;margin:26px 0 0;display:grid;gap:12px;font-size:13.5px;color:#4d5a61}
    .perks li:before{content:"✓";color:var(--accent);font-weight:800;margin-right:9px}
    .contact-alt{margin-top:22px;font-size:12.5px;color:var(--muted)}
    .contact-alt a{color:var(--accent-dark);font-weight:700;text-decoration:underline}
    .contact-form{
      background:#fff;border:1px solid var(--line);border-radius:22px;padding:30px;
      box-shadow:var(--shadow);display:grid;gap:16px;
    }
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .contact-form label{display:grid;gap:7px;font-size:12px;font-weight:700;color:var(--text)}
    .contact-form input,.contact-form textarea{
      font:inherit;font-size:13px;font-weight:400;padding:12px 14px;border:1px solid var(--line);
      border-radius:12px;background:var(--bg);resize:vertical;
      transition:border-color .2s,box-shadow .2s;
    }
    .contact-form input:focus,.contact-form textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(109,134,119,.15)}
    .contact-form input::placeholder,.contact-form textarea::placeholder{color:#a9b2ab}
    .form-note{font-size:11px;color:var(--muted)}
    .form-note a{color:var(--accent-dark);font-weight:600;text-decoration:underline}

    /* ============ Footer ============ */
    footer{background:var(--footer-bg);color:#aebcb2;padding:64px 0 0}
    footer .brand{color:#fff}
    footer .brand-mark:before{background:var(--footer-bg)}
    .footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1.4fr;gap:44px;padding-bottom:52px}
    .footer-brand p{font-size:13px;line-height:1.7;margin:16px 0 14px;max-width:300px}
    .footer-mail{color:#dfe8e1;font-weight:700;font-size:13px;transition:color .2s}
    .footer-mail:hover{color:#fff}
    footer h4{color:#fff;font-size:11px;text-transform:uppercase;letter-spacing:.1em;margin:4px 0 16px}
    .footer-grid nav a{display:block;color:#aebcb2;font-size:13px;padding:5px 0;transition:color .2s}
    .footer-grid nav a:hover{color:#fff}
    .footer-note{font-size:12.5px;margin:0 0 10px}
    .footer-bottom{border-top:1px solid rgba(255,255,255,.09);padding:20px 0;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;font-size:11.5px;color:#8fa096}
    .footer-legal a{color:#8fa096;transition:color .2s}
    .footer-legal a:hover{color:#fff}

    /* ============ CTA fijo en móvil ============ */
    .mobile-cta{display:none}
    @media (max-width:700px){
      .mobile-cta{
        display:block;position:fixed;left:0;right:0;bottom:0;z-index:70;
        padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));
        background:rgba(251,251,248,.94);backdrop-filter:blur(10px);
        border-top:1px solid var(--line);box-shadow:0 -10px 26px rgba(36,52,45,.08);
      }
      body{padding-bottom:76px}
      .to-top{bottom:calc(88px + env(safe-area-inset-bottom,0px))}
    }

    /* ============ Botón subir + toast ============ */
    .to-top{
      position:fixed;right:22px;bottom:22px;width:46px;height:46px;border-radius:50%;z-index:60;
      background:var(--accent);color:#fff;border:0;cursor:pointer;display:grid;place-items:center;
      box-shadow:0 10px 26px rgba(36,52,45,.25);
      opacity:0;transform:translateY(12px);pointer-events:none;transition:.3s;
    }
    .to-top.show{opacity:1;transform:none;pointer-events:auto}
    .to-top:hover{background:var(--accent-dark)}
    .toast{
      position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);z-index:80;
      background:#22313a;color:#fff;padding:13px 22px;border-radius:12px;font-size:13px;
      box-shadow:0 16px 40px rgba(0,0,0,.25);max-width:min(92vw,480px);text-align:center;
      opacity:0;pointer-events:none;transition:.35s var(--ease);
    }
    .toast.show{opacity:1;transform:translate(-50%,0)}

    /* ============ Animaciones al hacer scroll ============ */
    .js [data-reveal]{
      opacity:0;transform:translateY(28px);
      transition:opacity .8s ease var(--d,0s),transform .8s var(--ease) var(--d,0s);
    }
    .js [data-reveal].in{opacity:1;transform:none}
    .js .stagger:not(.in) > *{opacity:0;transform:translateY(26px)}
    .stagger.in > *{animation:fadeUp .7s var(--ease) backwards}
    .stagger.in > *:nth-child(1){animation-delay:.05s}
    .stagger.in > *:nth-child(2){animation-delay:.13s}
    .stagger.in > *:nth-child(3){animation-delay:.21s}
    .stagger.in > *:nth-child(4){animation-delay:.29s}
    .stagger.in > *:nth-child(5){animation-delay:.37s}
    .stagger.in > *:nth-child(6){animation-delay:.45s}

    /* ============ Keyframes ============ */
    @keyframes fadeUp{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:translateY(0)}}
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    @keyframes bubbleIn{from{opacity:0;transform:translateY(8px) scale(.96)}to{opacity:1;transform:none}}
    @keyframes blink{0%,80%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-2px)}}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(47,158,99,.45)}70%{box-shadow:0 0 0 7px rgba(47,158,99,0)}100%{box-shadow:0 0 0 0 rgba(47,158,99,0)}}
    @keyframes marquee{to{transform:translateX(-50%)}}
    @keyframes menuIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}

    /* ============ Responsive ============ */
    @media (max-width: 980px){
      .hero-grid,.process,.contact-grid{grid-template-columns:1fr}
      .hero{padding-top:66px}
      .hero-grid{gap:52px}
      .hero-visual{min-height:580px;max-width:620px;width:100%;margin:0 auto}
      .features{grid-template-columns:repeat(2,1fr)}
      .faq-grid{grid-template-columns:1fr}
      .stats-grid{grid-template-columns:repeat(2,1fr);gap:36px 20px}
      .stat{border-left:0;padding:0}
      .footer-grid{grid-template-columns:1fr 1fr;gap:36px}
      .showcase-card{right:12px}
      /* Proceso en una columna: bloque centrado, imagen acotada en anchura
         y altura (antes, a ~950px de ancho, la imagen llegaba a 660px de alto) */
      .process{gap:48px}
      .showcase{width:100%;max-width:560px;margin:0 auto}
      .showcase img{aspect-ratio:16/10}
    }
    @media (max-width: 700px){
      .container{width:min(var(--max),calc(100% - 28px))}
      .nav-inner{height:68px}
      .nav-links,.nav-cta{display:none}
      .mobile-toggle{display:block}
      .nav.mobile-open .nav-links{
        display:flex;position:absolute;left:14px;right:14px;top:70px;flex-direction:column;gap:4px;
        background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px;
        box-shadow:var(--shadow);animation:menuIn .25s ease;
      }
      .nav.mobile-open .nav-links a{padding:10px 4px}
      .nav.mobile-open .only-mobile{display:block;font-weight:700;color:var(--accent-dark);border-top:1px solid var(--line);margin-top:10px;padding-top:16px}

      .hero{padding:48px 0 64px}
      h1{font-size:clamp(34px,9vw,42px)}
      .hero-copy{font-size:16px}
      .hero-actions{flex-direction:column;align-items:stretch}
      .hero-actions .btn{width:100%}
      .hero-benefits{grid-template-columns:1fr;gap:16px}

      .hero-visual{min-height:0;display:flex;justify-content:center;padding:26px 0 8px}
      .dashboard{display:none}
      .phone{position:relative;right:auto;bottom:auto;width:238px}
      .phone-head{font-size:11px}
      .chat{height:340px}
      .bubble{font-size:11px}
      .chat-input{font-size:10px}

      .features{grid-template-columns:1fr}
      .section{padding:72px 0}
      .stats{padding:52px 0}
      .step strong{font-size:15px}

      /* Imagen compacta y la tarjeta pasa a DEBAJO (solapada 34px),
         en vez de cubrir la mitad de la imagen */
      .showcase img{aspect-ratio:3/2}
      .showcase-card{
        position:relative;right:auto;bottom:auto;z-index:2;
        width:calc(100% - 24px);margin:-34px auto 0;padding:16px 18px;
      }
      .showcase-card strong{font-size:14px}
      .showcase-card ul{margin-top:10px;gap:6px;font-size:12px}

      .form-row{grid-template-columns:1fr}
    }
    @media (max-width: 560px){
      .footer-grid{grid-template-columns:1fr}
    }

    /* ============ Accesibilidad: reduce movimiento ============ */
    @media (prefers-reduced-motion: reduce){
      *,*::before,*::after{
        animation-duration:.01ms !important;
        animation-iteration-count:1 !important;
        transition-duration:.01ms !important;
      }
      html{scroll-behavior:auto}
      .js [data-reveal],.js .stagger:not(.in) > *{opacity:1 !important;transform:none !important}
    }
  </style>

