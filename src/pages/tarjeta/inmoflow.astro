  <button class="to-top" id="toTop" type="button" aria-label="Volver arriba">
    <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
  </button>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script is:inline>
  (function () {
    'use strict';

    const $  = (s, c) => (c || document).querySelector(s);
    const $$ = (s, c) => Array.from((c || document).querySelectorAll(s));
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------- Año dinámico ---------- */
    const yearEl = $('#year');
    if (yearEl) yearEl.textContent = new Date().getFullYear();

    /* ---------- Toast ---------- */
    const toast = $('#toast');
    let toastTimer;
    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 4200);
    }

    /* ---------- Cabecera, barra de progreso y botón "subir" ---------- */
    const nav = $('#nav');
    const progress = $('#progress');
    const toTop = $('#toTop');

    function onScroll() {
      const y = window.scrollY;
      if (nav) nav.classList.toggle('scrolled', y > 8);
      if (toTop) toTop.classList.toggle('show', y > 640);
      if (progress) {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.width = (h > 0 ? (y / h) * 100 : 0) + '%';
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    toTop && toTop.addEventListener('click', () =>
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' })
    );

    /* ---------- Menú móvil ---------- */
    const toggle = $('#mobileToggle');
    toggle && toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('mobile-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });
    $$('.nav-links a').forEach((a) => a.addEventListener('click', () => {
      nav.classList.remove('mobile-open');
      toggle && toggle.setAttribute('aria-expanded', 'false');
    }));

    /* ---------- Enlace activo del menú según la sección visible ---------- */
    const navAnchors = $$('.nav-links a[href^="#"]');
    if ('IntersectionObserver' in window) {
      const spy = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const id = '#' + e.target.id;
          navAnchors.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === id));
        });
      }, { rootMargin: '-40% 0px -55% 0px' });
      $$('main section[id]').forEach((s) => spy.observe(s));
    }

    /* ---------- Acordeón FAQ ---------- */
    $$('.faq button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.closest('.faq').classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
    });

    /* ---------- Animaciones al hacer scroll ---------- */
    const revealTargets = $$('[data-reveal], .stagger');
    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealTargets.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      revealTargets.forEach((el) => io.observe(el));
    }

    /* ---------- Contadores animados ---------- */
    const counters = $$('[data-count]');
    const renderCount = (el, v) =>
      el.textContent = (el.dataset.prefix || '') + v + (el.dataset.suffix || '');
    function animateCount(el) {
      const target = parseInt(el.dataset.count, 10) || 0;
      const dur = 1600, t0 = performance.now();
      const ease = (t) => 1 - Math.pow(1 - t, 4);
      (function tick(now) {
        const p = Math.min((now - t0) / dur, 1);
        renderCount(el, Math.round(ease(p) * target));
        if (p < 1) requestAnimationFrame(tick);
      })(t0);
    }
    if (reduceMotion) {
      counters.forEach((el) => renderCount(el, el.dataset.count));
    } else {
      counters.forEach((el) => renderCount(el, 0));
      const co = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { animateCount(e.target); co.unobserve(e.target); }
        });
      }, { threshold: 0.6 });
      counters.forEach((el) => co.observe(el));
    }

    /* ---------- Marquesina: duplicamos el set para un bucle perfecto ---------- */
    const logosSet = $('.logos-set');
    if (logosSet && !reduceMotion) {
      const clone = logosSet.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      logosSet.parentNode.appendChild(clone);
    }

    /* ---------- Chat simulado de WhatsApp (bucle) ---------- */
    const chat = $('#chat');
    if (chat && !reduceMotion) {
      const conversation = [
        { dir: 'in',  text: 'Hola, soy el equipo de InmoFlow. Hemos recibido tu solicitud sobre viviendas en Valencia. ¿Buscas comprar o alquilar?' },
        { dir: 'out', text: 'Comprar' },
        { dir: 'in',  text: 'Perfecto. ¿Cuál es tu presupuesto aproximado?' },
        { dir: 'out', text: 'Hasta 250.000 €' },
        { dir: 'in',  text: 'Genial. Tengo 12 viviendas que encajan contigo. ¿Te muestro las 3 mejores de esta semana?' },
        { dir: 'out', text: 'Sí, perfecto 🙌' }
      ];
      (async function runChat() {
        for (;;) {
          chat.innerHTML = '';
          for (const m of conversation) {
            if (m.dir === 'in') {
              const typing = document.createElement('div');
              typing.className = 'bubble in typing';
              typing.setAttribute('aria-hidden', 'true');
              typing.innerHTML = '<span></span><span></span><span></span>';
              chat.appendChild(typing);
              await sleep(1100 + Math.random() * 500);
              typing.remove();
            } else {
              await sleep(650);
            }
            const bubble = document.createElement('div');
            bubble.className = 'bubble ' + m.dir;
            bubble.textContent = m.text;
            chat.appendChild(bubble);
            await sleep(1000);
          }
          await sleep(4500);
        }
      })();
    }

    /* ---------- Leads entrando "en directo" en el panel (FLIP) ---------- */
    const table = $('#leadTable');
    const pill = $('#leadPill');
    const dashboardVisible = window.matchMedia('(min-width: 701px)').matches;
    if (table && pill && !reduceMotion && dashboardVisible) {
      const feed = [
        { ini: 'MF', name: 'Marta Ferrer',  meta: 'Gandía · 195.000 €',   cls: 'blue',   label: 'Lead nuevo' },
        { ini: 'DS', name: 'Diego Sanchís', meta: 'Valencia · 420.000 €', cls: 'yellow', label: 'Contactando' },
        { ini: 'EP', name: 'Elena Prats',   meta: 'Cullera · 150.000 €',  cls: '',       label: 'Interesado' },
        { ini: 'RB', name: 'Raúl Blasco',   meta: 'Alzira · 230.000 €',   cls: 'blue',   label: 'Lead nuevo' },
        { ini: 'CG', name: 'Clara Gumbau',  meta: 'Valencia · 275.000 €', cls: 'yellow', label: 'Contactando' }
      ];
      let total = 18, i = 0;

      setInterval(() => {
        const existing = $$('.lead-row', table);
        if (!existing.length) return;
        const topsBefore = existing.map((r) => r.getBoundingClientRect().top);

        const d = feed[i++ % feed.length];
        const row = document.createElement('div');
        row.className = 'lead-row new';
        row.innerHTML =
          '<div class="avatar" style="--av:#74889b">' + d.ini + '</div>' +
          '<div><div class="lead-name">' + d.name + '</div><div class="lead-meta">' + d.meta + '</div></div>' +
          '<div class="status ' + d.cls + '">' + d.label + '</div>';
        table.prepend(row);

        existing.forEach((r, idx) => {
          const delta = r.getBoundingClientRect().top - topsBefore[idx];
          if (!delta) return;
          r.style.transition = 'none';
          r.style.transform = 'translateY(' + (-delta) + 'px)';
        });
        void table.offsetWidth;
        existing.forEach((r) => { r.style.transition = ''; r.style.transform = ''; });

        void row.offsetHeight;
        row.classList.add('show');
        pill.textContent = 'Lead nuevo · ' + (++total);

        setTimeout(() => {
          const all = $$('.lead-row', table);
          while (all.length > 4) all.pop().remove();
        }, 650);
      }, 4800);
    }
  })();
  </script>
