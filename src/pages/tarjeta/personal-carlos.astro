        try { t = localStorage.getItem('theme'); l = localStorage.getItem('lang'); } catch (e) {}
        if (t === 'light') d.classList.add('light');
        if (l !== 'es' && l !== 'en') {
            l = ((navigator.language || 'es').toLowerCase().indexOf('es') === 0) ? 'es' : 'en';
        }
        d.lang = l;
    })();
