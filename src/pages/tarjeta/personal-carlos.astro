        const uiText = {
            es: {
                title: document.title,
                toDark: 'Cambiar a modo oscuro', toLight: 'Cambiar a modo claro',
                lang: 'Cambiar a inglés', dot: 'Ir al elemento ', locale: 'es_ES'
            },
            en: {
                title: 'Carlos Cantos | Automation & AI Developer in Valencia',
                toDark: 'Switch to dark mode', toLight: 'Switch to light mode',
                lang: 'Switch to Spanish', dot: 'Go to item ', locale: 'en_US'
            }
        };

        const metaEn = {
            'meta[name="description"]': 'Automation and AI developer in Valencia. I design n8n workflows, integrate LLMs (OpenAI, Claude) and deploy production infrastructure. Available for freelance projects and to join a team.',
            'meta[property="og:description"]': 'Automation and AI systems in production: 1,800+ clients managed, n8n + LLM integrations, self-hosted infrastructure.',
            'meta[name="twitter:description"]': 'I design systems that automate processes and integrate AI in production.'
        };

        // Guardar el texto original en español (ya está en el HTML)
        const i18nEs = {}, ariaEs = {}, metaEs = {};
        document.querySelectorAll('[data-i18n]').forEach(el => {
            if (!(el.dataset.i18n in i18nEs)) i18nEs[el.dataset.i18n] = el.innerHTML;
        });
        document.querySelectorAll('[data-i18n-aria]').forEach(el => {
            ariaEs[el.dataset.i18nAria] = el.getAttribute('aria-label');
        });
        Object.keys(metaEn).forEach(sel => {
            const m = document.querySelector(sel);
            if (m) metaEs[sel] = m.getAttribute('content');
        });

        function safeStore(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

        function updateControls() {
            const l = document.documentElement.lang === 'en' ? 'en' : 'es';
            const light = document.documentElement.classList.contains('light');
            const t = uiText[l];
            const themeBtn = document.getElementById('themeToggle');
            const langBtn = document.getElementById('langToggle');
            const themeLabel = light ? t.toDark : t.toLight;
            themeBtn.setAttribute('aria-label', themeLabel);
            themeBtn.title = themeLabel;
            langBtn.setAttribute('aria-label', t.lang);
            langBtn.title = t.lang;
            document.getElementById('langLabel').textContent = l === 'es' ? 'EN' : 'ES';
        }

        function applyTheme(theme) {
            const light = theme === 'light';
            document.documentElement.classList.toggle('light', light);
            const meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', light ? '#ffffff' : '#000000');
            updateControls();
        }

        function applyLang(l) {
            l = l === 'en' ? 'en' : 'es';
            document.documentElement.lang = l;
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const k = el.dataset.i18n;
                el.innerHTML = (l === 'en' && k in i18nEn) ? i18nEn[k] : i18nEs[k];
            });
            document.querySelectorAll('[data-i18n-aria]').forEach(el => {
                const k = el.dataset.i18nAria;
                el.setAttribute('aria-label', (l === 'en' && k in i18nEn) ? i18nEn[k] : ariaEs[k]);
            });
            document.querySelectorAll('[id$="-dots"] button').forEach(b => {
                const i = Array.prototype.indexOf.call(b.parentNode.children, b) + 1;
                b.setAttribute('aria-label', uiText[l].dot + i);
            });
            document.title = uiText[l].title;
            Object.keys(metaEn).forEach(sel => {
                const m = document.querySelector(sel);
                if (m) m.setAttribute('content', l === 'en' ? metaEn[sel] : metaEs[sel]);
            });
            const loc = document.querySelector('meta[property="og:locale"]');
            if (loc) loc.setAttribute('content', uiText[l].locale);
            if (currentModal) renderModal();
            updateControls();
        }

        document.getElementById('themeToggle').addEventListener('click', () => {
            const next = document.documentElement.classList.contains('light') ? 'dark' : 'light';
            applyTheme(next);
            safeStore('theme', next);
        });
        document.getElementById('langToggle').addEventListener('click', () => {
            const next = document.documentElement.lang === 'en' ? 'es' : 'en';
            applyLang(next);
            safeStore('lang', next);
        });

        // Estado inicial (el <head> ya dejó la clase y el lang correctos)
        applyTheme(document.documentElement.classList.contains('light') ? 'light' : 'dark');
        applyLang(document.documentElement.lang);
    </script>
</body>
