    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    // Colores ligados a variables CSS → cambian con el tema.
                    // "white" y "black" se redefinen como texto/fondo del tema,
                    // así todas las clases text-white, bg-black, bg-white/5... se invierten solas.
                    colors: {
                        background: 'rgb(var(--c-bg) / <alpha-value>)',
                        surface: 'rgb(var(--c-surface) / <alpha-value>)',
                        card: 'rgb(var(--c-card) / <alpha-value>)',
                        border: 'rgb(var(--c-border) / <alpha-value>)',
                        accent: 'rgb(var(--c-fg) / <alpha-value>)',
                        muted: 'rgb(var(--c-muted) / <alpha-value>)',
                        white: 'rgb(var(--c-fg) / <alpha-value>)',
                        black: 'rgb(var(--c-bg) / <alpha-value>)'
                    }
                }
            }
        }
    </script>

    <style>
        /* ============================================
           TEMA (oscuro por defecto / claro con html.light)
           ============================================ */
        :root {
            color-scheme: dark;
            --c-bg: 0 0 0;
            --c-surface: 10 10 10;
            --c-card: 17 17 17;
            --c-border: 39 39 42;
            --c-fg: 255 255 255;
            --c-muted: 161 161 170;
            --dot-bg: #18181b;
            --dot-border: #3f3f46;
        }
        html.light {
            color-scheme: light;
            --c-bg: 255 255 255;
            --c-surface: 244 244 245;
            --c-card: 250 250 250;
            --c-border: 212 212 216;
            --c-fg: 9 9 11;
            --c-muted: 82 82 91;
            --dot-bg: #e4e4e7;
            --dot-border: #a1a1aa;
        }

        body { 
            background-color: rgb(var(--c-bg)); 
            color: rgb(var(--c-fg));
            position: relative;
        }

        /* Colores de acento: más oscuros en modo claro para mantener el contraste */
        html.light .text-green-400 { color: #15803d; }
        html.light .text-blue-400 { color: #1d4ed8; }
        html.light .text-purple-400 { color: #7e22ce; }
        html.light .text-red-400 { color: #b91c1c; }
        /* La terminal se queda oscura en ambos temas */
        html.light .terminal-win .text-green-400 { color: #4ade80; }

        /* Botones de tema / idioma */
        .icon-sun { display: none; }
        html:not(.light) .icon-sun { display: block; }
        html.light .icon-moon { display: block; }
        html:not(.light) .icon-moon { display: none; }

        /* FIX definitivo del scroll horizontal en móvil.
           clip no crea scroll-container y no permite pan lateral. */
        html, body { overflow-x: clip; }
        @supports not (overflow: clip) {
            html, body { overflow-x: hidden; }
        }

        /* ============================================
           SCROLL BLOQUEADO (móvil Y escritorio)
           Cada sección encaja en una pantalla
           ============================================ */
        html { scroll-snap-type: y mandatory; }
        .snap-section { scroll-snap-align: start; scroll-snap-stop: always; }
        #page-footer { scroll-snap-align: end; }

        /* En escritorio, además, cada item de experiencia encaja centrado */
        @media (min-width: 768px) {
            .timeline-item { scroll-snap-align: center; scroll-snap-stop: always; }
        }

        /* Altura de pantalla completa con fallback */
        .fullpage { min-height: 100vh; min-height: 100svh; }

        /* Animaciones suaves */
        .fade-in-up {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), 
                        transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
            will-change: opacity, transform;
        }
        .fade-in-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Cursor terminal */
        .cursor::after {
            content: '█';
            animation: blink 1s step-end infinite;
            margin-left: 4px;
            font-size: 0.8em;
        }
        @keyframes blink { 50% { opacity: 0; } }

        /* Glow — FIXED: los elementos fixed nunca generan overflow del documento
           (el absolute de 800px era el causante del hueco lateral en móvil) */
        .glow-bg {
            position: fixed;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgb(var(--c-fg) / 0.03) 0%, rgb(var(--c-bg) / 0) 60%);
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            z-index: -1;
            pointer-events: none;
        }

        /* Marquee */
        .marquee-wrapper { width: 100%; overflow: hidden; }
        .marquee-track { display: flex; width: max-content; }
        .marquee-track.left { animation: scroll-left 40s linear infinite; }
        .marquee-track.right { animation: scroll-right 40s linear infinite; }
        @keyframes scroll-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
        @keyframes scroll-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }

        /* Timeline progresivo */
        .timeline-item .timeline-dot { transition: all 0.7s cubic-bezier(0.22, 1, 0.36, 1); background-color: var(--dot-bg); border-color: var(--dot-border); }
        .timeline-item .timeline-content { transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.8s ease; opacity: 0.2; transform: translateY(15px); }
        .timeline-item.active .timeline-dot { background-color: rgb(var(--c-fg)); border-color: rgb(var(--c-fg)); box-shadow: 0 0 15px rgb(var(--c-fg) / 0.6); }
        .timeline-item.active .timeline-content { opacity: 1; transform: translateY(0); border-color: rgb(var(--c-fg) / 0.2); }

        #timeline-progress {
            background: linear-gradient(to bottom, rgb(var(--c-fg) / 0.1), rgb(var(--c-fg)));
            box-shadow: 0 0 12px rgb(var(--c-fg) / 0.35);
            transition: height 0.25s ease-out;
        }

        /* Modal: animación por clases (sin conflicto hidden/flex) */
        #techModal {
            opacity: 0; visibility: hidden;
            transition: opacity 0.3s ease, visibility 0s linear 0.3s;
        }
        #techModal.open {
            opacity: 1; visibility: visible;
            transition: opacity 0.3s ease;
        }
        #modalContent {
            transform: scale(0.95) translateY(12px);
            transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }
        #techModal.open #modalContent { transform: scale(1) translateY(0); }

        .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
        .no-scrollbar::-webkit-scrollbar { display: none; }

        @media (prefers-reduced-motion: reduce) {
            html { scroll-snap-type: none !important; scroll-behavior: auto; }
            .fade-in-up { opacity: 1; transform: none; transition: none; }
            .marquee-track { animation: none; }
        }
    </style>
</head>
