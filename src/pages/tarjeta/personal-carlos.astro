    <script is:inline>
        // ===== FIX: evitar que el navegador restaure una posición anterior al recargar
        // (era la causa del "salto forzado hacia abajo" en escritorio al cargar)
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        window.addEventListener('pageshow', (e) => { if (e.persisted) window.scrollTo(0, 0); });

        // ============ TERMINAL ============
        const terminalBody = document.getElementById('terminal-body');
        async function sleep(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }
        
        async function typeText(text, element, speed = 50) {
            for(let i = 0; i < text.length; i++) {
                element.innerHTML += text.charAt(i);
                await sleep(speed);
            }
        }

        async function initTerminal() {
            const line1 = document.createElement('div');
            line1.innerHTML = `<span class="text-green-400 mr-2">guest@portfolio:~$</span><span class="typing"></span><span class="cursor"></span>`;
            terminalBody.appendChild(line1);
            await typeText('whoami', line1.querySelector('.typing'), 100);
            line1.querySelector('.cursor').remove();
            
            const out1 = document.createElement('div');
            out1.className = "text-[#ffffff] mt-1 mb-3";
            out1.textContent = "Carlos Cantos";
            terminalBody.appendChild(out1);
            await sleep(400);

            const line2 = document.createElement('div');
            line2.innerHTML = `<span class="text-green-400 mr-2">guest@portfolio:~$</span><span class="typing"></span><span class="cursor"></span>`;
            terminalBody.appendChild(line2);
            await typeText('./get_role.sh', line2.querySelector('.typing'), 80);
            startRoleLoop(line2.querySelector('.typing'));
        }

        function startRoleLoop(textElement) {
            const roles = ["Automation Engineer", "AI Developer", "n8n Specialist"];
            let roleIndex = 0; let charIndex = 0; let isDeleting = false;
            function typeEffect() {
                const currentRole = roles[roleIndex];
                textElement.textContent = "./get_role.sh --" + currentRole.substring(0, charIndex + (isDeleting ? -1 : 1));
                charIndex += isDeleting ? -1 : 1;
                let speed = isDeleting ? 30 : 80;
                if (!isDeleting && charIndex === currentRole.length) { speed = 2000; isDeleting = true; } 
                else if (isDeleting && charIndex === 0) { isDeleting = false; roleIndex = (roleIndex + 1) % roles.length; speed = 500; }
                setTimeout(typeEffect, speed);
            }
            setTimeout(typeEffect, 500);
        }
        setTimeout(initTerminal, 800);

        // ============ MARQUEE GENERADO POR JS ============
        const stackRows = [
            { id: 'marquee-left',  items: [
                { t: 'JavaScript' }, { t: 'TypeScript' }, { t: 'n8n', hot: true },
                { t: 'Docker' }, { t: 'PostgreSQL' }, { t: 'Supabase' }
            ]},
            { id: 'marquee-right', items: [
                { t: 'OpenAI API' }, { t: 'Claude API' }, { t: 'Prompt Engineering' },
                { t: 'Linux VPS' }, { t: 'EasyPanel' }, { t: 'Git / GitHub' }
            ]}
        ];

        function skillSpan({ t, hot }) {
            const cls = hot
                ? 'bg-card border-green-500/30 text-green-400 font-bold'
                : 'bg-card border-border font-medium';
            return `<span class="shrink-0 whitespace-nowrap px-4 md:px-6 py-2 md:py-3 rounded-xl text-base md:text-lg border ${cls}">${t}</span>`;
        }

        function buildMarquee(row) {
            const track = document.getElementById(row.id);
            track.innerHTML = '';
            const group = document.createElement('div');
            group.className = 'flex shrink-0 items-center gap-4 md:gap-6 px-3';
            group.innerHTML = row.items.map(skillSpan).join('');
            track.appendChild(group);
            const gw = group.offsetWidth || 1000;
            const perHalf = Math.max(2, Math.ceil(window.innerWidth / gw));
            const frag = document.createDocumentFragment();
            for (let i = 1; i < perHalf * 2; i++) {
                const g = group.cloneNode(true);
                if (i >= perHalf) g.setAttribute('aria-hidden', 'true');
                frag.appendChild(g);
            }
            track.appendChild(frag);
        }

        function buildAllMarquees() { stackRows.forEach(buildMarquee); }
        buildAllMarquees();
        // Reconstruir cuando las fuentes carguen (evita medidas erróneas y saltos de layout)
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(buildAllMarquees);

        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(buildAllMarquees, 250);
        });

        // ============ CARRUSELES MÓVILES + PUNTOS ============
        function initCarouselDots(trackId, dotsId) {
            const track = document.getElementById(trackId);
            const dots = document.getElementById(dotsId);
            if (!track || !dots) return;
            const cards = Array.from(track.children);
            if (!cards.length) return;
            const step = () => cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : cards[0].offsetWidth;

            cards.forEach((_, i) => {
                const d = document.createElement('button');
                d.className = 'w-2 h-2 rounded-full bg-white/20 transition-all duration-300';
                d.setAttribute('aria-label', 'Ir al elemento ' + (i + 1));
                d.addEventListener('click', () => track.scrollTo({ left: i * step(), behavior: 'smooth' }));
                dots.appendChild(d);
            });

            const update = () => {
                const idx = Math.min(cards.length - 1, Math.max(0, Math.round(track.scrollLeft / step())));
                [...dots.children].forEach((d, i) => {
                    d.classList.toggle('bg-white', i === idx);
                    d.classList.toggle('bg-white/20', i !== idx);
                    d.classList.toggle('w-5', i === idx);
                });
            };
            let ticking = false;
            track.addEventListener('scroll', () => {
                if (!ticking) {
                    requestAnimationFrame(() => { update(); ticking = false; });
                    ticking = true;
                }
            }, { passive: true });
            update();
        }
        initCarouselDots('cards-carousel', 'cards-dots');
        initCarouselDots('metrics-carousel', 'metrics-dots');
        initCarouselDots('projects-carousel', 'projects-dots');

        // ============ MODAL ============
        const modalDataEs = {
            auto: { title: "⚙️ Automatización", body: "<p><strong>Core Stack:</strong> n8n, Webhooks, REST APIs.</p><p>Creación de flujos condicionales complejos en n8n para conectar herramientas aisladas. Uso de nodos HTTP, transformaciones de JSON complejas y manejo de errores (Error Trigger) para garantizar robustez en producción.</p>" },
            ia: { title: "🧠 Inteligencia Artificial", body: "<p><strong>Core Stack:</strong> OpenAI, Claude, LangChain concepts.</p><p>Integración de modelos LLM mediante API para análisis de sentimiento, extracción de datos estructurados desde texto libre, y agentes conversacionales. Diseño de Prompts estructurados y optimizados para el mejor resultado.</p>" },
            infra: { title: "⚡ Infraestructura", body: "<p><strong>Core Stack:</strong> Docker, Linux VPS, PostgreSQL.</p><p>Despliegue self-hosted de n8n y bases de datos usando Docker Compose. Gestión de variables de entorno, volúmenes persistentes y redes aisladas. Uso de PostgreSQL/Supabase como capa de datos central.</p>" }
        };

        const modalDataEn = {
            auto: { title: "⚙️ Automation", body: "<p><strong>Core Stack:</strong> n8n, Webhooks, REST APIs.</p><p>Building complex conditional flows in n8n to connect isolated tools. Use of HTTP nodes, advanced JSON transformations and error handling (Error Trigger) to guarantee robustness in production.</p>" },
            ia: { title: "🧠 Artificial Intelligence", body: "<p><strong>Core Stack:</strong> OpenAI, Claude, LangChain concepts.</p><p>Integration of LLM models via API for sentiment analysis, structured data extraction from free text, and conversational agents. Design of structured, optimized prompts to get the best results.</p>" },
            infra: { title: "⚡ Infrastructure", body: "<p><strong>Core Stack:</strong> Docker, Linux VPS, PostgreSQL.</p><p>Self-hosted deployment of n8n and databases using Docker Compose. Management of environment variables, persistent volumes and isolated networks. PostgreSQL/Supabase as the central data layer.</p>" }
        };

        const modal = document.getElementById('techModal');
        let currentModal = null;

        function renderModal() {
            const data = (document.documentElement.lang === 'en' ? modalDataEn : modalDataEs)[currentModal];
            document.getElementById('modalTitle').innerHTML = data.title;
            document.getElementById('modalBody').innerHTML = data.body;
        }

        function openModal(type) {
            currentModal = type;
            renderModal();
            modal.classList.add('open');
            document.documentElement.style.overflow = 'hidden';
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.classList.remove('open');
            setTimeout(() => {
                document.documentElement.style.overflow = '';
                document.body.style.overflow = '';
            }, 300);
        }

        // Cerrar con clic fuera y con Escape
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
        });

        // ============ OBSERVERS ============
        const generalObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('visible');
            });
        }, { threshold: 0.15 });
        document.querySelectorAll('.fade-in-up').forEach(el => generalObserver.observe(el));

        // ============ CONTADORES (por elemento → funcionan seguro también en móvil) ============
        function animateCounter(el) {
            const target = +el.getAttribute('data-target');
            const duration = 2000;
            let start = null;
            function step(ts) {
                if (!start) start = ts;
                const p = Math.min((ts - start) / duration, 1);
                el.innerText = Math.floor(p * target) + "+";
                if (p < 1) window.requestAnimationFrame(step);
            }
            window.requestAnimationFrame(step);
        }

        const counterObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateCounter(entry.target);
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.5 });
        document.querySelectorAll('.counter[data-target]').forEach(c => counterObserver.observe(c));

        // ============ TIMELINE PROGRESIVO ============
        const timelineTrack = document.getElementById('timeline-track');
        const timelineProgress = document.getElementById('timeline-progress');
        const timelineItems = document.querySelectorAll('.timeline-item');
        let timelineTicking = false;

        function updateTimeline() {
            if (!timelineTrack) return;
            const rect = timelineTrack.getBoundingClientRect();
            const trigger = window.innerHeight * 0.55;
            const progress = Math.min(Math.max((trigger - rect.top) / rect.height, 0), 1);
            timelineProgress.style.height = (progress * 100).toFixed(2) + '%';

            timelineItems.forEach(item => {
                const r = item.getBoundingClientRect();
                const center = r.top + r.height / 2;

                // Histéresis para evitar parpadeo en el borde:
                // - Se ENCIENDE al pasar por encima de trigger + 100px
                // - Se APAGA al bajar de trigger + 40px (al subir el scroll)
                if (center <= trigger + 100) {
                    item.classList.add('active');
                } else if (center > trigger + 40) {
                    item.classList.remove('active');
                }
            });
        }

        window.addEventListener('scroll', () => {
            if (!timelineTicking) {
                window.requestAnimationFrame(() => { updateTimeline(); timelineTicking = false; });
                timelineTicking = true;
            }
        }, { passive: true });
        window.addEventListener('resize', updateTimeline);
        updateTimeline();

        // ============ TEMA + IDIOMA ============
        const i18nEn = {
            'nav.services': 'Services', 'nav.projects': 'Projects', 'experience': 'Experience', 'nav.contact': 'Contact',
            'hero.p': 'I design systems that automate processes, integrate artificial intelligence and eliminate manual work. Currently in production managing <span class="text-white font-semibold">1,800+ clients</span> for a distribution company.',
