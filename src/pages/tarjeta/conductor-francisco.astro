<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Francisco Ferrer Castilla — 096matics</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--bg-deep: #0a0a0a;
				--ink: #f3f5f8;
				--ink-dim: rgba(243, 245, 248, 0.68);
				--accent: #f0b94d;
				--accent-dim: rgba(240, 185, 77, 0.3);
				--available: #3fb56a;
			}

			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				overflow: hidden;
				overscroll-behavior: none;
				background: var(--bg-deep);
			}

			body {
				height: 100dvh;
				font-family: 'IBM Plex Sans', sans-serif;
				color: var(--ink);
				display: flex;
				flex-direction: column;
				position: relative;
				/* z-index explícito para que body cree su propio contexto de apilamiento:
				   si no, su propio fondo negro (stack level 0) se pinta POR DELANTE del
				   .bg de la foto (z-index:-1), en vez de detrás */
				z-index: 0;
				cursor: pointer;
			}

			/* capa de fondo extra, siempre a pantalla completa y muy desenfocada: en
			   escritorio el panel nítido (.bg) es más estrecho que la pantalla, así que
			   esto se ve detrás, a los lados, dando un degradado ambiental en vez de un
			   corte seco contra el negro plano. En móvil queda totalmente tapada por .bg
			   (que sí cubre toda la pantalla ahí), así que no molesta */
			.bg-blur {
				position: fixed;
				inset: 0;
				z-index: -2;
				background: url('/tarjeta/conductor-francisco/foto.jpg') no-repeat center center / cover;
				filter: blur(70px) brightness(0.32) saturate(1.15);
				transform: scale(1.15);
				transition: filter 0.7s ease;
			}
			body.expanded .bg-blur {
				filter: blur(70px) brightness(0.22) saturate(1.15);
			}

			/* la foto vive en su propia capa fija a pantalla completa, independiente del
			   flujo del contenido, para poder desenfocarla al abrir la carta sin afectar
			   al texto que va encima */
			.bg {
				position: fixed;
				inset: 0;
				z-index: -1;
				transition:
					filter 0.7s ease,
					transform 0.7s ease;
				/* móvil: hace falta algo de zoom (si no, con "cover" en una pantalla tan alta
				   y estrecha se ve la foto entera comprimida, sin margen para encuadrar) para
				   que la cara + cuello queden por encima del texto, sin cortar el pelo de
				   forma brusca */
				background: url('/tarjeta/conductor-francisco/foto.jpg') no-repeat center 94% / auto 125%;
			}
			@media (min-width: 640px) {
				.bg {
					/* "cover" a pantalla completa obliga a un zoom mínimo bastante alto en
					   escritorio (imagen ancha contra pantalla ancha). En vez de eso, la foto
					   vive en un panel centrado de ancho limitado — así "cover" se calcula
					   contra un cuadro más estrecho y podemos alejar mucho más el zoom sin que
					   aparezcan márgenes: fuera del panel solo se ve el fondo desenfocado
					   (.bg-blur) de detrás, así que no se nota como un corte */
					top: 0;
					bottom: 0;
					left: 50%;
					right: auto;
					width: min(800px, 100vw);
					transform: translateX(-50%);
					background-position: center 50%;
					background-size: cover;
				}
				/* viñeta por encima de la foto nítida y el fondo borroso: funde ambas
				   capas entre sí y contra el fondo de la página con un degradado, en vez
				   de depender de que los colores del fondo borroso "encajen" con el
				   negro — así el borde queda suave pase lo que pase en esa zona de la
				   foto */
				.vignette {
					display: block;
				}
			}
			body.expanded .bg {
				filter: blur(14px) brightness(0.72);
				transform: scale(1.08);
			}
			/* misma especificidad que la regla de arriba: al ir después en el CSS, esta
			   gana en escritorio y conserva el centrado (translateX) al hacer zoom */
			@media (min-width: 640px) {
				body.expanded .bg {
					transform: translateX(-50%) scale(1.08);
				}
			}

			/* viñeta por delante de la foto nítida y el fondo borroso: funde ambas
			   capas entre sí y contra el negro de la página con un degradado propio, en
			   vez de depender de que los colores del fondo borroso "encajen" — así el
			   borde queda suave pase lo que pase en esa zona de la foto. Solo hace
			   falta en escritorio, donde el panel nítido es más estrecho que la
			   pantalla; en móvil la foto ya llega de borde a borde */
			.vignette {
				display: none;
			}
			@media (min-width: 640px) {
				.vignette {
					display: block;
					position: fixed;
					inset: 0;
					z-index: -1;
					pointer-events: none;
					background: radial-gradient(ellipse 62% 68% at center, transparent 45%, rgba(10, 10, 10, 0.5) 75%, var(--bg-deep) 100%);
				}
			}

			.scrim {
				position: fixed;
				inset: 0;
				pointer-events: none;
				transition: opacity 0.7s ease;
				background: linear-gradient(180deg, rgba(10, 10, 10, 0) 0%, rgba(10, 10, 10, 0) 62%, rgba(10, 10, 10, 0.55) 82%, rgba(10, 10, 10, 0.88) 100%);
			}
			.scrim-strong {
				opacity: 0;
				background: linear-gradient(180deg, rgba(10, 10, 10, 0) 0%, rgba(10, 10, 10, 0.18) 38%, rgba(10, 10, 10, 0.68) 75%, rgba(10, 10, 10, 0.93) 100%);
			}
			body.expanded .scrim-strong {
				opacity: 1;
			}

			/* --- animación de apertura: los mismos anillos "toca para entrar" de la home,
			   pero en modo ráfaga única (como si ese toque ya hubiera ocurrido) --- */
			.intro-pulse {
				position: fixed;
				inset: 0;
				z-index: 5;
				display: flex;
				align-items: center;
				justify-content: center;
				pointer-events: none;
				background: rgba(10, 10, 10, 0.22);
				transition:
					opacity 0.5s ease,
					transform 0.5s ease;
			}
			.intro-pulse.intro-exit {
				opacity: 0;
				transform: scale(1.06);
			}
			.intro-pulse .ring {
				position: absolute;
				width: 4rem;
				height: 4rem;
				border-radius: 9999px;
				border: 1px solid rgba(59, 130, 246, 0.55);
				animation: intro-ring 1s ease-out both;
			}
			.intro-pulse .ring:nth-child(2) {
				border-color: rgba(168, 85, 247, 0.55);
				animation-delay: 0.16s;
			}
			.intro-pulse .dot {
				position: relative;
				width: 1rem;
				height: 1rem;
				border-radius: 50%;
				background: linear-gradient(135deg, #3b82f6, #a855f7);
				animation: intro-dot 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
			}
			@keyframes intro-ring {
				0% {
					transform: scale(0.5);
					opacity: 0.9;
				}
				100% {
					transform: scale(3.4);
					opacity: 0;
				}
			}
			@keyframes intro-dot {
				0% {
					transform: scale(0.4);
					opacity: 0;
				}
				60% {
					transform: scale(1.15);
					opacity: 1;
				}
				100% {
					transform: scale(1);
					opacity: 1;
				}
			}

			.photo-space {
				position: relative;
				flex: 1 1 auto;
				min-height: 400px;
			}
			@media (min-width: 640px) {
				.photo-space {
					min-height: 460px;
					/* mismo ancho que el panel de la foto (.bg), para que el badge de
					   disponibilidad (posicionado dentro de este bloque) quede alineado con
					   la foto en vez de pegado al borde de una pantalla ancha. "width" (no
					   max-width): este bloque no tiene contenido propio que le dé un ancho
					   natural (el badge va con position:absolute), así que con max-width se
					   queda en 0 al centrarlo con margin:auto */
					width: min(800px, 100vw);
					margin: 0 auto;
				}
				/* en escritorio el panel es ancho de sobra para que quepan uno al lado
				   del otro */
				.cv-download {
					top: 14px;
				}
			}

			.available-badge {
				position: absolute;
				top: 14px;
				left: 20px;
				z-index: 1;
				display: inline-flex;
				align-items: center;
				gap: 6px;
				background: rgba(10, 14, 11, 0.65);
				backdrop-filter: blur(4px);
				-webkit-backdrop-filter: blur(4px);
				border: 1px solid rgba(63, 181, 106, 0.5);
				color: var(--available);
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.03em;
				padding: 5px 11px;
				border-radius: 999px;
			}
			.available-badge .dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--available);
				animation: pulse 2s ease-in-out infinite;
			}
			@keyframes pulse {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0.4;
				}
			}

			/* solo visible con la tarjeta abierta (la "página de información"), no sobre
			   la foto sola */
			.cv-download {
				position: absolute;
				/* en móvil el badge de disponibilidad ya ocupa casi todo el ancho, así que
				   el botón de CV va debajo en vez de al lado para no solaparse */
				top: 48px;
				right: 20px;
				z-index: 1;
				display: inline-flex;
				align-items: center;
				gap: 6px;
				background: rgba(10, 14, 11, 0.65);
				backdrop-filter: blur(4px);
				-webkit-backdrop-filter: blur(4px);
				border: 1px solid var(--accent-dim);
				color: var(--accent);
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.03em;
				padding: 5px 11px;
				border-radius: 999px;
				text-decoration: none;
				opacity: 0;
				pointer-events: none;
				transform: translateY(-4px);
				transition:
					opacity 0.4s ease,
					transform 0.4s ease;
			}
			body.expanded .cv-download {
				opacity: 1;
				pointer-events: auto;
				transform: translateY(0);
				transition-delay: 0.2s;
			}
			.cv-download svg {
				width: 13px;
				height: 13px;
			}

			.page {
				position: relative;
				z-index: 1;
				width: 100%;
				max-width: 420px;
				margin: 0 auto;
				padding: 0 20px 26px;
				flex-shrink: 0;
				animation: pageIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.9s forwards;
				opacity: 0;
			}
			@keyframes pageIn {
				from {
					opacity: 0;
					transform: translateY(10px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.name {
				font-family: 'Chakra Petch', sans-serif;
				font-size: 26px;
				font-weight: 600;
				margin: 0 0 3px;
				text-shadow: 0 2px 14px rgba(0, 0, 0, 0.85), 0 1px 3px rgba(0, 0, 0, 0.9);
			}
			.role {
				font-size: 13px;
				color: var(--ink-dim);
				margin: 0;
				text-shadow: 0 1px 10px rgba(0, 0, 0, 0.85), 0 1px 3px rgba(0, 0, 0, 0.9);
			}

			/* --- todo lo que se abre al tocar la tarjeta --- */
			.page-extra {
				display: grid;
				grid-template-rows: 0fr;
				transition: grid-template-rows 0.7s cubic-bezier(0.22, 1, 0.36, 1);
			}
			body.expanded .page-extra {
				grid-template-rows: 1fr;
			}
			.page-extra-inner {
				overflow: hidden;
				min-height: 0;
				opacity: 0;
				transition: opacity 0.5s ease 0.15s;
			}
			body.expanded .page-extra-inner {
				opacity: 1;
			}

			.current-company {
				font-size: 11px;
				color: var(--ink-dim);
				opacity: 0.9;
				margin: 14px 0 16px;
				text-shadow: 0 1px 10px rgba(0, 0, 0, 0.85), 0 1px 3px rgba(0, 0, 0, 0.9);
			}

			.stats-row {
				display: flex;
				gap: 10px;
				margin-bottom: 16px;
			}
			.stat {
				flex: 1;
				background: rgba(8, 8, 10, 0.6);
				border: 1px solid rgba(255, 255, 255, 0.14);
				backdrop-filter: blur(6px);
				-webkit-backdrop-filter: blur(6px);
				border-radius: 12px;
				padding: 10px 8px;
				text-align: center;
			}
			.stat b {
				display: block;
				font-family: 'Chakra Petch', sans-serif;
				font-size: 17px;
				color: var(--accent);
			}
			.stat span {
				font-size: 9.5px;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--ink-dim);
			}

			.section-label {
				font-size: 10px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 8px;
				text-shadow: 0 1px 8px rgba(0, 0, 0, 0.85), 0 1px 3px rgba(0, 0, 0, 0.9);
			}

			.badges {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				margin-bottom: 18px;
			}
			.badge {
				font-size: 11px;
				font-weight: 600;
				color: var(--ink);
				border: 1px solid var(--accent-dim);
				background: rgba(8, 8, 10, 0.6);
				backdrop-filter: blur(6px);
				-webkit-backdrop-filter: blur(6px);
				padding: 5px 11px;
				border-radius: 999px;
			}

			.quote {
				font-size: 12.5px;
				font-style: italic;
				color: var(--ink-dim);
				background: rgba(8, 8, 10, 0.4);
				border-left: 2px solid var(--accent-dim);
				padding: 8px 10px;
				margin: 0 0 20px;
				border-radius: 0 8px 8px 0;
				line-height: 1.5;
				text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9), 0 1px 3px rgba(0, 0, 0, 0.95);
			}

			.contact-row {
				display: flex;
				gap: 10px;
			}
			.btn {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 7px;
				padding: 13px;
				border-radius: 12px;
				text-decoration: none;
				font-weight: 600;
				font-size: 13px;
			}
			.btn svg {
				width: 16px;
				height: 16px;
			}
			.btn.primary {
				background: var(--accent);
				color: #2a1d08;
			}
			.btn.secondary {
				background: rgba(10, 10, 12, 0.6);
				backdrop-filter: blur(6px);
				-webkit-backdrop-filter: blur(6px);
				color: var(--ink);
				border: 1px solid rgba(255, 255, 255, 0.18);
			}

			.save-link {
				display: block;
				text-align: center;
				margin-top: 12px;
				font-size: 11px;
				color: var(--ink-dim);
				text-decoration: underline;
			}

			@media (max-height: 780px) {
				.photo-space {
					min-height: 230px;
				}
				.current-company {
					margin: 10px 0;
				}
				.stats-row {
					margin-bottom: 10px;
				}
				.badges {
					margin-bottom: 10px;
				}
				.quote {
					margin-bottom: 12px;
				}
			}
			@media (max-height: 680px) {
				.quote {
					display: none;
				}
				.photo-space {
					min-height: 190px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.intro-pulse .ring,
				.intro-pulse .dot {
					animation: none;
				}
				.intro-pulse {
					transition: opacity 0.2s ease;
				}
				.page {
					animation: none;
					opacity: 1;
				}
			}
		</style>
	</head>
	<body>
		<div class="bg-blur"></div>
		<div class="bg"></div>
		<div class="vignette"></div>
		<div class="scrim"></div>
		<div class="scrim scrim-strong"></div>

		<div class="intro-pulse" aria-hidden="true">
			<span class="ring"></span>
			<span class="ring"></span>
			<span class="dot"></span>
		</div>

		<div class="photo-space">
			<span class="available-badge"><span class="dot"></span>Disponible para nueva incorporación</span>
			<a class="cv-download" href="/tarjeta/conductor-francisco/cv-francisco.pdf" download>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
					><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16"></path></svg
				>
				Descargar CV
			</a>
		</div>

		<div class="page">
			<h1 class="name">Francisco Ferrer Castilla</h1>
			<p class="role">Conductor profesional · Petres, Valencia</p>

			<div class="page-extra">
				<div class="page-extra-inner">
					<p class="current-company">Actualmente en Campillo Transportes, Paterna</p>

					<div class="stats-row">
						<div class="stat"><b>20</b><span>Años exp.</span></div>
						<div class="stat"><b>C+E</b><span>Carnet</span></div>
						<div class="stat"><b>Nac./Com.</b><span>Rutas</span></div>
					</div>

					<p class="section-label">Experiencia con vehículos</p>
					<div class="badges">
						<span class="badge">Cisterna alimentaria (sin presión)</span>
						<span class="badge">Frigorífico</span>
						<span class="badge">Lonas</span>
						<span class="badge">Portacontenedores</span>
					</div>

					<p class="section-label">Carnets y certificados</p>
					<div class="badges">
						<span class="badge">B</span>
						<span class="badge">C</span>
						<span class="badge">C+E</span>
						<span class="badge">A2</span>
						<span class="badge">CAP vigente</span>
						<span class="badge">Tacógrafo digital vigente</span>
					</div>

					<p class="quote">
						"Puntual y profesional, con don de gentes y responsabilidad en cada ruta. Acostumbrado a todo
						tipo de horarios."
					</p>

					<div class="contact-row">
						<a class="btn primary" href="tel:+34614293415">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
								><path
									d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
								></path></svg
							>
							Llamar
						</a>
						<a class="btn secondary" href="https://wa.me/34614293415" target="_blank">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
								><path
									d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
								></path></svg
							>
							WhatsApp
						</a>
					</div>

					<a
						class="save-link"
						download="francisco-ferrer.vcf"
						href="data:text/vcard;charset=utf-8,BEGIN%3AVCARD%0AVERSION%3A3.0%0AFN%3AFrancisco%20Ferrer%20Castilla%0ATITLE%3AConductor%20profesional%0ATEL%3BTYPE%3DCELL%3A%2B34614293415%0AEMAIL%3Afranciscorferrercastilla1978%40gmail.com%0AEND%3AVCARD"
						>↓ Guardar contacto</a
					>
				</div>
			</div>
		</div>

		<script>
			const introPulse = document.querySelector('.intro-pulse');
			const page = document.querySelector('.page');
			const cvDownload = document.querySelector('.cv-download');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let expanded = false;

			function setExpanded(value: boolean) {
				expanded = value;
				introPulse?.classList.add('intro-exit');
				document.body.classList.toggle('expanded', value);
			}

			function handleTap(target: Node | null) {
				if (!expanded) {
					setExpanded(true);
					return;
				}
				// dentro de la tarjeta (texto, stats, botones...) o sobre el botón de
				// descargar CV no hace nada — solo tocar fuera vuelve a la foto
				if (target && (page?.contains(target) || cvDownload?.contains(target))) return;
				setExpanded(false);
			}

			document.body.addEventListener('click', (e) => handleTap(e.target as Node));
			document.body.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') handleTap(e.target as Node);
			});

			setTimeout(
				() => {
					introPulse?.classList.add('intro-exit');
				},
				reduceMotion ? 0 : 950
			);
		</script>
	</body>
</html>
