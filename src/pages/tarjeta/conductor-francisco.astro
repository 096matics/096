<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Francisco Ferrer Castilla — 096matics</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--bg-deep: #0a0a0a;
				--panel: #121212;
				--panel-border: rgba(255, 255, 255, 0.08);
				--ink: #f3f5f8;
				--ink-dim: rgba(243, 245, 248, 0.68);
				--accent: #f0b94d;
				--accent-dim: rgba(240, 185, 77, 0.3);
				--available: #3fb56a;
			}

			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				overflow: hidden;
				overscroll-behavior: none;
				background: var(--bg-deep);
			}

			body {
				height: 100dvh;
				background:
					radial-gradient(ellipse 700px 420px at 50% -10%, rgba(240, 185, 77, 0.1), transparent 60%),
					linear-gradient(180deg, #0d0d0d 0%, var(--bg-deep) 55%);
				font-family: 'IBM Plex Sans', sans-serif;
				color: var(--ink);
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px 16px;
			}

			.card {
				width: 100%;
				max-width: 400px;
				border-radius: 22px;
				overflow: hidden;
				border: 1px solid var(--panel-border);
				background: var(--panel);
				box-shadow: 0 30px 70px -25px rgba(0, 0, 0, 0.7);
				animation: cardIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
				opacity: 0;
			}
			@keyframes cardIn {
				from {
					opacity: 0;
					transform: translateY(14px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.hero {
				position: relative;
				min-height: 340px;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				padding: 0 20px 14px;
				overflow: hidden;
				background: url('/tarjeta/conductor-francisco/foto.jpg') no-repeat center 15% / cover;
			}
			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				/* la foto se alarga por debajo del nombre y se difumina hasta el color
				   sólido del panel, para que el texto nunca quede sobre la cara */
				background: linear-gradient(180deg, rgba(10, 10, 10, 0) 32%, var(--panel) 82%);
			}
			.hero-text {
				position: relative;
				z-index: 1;
			}

			.available-badge {
				position: absolute;
				top: 12px;
				left: 12px;
				z-index: 1;
				display: inline-flex;
				align-items: center;
				gap: 6px;
				background: rgba(10, 14, 11, 0.65);
				backdrop-filter: blur(4px);
				-webkit-backdrop-filter: blur(4px);
				border: 1px solid rgba(63, 181, 106, 0.5);
				color: var(--available);
				font-size: 10.5px;
				font-weight: 600;
				letter-spacing: 0.03em;
				padding: 5px 10px;
				border-radius: 999px;
			}
			.available-badge .dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--available);
				animation: pulse 2s ease-in-out infinite;
			}
			@keyframes pulse {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0.4;
				}
			}

			.panel {
				padding: 14px 20px 20px;
			}

			.name {
				font-family: 'Chakra Petch', sans-serif;
				font-size: 24px;
				font-weight: 600;
				margin: 0 0 3px;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65);
			}
			.role {
				font-size: 13px;
				color: var(--ink-dim);
				margin: 0 0 3px;
				text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
			}
			.current-company {
				font-size: 11px;
				color: var(--ink-dim);
				opacity: 0.85;
				margin: 0;
				text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
			}

			.stats-row {
				display: flex;
				gap: 8px;
				margin-bottom: 14px;
			}
			.stat {
				flex: 1;
				background: rgba(255, 255, 255, 0.06);
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 12px;
				padding: 8px 6px;
				text-align: center;
			}
			.stat b {
				display: block;
				font-family: 'Chakra Petch', sans-serif;
				font-size: 16px;
				color: var(--accent);
			}
			.stat span {
				font-size: 9px;
				letter-spacing: 0.03em;
				text-transform: uppercase;
				color: var(--ink-dim);
			}

			.section-label {
				font-size: 9.5px;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 6px;
			}

			.badges {
				display: flex;
				flex-wrap: wrap;
				gap: 5px;
				margin-bottom: 12px;
			}
			.badge {
				font-size: 10.5px;
				font-weight: 600;
				color: var(--ink);
				border: 1px solid var(--accent-dim);
				background: rgba(240, 185, 77, 0.08);
				padding: 4px 10px;
				border-radius: 999px;
			}

			.quote {
				font-size: 12px;
				font-style: italic;
				color: var(--ink-dim);
				border-left: 2px solid var(--accent-dim);
				padding-left: 10px;
				margin: 0 0 16px;
				line-height: 1.45;
			}

			.contact-row {
				display: flex;
				gap: 8px;
			}
			.btn {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 6px;
				padding: 11px;
				border-radius: 12px;
				text-decoration: none;
				font-weight: 600;
				font-size: 13px;
			}
			.btn svg {
				width: 16px;
				height: 16px;
			}
			.btn.primary {
				background: var(--accent);
				color: #2a1d08;
			}
			.btn.secondary {
				background: rgba(255, 255, 255, 0.1);
				color: var(--ink);
				border: 1px solid rgba(255, 255, 255, 0.18);
			}

			.save-link {
				display: block;
				text-align: center;
				margin-top: 10px;
				font-size: 11px;
				color: var(--ink-dim);
				text-decoration: underline;
			}

			@media (max-height: 780px) {
				body {
					padding: 12px 16px;
				}
				.hero {
					min-height: 270px;
				}
				.panel {
					padding: 10px 18px 16px;
				}
				.current-company {
					margin-bottom: 10px;
				}
				.stats-row {
					margin-bottom: 10px;
				}
				.badges {
					margin-bottom: 8px;
				}
				.quote {
					margin-bottom: 12px;
				}
			}
			@media (max-height: 680px) {
				.quote {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<div class="card">
			<div class="hero">
				<span class="available-badge"><span class="dot"></span>Disponible para nueva incorporación</span>
				<div class="hero-text">
					<h1 class="name">Francisco Ferrer Castilla</h1>
					<p class="role">Conductor profesional · Petres, Valencia</p>
					<p class="current-company">Actualmente en Campillo Transportes, Paterna</p>
				</div>
			</div>

			<div class="panel">
				<div class="stats-row">
					<div class="stat"><b>20</b><span>Años exp.</span></div>
					<div class="stat"><b>C+E</b><span>Carnet</span></div>
					<div class="stat"><b>Nac./Com.</b><span>Rutas</span></div>
				</div>

				<p class="section-label">Experiencia con vehículos</p>
				<div class="badges">
					<span class="badge">Cisterna alimentaria (sin presión)</span>
					<span class="badge">Frigorífico</span>
					<span class="badge">Lonas</span>
					<span class="badge">Portacontenedores</span>
				</div>

				<p class="section-label">Carnets y certificados</p>
				<div class="badges">
					<span class="badge">B</span>
