---
const whatsapp =
	'https://wa.me/34727700065?text=' + encodeURIComponent('Hola, me interesa la plantilla de Seguros (Escudo)');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Marc Ferrer — 096matics</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--navy: #0b1626;
				--teal: #17c3a2;
				--teal-dim: rgba(23, 195, 162, 0.25);
				--ink: #eef3f6;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
				overflow: hidden;
				overscroll-behavior: none;
				background: var(--navy);
			}
			body {
				height: 100dvh;
				background: radial-gradient(ellipse 700px 500px at 50% 0%, rgba(23, 195, 162, 0.16), transparent 65%), var(--navy);
				font-family: 'IBM Plex Sans', sans-serif;
				color: var(--ink);
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 32px 16px;
			}
			.card {
				width: 100%;
				max-width: 400px;
			}
			.shield-wrap {
				position: relative;
				width: 108px;
				height: 122px;
				margin: 0 auto 14px;
			}
			.shield-layer {
				position: absolute;
				inset: 0;
				opacity: 0;
				animation: layerIn 0.9s cubic-bezier(0.19, 1, 0.22, 1) forwards;
			}
			.shield-layer:nth-child(1) {
				animation-delay: 0.05s;
			}
			.shield-layer:nth-child(2) {
				animation-delay: 0.25s;
			}
			.shield-layer:nth-child(3) {
				animation-delay: 0.45s;
			}
			@keyframes layerIn {
				0% {
					opacity: 0;
					transform: translateY(-26px) scale(0.9);
				}
				100% {
					opacity: 1;
					transform: translateY(0) scale(1);
				}
			}
			.name {
				font-family: 'Sora', sans-serif;
				font-weight: 800;
				font-size: 25px;
				text-align: center;
				margin: 0 0 3px;
			}
			.role {
				text-align: center;
				font-size: 12.5px;
				color: rgba(238, 243, 246, 0.6);
				margin: 0 0 22px;
			}
			.coverage {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				justify-content: center;
				margin-bottom: 22px;
			}
			.coverage span {
				padding: 7px 13px;
				border-radius: 999px;
				background: var(--teal-dim);
				border: 1px solid rgba(23, 195, 162, 0.45);
				color: var(--teal);
				font-size: 12px;
				font-weight: 500;
				opacity: 0;
				animation: chipIn 0.5s ease 0.7s forwards;
			}
			.coverage span:nth-child(2) {
				animation-delay: 0.78s;
			}
			.coverage span:nth-child(3) {
				animation-delay: 0.86s;
			}
			.coverage span:nth-child(4) {
				animation-delay: 0.94s;
			}
			@keyframes chipIn {
				from {
					opacity: 0;
					transform: translateY(6px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			.panel {
				background: rgba(238, 243, 246, 0.04);
				border: 1px solid rgba(238, 243, 246, 0.1);
				border-radius: 20px;
				padding: 22px;
			}
			.icon-row {
				display: flex;
				justify-content: center;
				gap: 12px;
				margin-bottom: 16px;
			}
			.icon-btn {
				width: 46px;
				height: 46px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				background: rgba(238, 243, 246, 0.05);
				border: 1px solid rgba(238, 243, 246, 0.12);
				color: var(--ink);
			}
			.icon-btn svg {
				width: 18px;
				height: 18px;
			}
			.save-link {
				display: block;
				text-align: center;
				font-size: 12px;
				color: var(--teal);
				text-decoration: none;
				margin-bottom: 18px;
			}
			.cta {
				display: block;
				text-align: center;
				padding: 14px;
				border-radius: 12px;
				background: linear-gradient(135deg, var(--teal), #0d8f78);
				color: #052620;
				text-decoration: none;
				font-weight: 700;
				font-size: 13.5px;
			}
			.trust {
				text-align: center;
				margin-top: 12px;
				font-size: 11px;
				color: rgba(238, 243, 246, 0.45);
			}
			.footer {
				text-align: center;
				margin-top: 16px;
				font-size: 9.5px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: rgba(238, 243, 246, 0.3);
			}
		</style>
	</head>
	<body>
		<div class="card">
			<div class="shield-wrap">
				<svg class="shield-layer" viewBox="0 0 108 122" fill="none">
					<path
						d="M54 4 L100 20 V56 C100 90 80 108 54 118 C28 108 8 90 8 56 V20 Z"
						fill="rgba(23,195,162,0.12)"
						stroke="rgba(23,195,162,0.5)"
						stroke-width="1.5"
					></path>
				</svg>
				<svg class="shield-layer" viewBox="0 0 108 122" fill="none">
					<path
						d="M54 16 L90 29 V56 C90 82 74 97 54 105 C34 97 18 82 18 56 V29 Z"
						fill="rgba(23,195,162,0.18)"
						stroke="rgba(23,195,162,0.65)"
						stroke-width="1.5"
					></path>
				</svg>
				<svg class="shield-layer" viewBox="0 0 108 122" fill="none">
					<path
						d="M54 28 L80 38 V56 C80 74 68 86 54 92 C40 86 28 74 28 56 V38 Z"
						fill="#17c3a2"
					></path>
					<path d="M44 57 L51 64 L66 47" stroke="#052620" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"
					></path>
				</svg>
			</div>
			<h1 class="name">Marc Ferrer</h1>
			<p class="role">Segurvida Correduría · Valencia</p>
			<div class="coverage">
				<span>Hogar</span><span>Auto</span><span>Vida</span><span>Salud</span>
			</div>
			<div class="panel">
				<div class="icon-row">
					<a class="icon-btn" href="tel:+34727700065" aria-label="Llamar">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
							><path
								d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
							></path></svg
						>
					</a>
					<a class="icon-btn" href="https://wa.me/34727700065" target="_blank" aria-label="WhatsApp">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
							><path
								d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
							></path></svg
						>
					</a>
					<a class="icon-btn" href="mailto:contacto@096matics.com" aria-label="Email">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
							><path d="M22 6l-10 7L2 6"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg
						>
					</a>
				</div>
				<a
					class="save-link"
					download="marc-ferrer.vcf"
					href="data:text/vcard;charset=utf-8,BEGIN%3AVCARD%0AVERSION%3A3.0%0AN%3AFerrer%3BMarc%3B%3B%3B%0AFN%3AMarc%20Ferrer%0AORG%3ASegurvida%20Correduria%0ATITLE%3AAgente%20de%20seguros%0ATEL%3BTYPE%3DCELL%3A%2B34727700065%0AEND%3AVCARD"
					>↓ Guardar contacto</a
				>
				<a class="cta" href={whatsapp} target="_blank">Solicita tu presupuesto →</a>
				<p class="trust">Protección en menos de 24h</p>
			</div>
			<p class="footer">096matics · Tarjeta digital</p>
		</div>
	</body>
</html>
