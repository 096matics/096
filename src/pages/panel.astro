---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';

const plantillas = await getCollection('plantillas');

const REPO_EDIT_BASE = 'https://github.com/096matics/096/edit/main/src/content/plantillas';

const estadoInfo = {
	publico: { label: 'Público', class: 'bg-emerald-400/10 text-emerald-400 border-emerald-400/30' },
	proximamente: { label: 'Próximamente', class: 'bg-amber-400/10 text-amber-400 border-amber-400/30' },
	privado: { label: 'Privado', class: 'bg-zinc-400/10 text-zinc-400 border-zinc-700' },
};

function agruparPorSector(items: typeof plantillas) {
	const grupos = new Map<string, typeof plantillas>();
	for (const item of items) {
		const clave = item.data.sector ?? 'Sin sector';
		if (!grupos.has(clave)) grupos.set(clave, []);
		grupos.get(clave)!.push(item);
	}
	return grupos;
}

const sectorItems = plantillas.filter((p) => p.data.categoria === 'sector');
const personalItems = plantillas.filter((p) => p.data.categoria === 'personal');
const clienteItems = plantillas.filter((p) => p.data.categoria === 'cliente');
const sectorGrupos = agruparPorSector(sectorItems);
---

<Layout title="Panel" description="Panel interno de 096matics">
	<div class="mx-auto max-w-4xl px-6 py-12">
		<div class="flex items-center justify-between">
			<div class="text-lg"><Logo /></div>
			<a
				href="https://dash.cloudflare.com/"
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-full border border-zinc-700 px-4 py-2 text-sm text-zinc-300 transition-colors hover:border-zinc-500 hover:text-white"
			>
				Ver analíticas en Cloudflare ↗
			</a>
		</div>

		<h1 class="mt-10 text-2xl font-semibold text-white">Panel de plantillas</h1>
		<p class="mt-2 max-w-xl text-sm text-zinc-500">
			Estado de cada plantilla y tarjeta. Para publicar, ocultar o editar una, pulsa "Editar en GitHub":
			cambia <code class="rounded bg-zinc-900 px-1 py-0.5 text-zinc-300">estado</code> por
			<code class="rounded bg-zinc-900 px-1 py-0.5 text-zinc-300">publico</code>,
			<code class="rounded bg-zinc-900 px-1 py-0.5 text-zinc-300">proximamente</code> o
			<code class="rounded bg-zinc-900 px-1 py-0.5 text-zinc-300">privado</code>, y confirma el commit ahí
			mismo.
		</p>

		<section class="mt-12">
			<h2 class="text-sm tracking-widest text-indigo-400 uppercase">Plantillas por sector</h2>
			<div class="mt-6 space-y-8">
				{
					[...sectorGrupos.entries()].map(([sector, items]) => (
						<div>
							<p class="text-xs font-medium tracking-wide text-zinc-500 uppercase">{sector}</p>
							<div class="mt-3 space-y-2">
								{items.map((item) => {
									const info = estadoInfo[item.data.estado];
									return (
										<div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-zinc-800 bg-zinc-900/40 px-4 py-3">
											<div>
												<p class="text-sm font-medium text-white">{item.data.nombre}</p>
												<p class="mt-0.5 text-xs text-zinc-500">{item.data.descripcion}</p>
											</div>
											<div class="flex items-center gap-3">
												<span class={`rounded-full border px-3 py-1 text-xs font-medium ${info.class}`}>
													{info.label}
												</span>
												{item.data.ruta && (
													<a
														href={item.data.ruta}
														target="_blank"
														rel="noopener noreferrer"
														class="text-xs font-medium text-indigo-400 transition-colors hover:text-white"
													>
														Ver página →
													</a>
												)}
												<a
													href={`${REPO_EDIT_BASE}/${item.id}.md`}
													target="_blank"
													rel="noopener noreferrer"
													class="text-xs font-medium text-zinc-400 transition-colors hover:text-white"
												>
													Editar en GitHub →
												</a>
											</div>
										</div>
									);
								})}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="mt-12">
			<h2 class="text-sm tracking-widest text-indigo-400 uppercase">Tarjetas personales del equipo</h2>
			<div class="mt-6 space-y-2">
				{
					personalItems.map((item) => {
						const info = estadoInfo[item.data.estado];
						return (
							<div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-zinc-800 bg-zinc-900/40 px-4 py-3">
								<p class="text-sm font-medium text-white">{item.data.nombre}</p>
								<div class="flex items-center gap-3">
									<span class={`rounded-full border px-3 py-1 text-xs font-medium ${info.class}`}>
										{info.label}
									</span>
									{item.data.ruta && (
										<a
											href={item.data.ruta}
											target="_blank"
											rel="noopener noreferrer"
											class="text-xs font-medium text-indigo-400 transition-colors hover:text-white"
										>
											Ver página →
										</a>
									)}
									<a
										href={`${REPO_EDIT_BASE}/${item.id}.md`}
										target="_blank"
										rel="noopener noreferrer"
										class="text-xs font-medium text-zinc-400 transition-colors hover:text-white"
									>
										Editar en GitHub →
									</a>
								</div>
							</div>
						);
					})
				}
			</div>
		</section>

		<section class="mt-12">
			<h2 class="text-sm tracking-widest text-indigo-400 uppercase">Clientes reales</h2>
			<div class="mt-6 space-y-2">
				{
					clienteItems.map((item) => {
						const info = estadoInfo[item.data.estado];
						return (
							<div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-zinc-800 bg-zinc-900/40 px-4 py-3">
								<div>
									<p class="text-sm font-medium text-white">{item.data.nombre}</p>
									<p class="mt-0.5 text-xs text-zinc-500">{item.data.descripcion}</p>
								</div>
								<div class="flex items-center gap-3">
									<span class={`rounded-full border px-3 py-1 text-xs font-medium ${info.class}`}>
										{info.label}
									</span>
									{item.data.ruta && (
										<a
											href={item.data.ruta}
											target="_blank"
											rel="noopener noreferrer"
											class="text-xs font-medium text-indigo-400 transition-colors hover:text-white"
										>
											Ver página →
										</a>
									)}
									<a
										href={`${REPO_EDIT_BASE}/${item.id}.md`}
										target="_blank"
										rel="noopener noreferrer"
										class="text-xs font-medium text-zinc-400 transition-colors hover:text-white"
									>
										Editar en GitHub →
									</a>
								</div>
							</div>
						);
					})
				}
			</div>
		</section>
	</div>
</Layout>
