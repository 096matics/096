---
import '../styles/global.css';
import PreviewOverlay from '../components/PreviewOverlay.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = '096matics — tarjetas NFC que llevan a tus clientes directo a dejar una reseña en Google.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} · 096matics</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 font-sans antialiased">
		<div class="ambient-glow" aria-hidden="true"></div>
		<div class="bg-grid" aria-hidden="true"></div>
		<div class="grain-overlay" aria-hidden="true"></div>

		<slot />
		<PreviewOverlay />
	</body>
</html>

<script>
	// revelado al hacer scroll: cualquier sección marcada con data-animate gana .is-revealing
	// la primera vez que entra en el viewport, y los estilos en global.css hacen el resto.
	//
	// La velocidad del revelado no es fija: de base es lenta y vistosa, pero si el usuario
	// va desplazándose rápido, el sistema lo nota (velocidad de scroll suavizada por rAF) y
	// acelera la animación para que el contenido no se quede "atrás" de la vista. El multiplicador
	// se fija en --reveal-speed justo antes de disparar cada revelado, así que todas las piezas
	// de esa sección comparten el mismo ritmo.
	const root = document.documentElement;
	let lastY = window.scrollY;
	let lastT = performance.now();
	let velocity = 0; // px/ms, suavizada

	function trackVelocity(now: number) {
		const y = window.scrollY;
		const dt = now - lastT;
		if (dt > 0) {
			const instant = Math.abs(y - lastY) / dt;
			velocity = velocity * 0.75 + instant * 0.25;
		}
		lastY = y;
		lastT = now;
		// fondo reactivo al scroll: un desplazamiento sutil de la retícula, proporcional
		// a la velocidad (tope para que nunca sea brusco), reutilizando esta misma medición.
		const parallax = Math.min(10, velocity * 14);
		root.style.setProperty('--scroll-parallax', `${parallax.toFixed(2)}px`);
		requestAnimationFrame(trackVelocity);
	}
	requestAnimationFrame(trackVelocity);

	// fondo reactivo al cursor: el resplandor sigue al puntero con un pequeño retraso
	// (la transición vive en el CSS), desplazándose sólo unos px desde el centro del blob.
	let pointerTicking = false;
	let pendingPointer: { x: number; y: number } | null = null;
	function applyPointer() {
		pointerTicking = false;
		if (!pendingPointer) return;
		const { x, y } = pendingPointer;
		const offsetX = (x / window.innerWidth - 0.5) * 70;
		const offsetY = (y / window.innerHeight - 0.5) * 70;
		root.style.setProperty('--pointer-x', `${offsetX.toFixed(1)}px`);
		root.style.setProperty('--pointer-y', `${offsetY.toFixed(1)}px`);
	}
	window.addEventListener(
		'pointermove',
		(e) => {
			pendingPointer = { x: e.clientX, y: e.clientY };
			if (pointerTicking) return;
			pointerTicking = true;
			requestAnimationFrame(applyPointer);
		},
		{ passive: true }
	);

	function speedMultiplier() {
		// en reposo o scroll deliberado: ritmo base (1) o incluso algo más lento (hasta 1.15).
		// scroll rápido: se acelera hasta un suelo de 0.4 para no quedarse atrás.
		const m = 1.08 - velocity * 0.16;
		return Math.min(1.15, Math.max(0.4, m));
	}

	const targets = document.querySelectorAll<HTMLElement>('[data-animate]');
	if (targets.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						root.style.setProperty('--reveal-speed', speedMultiplier().toFixed(3));
						entry.target.classList.add('is-revealing');
						observer.unobserve(entry.target);
					}
				}
			},
			// threshold 0 (en vez de una fracción del alto del elemento): con secciones muy
			// altas —como el portafolio, con el mazo de sectores y el mosaico— exigir un % fijo
			// del área total nunca llega a cumplirse en viewports más bajos que esa altura.
			// Basta con que un solo píxel entre en la zona recortada por rootMargin.
			{ threshold: 0, rootMargin: '0px 0px -8% 0px' }
		);
		targets.forEach((el) => observer.observe(el));
	}
</script>

