---
interface Props {
	color: string;
	negocio: string;
	tipo?: 'resena' | 'contacto';
}

const { color, negocio, tipo = 'resena' } = Astro.props;
const inicial = negocio.trim().charAt(0).toUpperCase();

const pie =
	tipo === 'contacto'
		? {
				kicker: `Así comparte contacto ${negocio}`,
				texto: 'Contacto guardado en menos de 10 segundos, sin apps ni tarjetas de papel.',
			}
		: {
				kicker: `Así lo ve el cliente de ${negocio}`,
				texto: 'Reseña dejada en menos de 10 segundos, sin salir de la app de Google.',
			};
---

<div
	class="flex flex-col items-center gap-8 rounded-2xl border border-zinc-800 bg-zinc-900/40 px-6 py-10 sm:flex-row sm:justify-center sm:gap-10"
	style={`--accent: ${color}`}
>
	<div class="flex shrink-0 items-center gap-3">
		<svg width="20" height="32" viewBox="0 0 20 32" role="img" aria-label="Onda NFC">
			<path
				d="M3 24c-5-4-5-16 0-20M9 28c-8-6-8-24 0-30"
				fill="none"
				stroke="var(--accent)"
				stroke-width="2.5"
				stroke-linecap="round"
				opacity="0.85"
			></path>
		</svg>
		<div class="relative h-56 w-28 rounded-[1.5rem] border-2 border-zinc-700 bg-zinc-950 p-1.5 shadow-xl">
			<div class="absolute top-2.5 left-1/2 h-1 w-7 -translate-x-1/2 rounded-full bg-zinc-700"></div>
			<div class="flex h-full w-full flex-col justify-between rounded-[1.05rem] bg-white px-2.5 pt-6 pb-2.5 text-zinc-900">
				{
					tipo === 'contacto' ? (
						<div class="flex flex-col items-center pt-4 text-center">
							<div
								class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
								style="background: var(--accent)"
							>
								{inicial}
							</div>
							<p class="mt-2 truncate text-[9px] font-medium">{negocio}</p>
							<p class="mt-0.5 text-[7px] text-zinc-400">Presencia digital</p>
						</div>
					) : (
						<div>
							<div class="flex items-center gap-1.5">
								<div
									class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[9px] font-semibold text-white"
									style="background: var(--accent)"
								>
									{inicial}
								</div>
								<p class="truncate text-[9px] font-medium">{negocio}</p>
							</div>
							<div class="mt-2.5 flex gap-0.5">
								{Array.from({ length: 5 }).map(() => (
									<svg width="10" height="10" viewBox="0 0 20 20" fill="var(--accent)">
										<path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z" />
									</svg>
								))}
							</div>
							<p class="mt-1.5 text-[8px] leading-snug text-zinc-400">Escribe una reseña pública...</p>
						</div>
					)
				}
				<div class="rounded-full py-1 text-center text-[8px] font-medium text-white" style="background: var(--accent)">
					{tipo === 'contacto' ? 'Guardar contacto' : 'Publicar'}
				</div>
			</div>
		</div>
	</div>
	<div class="text-center sm:text-left">
		<p class="text-xs tracking-wide text-zinc-500 uppercase">{pie.kicker}</p>
		{
			tipo === 'resena' && (
				<div class="mt-2 flex justify-center gap-1 sm:justify-start" aria-label="5 estrellas">
					{Array.from({ length: 5 }).map(() => (
						<svg width="20" height="20" viewBox="0 0 20 20" fill="var(--accent)">
							<path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z" />
						</svg>
					))}
				</div>
			)
		}
		<p class="mt-2 text-sm text-zinc-400">{pie.texto}</p>
	</div>
</div>
