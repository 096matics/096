---
interface Props {
	color: string;
	negocio: string;
	tipo?: 'resena' | 'contacto';
	compact?: boolean;
	cycle?: boolean;
}

const { color, negocio, tipo = 'resena', compact = false, cycle = false } = Astro.props;
const inicial = negocio.trim().charAt(0).toUpperCase();
const uid = Math.random().toString(36).slice(2, 9);

const pie =
	tipo === 'contacto'
		? {
				kicker: `Así comparte contacto ${negocio}`,
				texto: 'Contacto guardado en menos de 10 segundos, sin apps ni tarjetas de papel.',
			}
		: {
				kicker: `Así lo ve el cliente de ${negocio}`,
				texto: 'Reseña dejada en menos de 10 segundos, sin salir de la app de Google.',
			};

const successTitulo = tipo === 'contacto' ? 'Contacto guardado' : '¡Reseña publicada!';
const successSub = tipo === 'contacto' ? 'directo en su móvil' : 'en 3 segundos, sin apps';
---

<div
	class={`flex flex-col items-center gap-6 ${compact ? '' : 'rounded-2xl border border-zinc-800 bg-zinc-900/40 px-6 py-10 sm:flex-row sm:justify-center sm:gap-12'}`}
	style={`--accent: ${color}`}
>
	<div class="flex shrink-0 items-center gap-4">
		<svg width="22" height="36" viewBox="0 0 20 32" role="img" aria-label="Onda NFC" class="hidden sm:block">
			<path
				d="M3 24c-5-4-5-16 0-20M9 28c-8-6-8-24 0-30"
				fill="none"
				stroke="var(--accent)"
				stroke-width="2.5"
				stroke-linecap="round"
				opacity="0.85"
			></path>
		</svg>
		<div
			class={`relative rounded-[2rem] border-2 border-zinc-700 bg-zinc-950 p-2 shadow-2xl ${compact ? 'h-52 w-28 sm:h-72 sm:w-36' : 'h-72 w-36 sm:h-80 sm:w-40'}`}
		>
			<div class="absolute top-3 left-1/2 h-1.5 w-10 -translate-x-1/2 rounded-full bg-zinc-700"></div>
			<div class="nfc-screen-stack relative h-full w-full overflow-hidden rounded-[1.6rem]" data-nfc-mockup={cycle ? uid : undefined}>
				<div
					class="nfc-screen nfc-screen-a absolute inset-0 flex h-full w-full flex-col justify-between bg-white px-4 pt-8 pb-4 text-zinc-900"
					data-screen="a"
				>
					{
						tipo === 'contacto' ? (
							<div class="flex flex-col items-center pt-6 text-center">
								<div
									class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full text-lg font-semibold text-white"
									style="background: var(--accent)"
								>
									{inicial}
								</div>
								<p class="mt-3 truncate text-sm font-semibold">{negocio}</p>
								<p class="mt-1 text-xs text-zinc-500">Presencia digital</p>
							</div>
						) : (
							<div>
								<div class="flex items-center gap-2">
									<div
										class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
										style="background: var(--accent)"
									>
										{inicial}
									</div>
									<p class="truncate text-sm font-semibold">{negocio}</p>
								</div>
								<div class="mt-4 flex gap-1">
									{Array.from({ length: 5 }).map(() => (
										<svg width="16" height="16" viewBox="0 0 20 20" fill="var(--accent)">
											<path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z" />
										</svg>
									))}
								</div>
								<p class="mt-3 text-xs leading-snug text-zinc-400">Escribe una reseña pública...</p>
							</div>
						)
					}
					<div class="rounded-full py-2 text-center text-xs font-medium text-white" style="background: var(--accent)">
						{tipo === 'contacto' ? 'Guardar contacto' : 'Publicar'}
					</div>
				</div>

				{
					cycle && (
						<div
							class="nfc-screen nfc-screen-b absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-2 bg-white px-4 text-center text-zinc-900 opacity-0"
							data-screen="b"
						>
							<div
								class="flex h-9 w-9 items-center justify-center rounded-full border"
								style="background: color-mix(in srgb, var(--accent) 16%, transparent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); color: var(--accent)"
							>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
									<polyline points="20 6 9 17 4 12" />
								</svg>
							</div>
							<p class="text-sm font-semibold">{successTitulo}</p>
							<p class="text-xs text-zinc-500">{successSub}</p>
						</div>
					)
				}
			</div>
		</div>
	</div>
	{
		!compact && (
			<div class="text-center sm:text-left">
				<p class="text-xs tracking-wide text-zinc-500 uppercase">{pie.kicker}</p>
				{tipo === 'resena' && (
					<div class="mt-2 flex justify-center gap-1 sm:justify-start" aria-label="5 estrellas">
						{Array.from({ length: 5 }).map(() => (
							<svg width="20" height="20" viewBox="0 0 20 20" fill="var(--accent)">
								<path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z" />
							</svg>
						))}
					</div>
				)}
				<p class="mt-2 text-sm text-zinc-400">{pie.texto}</p>
			</div>
		)
	}
</div>

<style>
	.nfc-screen {
		transition:
			opacity 0.5s ease,
			transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
	}
	.nfc-screen-a.is-hidden {
		opacity: 0;
		transform: scale(0.94);
		pointer-events: none;
	}
	.nfc-screen-b {
		transform: scale(0.94);
	}
	.nfc-screen-b.is-visible {
		opacity: 1 !important;
		transform: scale(1);
	}
	@media (prefers-reduced-motion: reduce) {
		.nfc-screen {
			transition: none;
		}
	}
</style>

{
	cycle && (
		<script define:vars={{ uid }}>
			{
				(function () {
					const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					const stack = document.querySelector(`[data-nfc-mockup="${uid}"]`);
					if (!stack || reduceMotion) return;
					const a = stack.querySelector('[data-screen="a"]');
					const b = stack.querySelector('[data-screen="b"]');
					if (!a || !b) return;
					let showingB = false;
					setInterval(() => {
						showingB = !showingB;
						a.classList.toggle('is-hidden', showingB);
						b.classList.toggle('is-visible', showingB);
					}, 2600);
				})();
			}
		</script>
	)
}
