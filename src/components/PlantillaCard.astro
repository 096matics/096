---
interface Props {
	nombre: string;
	descripcion: string;
	sector?: string;
	colorHex?: string;
	imagen?: string;
	ruta?: string;
	compact?: boolean;
}

const { nombre, descripcion, sector, colorHex, imagen, ruta, compact = false } = Astro.props;

const whatsappHref =
	'https://wa.me/34727700065?text=' + encodeURIComponent(`Hola, me interesa la plantilla "${nombre}"`);
const href = ruta ?? whatsappHref;
const accent = colorHex ?? '#f59e0b';
const ctaLabel = ruta ? 'Ver página →' : 'Pídela por WhatsApp →';
---

<div
	role="button"
	tabindex="0"
	data-preview-trigger
	data-preview-group="portafolio"
	data-preview-img={imagen}
	data-preview-sector={sector ?? 'Tarjeta personal'}
	data-preview-title={nombre}
	data-preview-desc={descripcion}
	data-preview-href={href}
	data-preview-cta={ctaLabel}
	class="group block cursor-pointer overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 transition-colors hover:border-zinc-600"
>
	{
		imagen ? (
			<img
				src={imagen}
				alt={nombre}
				class={`w-full object-cover ${compact ? 'aspect-[4/3] sm:aspect-[4/5]' : 'aspect-[4/5]'}`}
				loading="lazy"
			/>
		) : (
			<div
				class={`flex w-full items-center justify-center bg-zinc-900 ${compact ? 'aspect-[4/3] sm:aspect-[4/5]' : 'aspect-[4/5]'}`}
				style={`color:${accent}`}
			>
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="3" y="3" width="18" height="18" rx="3"></rect>
					<path d="M12 8v8M8 12h8"></path>
				</svg>
			</div>
		)
	}
	<div class={compact ? 'p-3.5 sm:p-5' : 'p-5'}>
		<p class="text-xs tracking-wide uppercase" style={`color:${accent}`}>{sector ?? 'Tarjeta personal'}</p>
		<h3 class={`font-medium text-white ${compact ? 'mt-1 text-base sm:mt-1 sm:text-lg' : 'mt-1 text-lg'}`}>{nombre}</h3>
		<p class={`text-zinc-400 ${compact ? 'mt-1 line-clamp-2 text-xs sm:mt-2 sm:text-sm' : 'mt-2 text-sm'}`}>
			{descripcion}
		</p>
		<span class={`inline-block text-zinc-300 group-hover:text-white ${compact ? 'mt-2 text-xs sm:mt-4 sm:text-sm' : 'mt-4 text-sm'}`}>
			{ctaLabel}
		</span>
	</div>
</div>
