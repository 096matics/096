---
import { getCollection } from 'astro:content';
import { ORDEN_SECTORES } from '../../lib/ordenSectores';

interface Props {
	titulo: string;
	whatsappHref: string;
}
const { titulo, whatsappHref } = Astro.props;

const VCARD =
	'data:text/vcard;charset=utf-8,BEGIN%3AVCARD%0AVERSION%3A3.0%0AN%3A096matics%3B%3B%3B%3B%0AFN%3A096matics%0AORG%3A096matics%0ATITLE%3ATarjetas%20digitales%20NFC%0ATEL%3BTYPE%3DCELL%3A%2B34727700065%0AEMAIL%3Acontacto%40096matics.com%0AURL%3Ahttps%3A%2F%2F096matics.com%0AEND%3AVCARD';

const WHATSAPP_BASE = 'https://wa.me/34727700065?text=';

const plantillas = await getCollection('plantillas');
const personalItems = plantillas.filter((p) => p.data.categoria === 'personal' && p.data.estado === 'publico');
const sectorItems = plantillas
	.filter((p) => p.data.categoria === 'sector' && p.data.estado !== 'privado')
	.sort((a, b) => {
		const iA = ORDEN_SECTORES.indexOf(a.data.sector ?? '');
		const iB = ORDEN_SECTORES.indexOf(b.data.sector ?? '');
		return (iA === -1 ? ORDEN_SECTORES.length : iA) - (iB === -1 ? ORDEN_SECTORES.length : iB);
	});

interface Slide {
	tipo: 'imagen' | 'cta';
	tag: string;
	titulo: string;
	descripcion: string;
	imagen?: string;
	href: string;
	ctaLabel: string;
}

const personalSlides: Slide[] = personalItems.map((p) => ({
	tipo: 'imagen',
	tag: 'Tarjeta personal',
	titulo: p.data.nombre,
	descripcion: p.data.descripcion,
	imagen: p.data.imagen,
	href: p.data.ruta ?? WHATSAPP_BASE + encodeURIComponent(`Hola, me interesa una tarjeta como la de ${p.data.nombre}`),
	ctaLabel: p.data.ruta ? 'Abrir esta tarjeta real' : 'Quiero una así',
}));

const sectorSlides: Slide[] = sectorItems.map((p) => {
	const sectorLabel = p.data.sector ?? p.data.nombre;
	if (!p.data.imagen) {
		return {
			tipo: 'cta',
			tag: p.data.ruta ? 'Recién creada' : 'Próximamente',
			titulo: sectorLabel,
			descripcion: p.data.ruta
				? `${p.data.descripcion} Aún sin captura, pero ya puedes abrirla.`
				: `Aún no tenemos un ejemplo público de ${sectorLabel.toLowerCase()} — pero te la hacemos a medida.`,
			href:
				p.data.ruta ?? WHATSAPP_BASE + encodeURIComponent(`Hola, me interesa una plantilla para ${sectorLabel}`),
			ctaLabel: p.data.ruta ? 'Abrir esta web real' : 'Hablar por WhatsApp',
		};
	}
	return {
		tipo: 'imagen',
		tag: p.data.ruta ? 'Ver ejemplo real' : 'Ver ejemplo',
		titulo: `${sectorLabel} · ${p.data.nombre}`,
		descripcion: p.data.descripcion,
		imagen: p.data.imagen,
		href:
			p.data.ruta ??
			WHATSAPP_BASE + encodeURIComponent(`Hola, me interesa la plantilla "${p.data.nombre}" de ${sectorLabel}`),
		ctaLabel: p.data.ruta ? 'Abrir esta web real' : 'Quiero una así',
	};
});

const slides: Slide[] = [...personalSlides, ...sectorSlides];
let slideCursor = -1;
---

<section id="contacto" class="page closing" data-nav="Contacto">
	<p class="eyebrow reveal">Empieza ahora</p>
	<h2 class="section-title reveal">{titulo}</h2>

	<div class="reveal-pop">
		<div class="icon-row">
			<a class="icon-btn" href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
					><path
						d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
					></path></svg
				>
			</a>
			<a class="icon-btn" href="https://www.instagram.com/096matics/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
					><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"
					></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg
				>
			</a>
			<a class="icon-btn" href="mailto:contacto@096matics.com" aria-label="Email">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
					><path d="M22 6l-10 7L2 6"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg
				>
			</a>
		</div>
		<a class="save-link" download="096matics.vcf" href={VCARD}>↓ Guardar contacto de 096matics</a>
	</div>

	<div class="reveal-pop" style="text-align:left; margin-top:28px;">
		{
			personalItems.length > 0 && (
				<div class="shelf-block">
					<p class="shelf-label">Nuestro equipo</p>
					<div class="shelf">
						{personalItems.map((p) => {
							slideCursor++;
							return (
								<div class="shelf-card" data-open-slide={slideCursor}>
									<div class="shelf-thumb">
										{p.data.imagen ? <img src={p.data.imagen} alt={p.data.nombre} loading="lazy" /> : null}
									</div>
									<p>
										{p.data.nombre}
										<span>Tarjeta personal</span>
									</p>
								</div>
							);
						})}
					</div>
				</div>
			)
		}

		{
			sectorItems.length > 0 && (
				<div class="shelf-block">
					<p class="shelf-label">Plantillas por sector</p>
					<div class="shelf">
						{sectorItems.map((p) => {
							slideCursor++;
							const esPlaceholder = !p.data.imagen;
							return (
								<div class={`shelf-card${esPlaceholder ? ' is-placeholder' : ''}`} data-open-slide={slideCursor}>
									<div class={`shelf-thumb${esPlaceholder ? ' placeholder' : ''}`}>
										{p.data.imagen ? (
											<img src={p.data.imagen} alt={p.data.nombre} loading="lazy" />
										) : (
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<rect x="3" y="3" width="18" height="18" rx="3" />
												<path d="M12 8v8M8 12h8" />
											</svg>
										)}
									</div>
									<p>
										{p.data.sector ?? p.data.nombre}
										<span>{p.data.ruta ? 'Ver ejemplo' : esPlaceholder ? 'Próximamente' : 'Ver ejemplo'}</span>
									</p>
								</div>
							);
						})}
					</div>
				</div>
			)
		}

		<a class="save-link" href="/portafolio">Ver el portafolio completo →</a>
		<p class="foot-note">096matics · Sagunto, Valencia</p>
	</div>
</section>

<div class="present" id="present">
	<div class="present-top">
		<div class="present-counter"><b id="idxNow">1</b> / <span id="idxTotal">{slides.length}</span></div>
		<button class="exit-btn" id="btnExit">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
				><path d="M18 6L6 18M6 6l12 12"></path></svg
			>
			Salir
		</button>
	</div>

	<div class="deck" id="deck">
		<div class="tap-zone left" id="zoneLeft"></div>
		<div class="tap-zone right" id="zoneRight"></div>
		<button class="nav-arrow prev" id="btnPrev" aria-label="Anterior">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
		</button>
		<button class="nav-arrow next" id="btnNext" aria-label="Siguiente">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
		</button>

		{
			slides.map((s, i) => (
				<div class={`slide${i === 0 ? ' active' : ''}`} data-href={s.href} data-cta-label={s.ctaLabel}>
					{s.tipo === 'imagen' ? (
						<div class="slide-thumb">
							<img src={s.imagen} alt={s.titulo} loading={i === 0 ? 'eager' : 'lazy'} />
							<div class="slide-info">
								<span class="slide-tag">{s.tag}</span>
								<h2>{s.titulo}</h2>
								<p>{s.descripcion}</p>
							</div>
						</div>
					) : (
						<div class="slide-cta">
							<div class="slide-cta-icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
								</svg>
							</div>
							<h2>{s.titulo}</h2>
							<p>{s.descripcion}</p>
						</div>
					)}
				</div>
			))
		}
	</div>

	<div class="p-dots" id="pDots">
		{slides.map(() => <div class="p-dot" />)}
	</div>

	<div class="present-cta-row">
		<a class="p-btn primary" id="btnOpen" href={slides[0]?.href} target="_blank" rel="noopener">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
				><path
					d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
				></path></svg
			>
			{slides[0]?.ctaLabel}
		</a>
	</div>
</div>

<script>
	const root = document.querySelector('.chasis-root');
	const deckEl = document.getElementById('deck');
	const idxNow = document.getElementById('idxNow');
	const btnOpen = document.getElementById('btnOpen') as HTMLAnchorElement | null;
	const btnPrev = document.getElementById('btnPrev');
	const btnNext = document.getElementById('btnNext');
	const btnExit = document.getElementById('btnExit');

	const slides = Array.from(document.querySelectorAll('.slide')) as HTMLElement[];
	const dots = Array.from(document.querySelectorAll('.p-dot')) as HTMLElement[];
	let presentCurrent = 0;

	function renderPresent(i: number) {
		presentCurrent = Math.max(0, Math.min(slides.length - 1, i));
		slides.forEach((s, idx) => s.classList.toggle('active', idx === presentCurrent));
		dots.forEach((d, idx) => d.classList.toggle('active', idx === presentCurrent));
		if (idxNow) idxNow.textContent = String(presentCurrent + 1);
		const slide = slides[presentCurrent];
		if (btnOpen && slide) {
			btnOpen.href = slide.dataset.href ?? '#';
			btnOpen.textContent = slide.dataset.ctaLabel ?? '';
		}
		btnPrev?.classList.toggle('is-disabled', presentCurrent === 0);
		btnNext?.classList.toggle('is-disabled', presentCurrent === slides.length - 1);
	}

	function openPresent(i: number) {
		root?.classList.add('presenting');
		renderPresent(i);
	}

	document.querySelectorAll('[data-open-slide]').forEach((card) => {
		card.addEventListener('click', () => {
			const idx = Number((card as HTMLElement).dataset.openSlide);
			openPresent(idx);
		});
	});

	btnExit?.addEventListener('click', () => root?.classList.remove('presenting'));
	btnPrev?.addEventListener('click', () => renderPresent(presentCurrent - 1));
	btnNext?.addEventListener('click', () => renderPresent(presentCurrent + 1));
	document.getElementById('zoneLeft')?.addEventListener('click', () => renderPresent(presentCurrent - 1));
	document.getElementById('zoneRight')?.addEventListener('click', () => renderPresent(presentCurrent + 1));
	dots.forEach((d, i) => d.addEventListener('click', () => renderPresent(i)));

	window.addEventListener('keydown', (e) => {
		if (!root?.classList.contains('presenting')) return;
		if (e.key === 'ArrowRight') renderPresent(presentCurrent + 1);
		if (e.key === 'ArrowLeft') renderPresent(presentCurrent - 1);
		if (e.key === 'Escape') root.classList.remove('presenting');
	});

	let pTouchStartX: number | null = null;
	let pTouchStartY: number | null = null;
	deckEl?.addEventListener(
		'touchstart',
		(e) => {
			pTouchStartX = e.touches[0].clientX;
			pTouchStartY = e.touches[0].clientY;
		},
		{ passive: true }
	);
	deckEl?.addEventListener(
		'touchend',
		(e) => {
			if (pTouchStartX === null) return;
			const dx = e.changedTouches[0].clientX - pTouchStartX;
			const dy = e.changedTouches[0].clientY - (pTouchStartY ?? 0);
			if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy)) {
				renderPresent(presentCurrent + (dx < 0 ? 1 : -1));
			}
			pTouchStartX = null;
			pTouchStartY = null;
		},
		{ passive: true }
	);
</script>
