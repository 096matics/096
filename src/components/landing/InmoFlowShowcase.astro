<script>
	// Demo en bucle: cada paso dura lo que su barra de progreso (--dur, en CSS).
	// Al acabar la barra pasa al siguiente y, tras el último, vuelve al primero.
	// Se pausa sola fuera de pantalla y mientras el ratón está sobre la ventana
	// (para poder mirarla con calma); el botón de pausa la para del todo.
	const demo = document.querySelector<HTMLElement>('.ifs-demo');
	if (demo) {
		const tabs = Array.from(demo.querySelectorAll<HTMLButtonElement>('.ifs-tab'));
		const descs = Array.from(demo.querySelectorAll<HTMLElement>('.ifs-desc'));
		const device = demo.querySelector<HTMLElement>('.ifs-device');
		const screens = Array.from(demo.querySelectorAll<HTMLElement>('.ifs-stack .ifp'));
		const navItems = Array.from(demo.querySelectorAll<HTMLElement>('.ifs-device [data-nav]'));
		const clock = demo.querySelector<HTMLElement>('.ifs-device [data-clock]');
		const toggle = demo.querySelector<HTMLButtonElement>('[data-toggle]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const n = tabs.length;
		let current = 0;
		let started = false;
		let userPaused = false;
		let hovering = false;
		let visible = false;

		const syncPause = () => demo.classList.toggle('is-paused', userPaused || hovering || !visible);

		const show = (i: number, focus = false) => {
			current = (i + n) % n;
			tabs.forEach((t, j) => {
				const on = j === current;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				t.classList.toggle('is-done', j < current);
				const bar = t.querySelector<HTMLElement>('.ifs-tab-bar i');
				if (bar) {
					// reinicia la animación de la barra
					bar.style.animation = 'none';
					void bar.offsetWidth;
					bar.style.animation = '';
				}
			});
			descs.forEach((d, j) => d.classList.toggle('is-active', j === current));
			navItems.forEach((it) => it.classList.toggle('is-current', Number(it.dataset.nav) === current));
			if (clock) clock.textContent = tabs[current].dataset.hora ?? '';
			screens.forEach((s) => s.classList.remove('is-active'));
			// un frame en reposo para que las entradas de la pantalla arranquen de cero
			if (started) requestAnimationFrame(() => requestAnimationFrame(() => screens[current]?.classList.add('is-active')));
			if (focus) tabs[current].focus();
		};

		tabs.forEach((t, i) => {
			t.addEventListener('click', () => show(i));
			t.addEventListener('keydown', (e) => {
				const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (!dir) return;
				e.preventDefault();
				show(current + dir, true);
			});
			t.querySelector('.ifs-tab-bar i')?.addEventListener('animationend', () => {
				if (i === current) show(current + 1);
			});
		});
		demo.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
		demo.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
		toggle?.addEventListener('click', () => {
			userPaused = !userPaused;
			demo.classList.toggle('is-user-paused', userPaused);
			toggle.setAttribute('aria-label', userPaused ? 'Reanudar' : 'Pausar');
			syncPause();
		});
		device?.addEventListener('mouseenter', () => {
			hovering = true;
			syncPause();
		});
		device?.addEventListener('mouseleave', () => {
			hovering = false;
			syncPause();
		});

		if (reduceMotion) {
			if (toggle) toggle.hidden = true;
		} else {
			demo.classList.add('is-playing');
		}
		syncPause();

		new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					visible = e.isIntersecting;
					if (visible && !started) {
						started = true;
						show(current);
					}
				}
				syncPause();
			},
			{ threshold: 0.35 },
		).observe(demo);
	}
</script>
