---
import WhatsAppCTA from '../WhatsAppCTA.astro';
import Ventana from './inmoflow/Ventana.astro';
import Pantalla from './inmoflow/Pantalla.astro';

// Presentación de producto de InmoFlow en la home. El corazón es una ventana
// de la propia app que recorre sola, en bucle, las cinco páginas del día a
// día (captación → respuesta → ficha → visita → estadísticas), con una
// explicación en lenguaje llano al lado de cada una. Las funciones salen de
// /tarjeta/inmoflow; el lead, las horas y las cifras son un ejemplo
// ilustrativo. A propósito no hay precios ni plazos de montaje: todo es
// modular y se presupuesta a medida.
const pasos = [
	{
		n: '01',
		kicker: 'Captación',
		titulo: 'Todos tus canales, en una sola bandeja.',
		texto: 'Cuando alguien pregunta por un piso —en tu web, en un portal, por WhatsApp o en redes— aparece aquí al momento, con su nombre, de dónde viene y qué ha escrito.',
		puntos: ['Ningún contacto se pierde entre correos y pestañas', 'Ves de un vistazo de dónde viene cada cliente'],
		hora: '23:47',
	},
	{
		n: '02',
		kicker: 'Respuesta',
		titulo: 'InmoFlow le contesta solo, en segundos.',
		texto: 'Sin que nadie toque el móvil, le escribe por WhatsApp desde el número de tu inmobiliaria y le hace las primeras preguntas. Aunque sean las once de la noche.',
		puntos: ['Mensajes con tu nombre y tu forma de hablar', 'El cliente no se enfría esperando al lunes'],
		hora: '23:47',
	},
	{
		n: '03',
		kicker: 'Ficha',
		titulo: 'Su ficha se rellena sola.',
		texto: 'Cada respuesta del cliente se guarda en su ficha: qué busca, cuánto puede gastar y en qué zona. Y avanza por tu embudo de ventas sin que lo muevas tú.',
		puntos: ['Sabes a quién llamar primero', 'Todo tu equipo ve la misma información'],
		hora: '23:49',
	},
	{
		n: '04',
		kicker: 'Visita',
		titulo: 'La visita, directamente en tu agenda.',
		texto: 'Cuando el cliente está listo, se le propone hora y la visita queda apuntada, con un recordatorio automático por WhatsApp el mismo día.',
		puntos: ['Menos llamadas para cuadrar horarios', 'Menos visitas a las que nadie se presenta'],
		hora: '23:52',
	},
	{
		n: '05',
		kicker: 'Estadísticas',
		titulo: 'Y tú, con los números delante.',
		texto: 'Cuántos contactos entran, cuánto se tarda en responder, cuántas visitas se agendan y qué canal te trae más clientes. En tiempo real.',
		puntos: ['Sabes qué portal o campaña compensa', 'Decides con datos, no con intuición'],
		hora: 'Lun 09:00',
	},
];

const integraciones = ['WhatsApp', 'Facebook', 'Instagram', 'Google', 'Meta', 'Stripe', 'Zapier'];
const modulos = [
	{ nombre: 'Captación de leads', on: true },
	{ nombre: 'CRM', on: true },
	{ nombre: 'WhatsApp automático', on: true },
	{ nombre: 'Agenda de visitas', on: false },
	{ nombre: 'Estadísticas', on: false },
	{ nombre: 'Web de captación', on: false },
];
---

<section id="inmoflow" data-animate class="ifs border-b border-zinc-800 pt-24 pb-24 sm:pt-32 sm:pb-32">
	<div class="mx-auto max-w-6xl px-5 sm:px-6">
		<!-- ============ Presentación ============ -->
		<header class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_auto]">
			<div data-reveal class="piece piece-top piece-d0 max-w-3xl">
				<div class="flex items-center gap-3">
					<span class="ifs-mark" aria-hidden="true">
						<svg viewBox="0 0 32 32" width="22" height="22"><path d="M16 8l8 7h-2.5v8h-4v-5h-3v5h-4v-8H8z" fill="#fff"></path></svg>
					</span>
					<span class="text-lg font-semibold tracking-tight text-white">InmoFlow</span>
					<span class="rounded-full border border-emerald-400/30 px-2.5 py-0.5 text-[11px] font-semibold tracking-wide text-emerald-300">
						Para inmobiliarias
					</span>
				</div>
				<h2 class="ifs-title mt-7 text-4xl font-semibold text-white sm:text-6xl">
					Ningún lead<br class="hidden sm:block" /> sin respuesta.
				</h2>
				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-400 sm:text-xl">
					El sistema todo en uno que capta cada contacto, le contesta por WhatsApp al instante y te lo deja con la
					visita agendada. Mientras tú haces lo que de verdad vende: enseñar casas.
				</p>
			</div>
			<div data-reveal class="piece piece-d1 flex flex-wrap gap-3 lg:justify-end">
				<a href="/tarjeta/inmoflow#contacto" class="ifs-btn-primary">Solicitar demo gratuita</a>
				<a href="/tarjeta/inmoflow" class="ifs-btn-ghost">Ver producto <span aria-hidden="true">→</span></a>
			</div>
		</header>

		<!-- ============ Demo en bucle ============ -->
		<div data-reveal class="piece piece-d1 ifs-demo mt-14 sm:mt-20">
			<div class="ifs-tabs" role="tablist" aria-label="Cómo funciona InmoFlow, paso a paso">
				{
					pasos.map((p, i) => (
						<button
							type="button"
							role="tab"
							id={`ifs-tab-${i}`}
							aria-controls={`ifs-desc-${i}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1}
							class="ifs-tab"
							data-hora={p.hora}
						>
							<span class="ifs-tab-bar" aria-hidden="true">
								<i />
							</span>
							<span class="ifs-tab-label">
								<span class="ifs-tab-n">{p.n}</span>
								{p.kicker}
							</span>
						</button>
					))
				}
			</div>

			<div class="ifs-demo-body">
				<div class="ifs-side">
					<div class="ifs-descs">
						{
							pasos.map((p, i) => (
								<div class={`ifs-desc ${i === 0 ? 'is-active' : ''}`} role="tabpanel" id={`ifs-desc-${i}`} aria-labelledby={`ifs-tab-${i}`}>
									<p class="ifs-desc-kicker">Paso {p.n} de 05</p>
									<h3 class="ifs-desc-title">{p.titulo}</h3>
									<p class="ifs-desc-text">{p.texto}</p>
									<ul class="ifs-desc-points">
										{p.puntos.map((t) => (
											<li>{t}</li>
										))}
									</ul>
								</div>
							))
						}
					</div>
					<div class="ifs-controls">
						<button type="button" class="ifs-ctrl" data-prev aria-label="Paso anterior">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
						</button>
						<button type="button" class="ifs-ctrl" data-toggle aria-label="Pausar">
							<svg class="ifs-ico-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
							<svg class="ifs-ico-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path></svg>
						</button>
						<button type="button" class="ifs-ctrl" data-next aria-label="Paso siguiente">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
						</button>
						<span class="ifs-ctrl-hint">Pasa solo · toca un paso para verlo</span>
					</div>
				</div>

				<Ventana nav={0} hora={pasos[0].hora} class="ifs-device">
					<div class="ifs-stack">
						{pasos.map((_, i) => <Pantalla paso={i as 0 | 1 | 2 | 3 | 4} />)}
					</div>
				</Ventana>
			</div>
		</div>

		<!-- ============ Todo lo demás ============ -->
		<div class="mt-24 sm:mt-32">
			<h3 data-reveal class="piece piece-d0 max-w-xl text-2xl font-semibold text-white sm:text-3xl">
				Y todo lo que tu inmobiliaria necesita alrededor.
			</h3>
			<div class="ifs-bento mt-8">
				<article data-reveal class="piece piece-d1 ifs-card ifs-card--wide">
					<div>
						<p class="ifs-card-kicker">Modular</p>
						<p class="ifs-card-title">Monta solo las piezas que necesitas.</p>
						<p class="ifs-card-text">Empieza por una y añade las demás cuando quieras. Lo configuramos nosotros y formamos a tu equipo.</p>
					</div>
					<ul class="ifs-modules" aria-label="Módulos de InmoFlow">
						{
							modulos.map((m, i) => (
								<li class={m.on ? 'is-on' : ''} style={`--d:${i * 0.12}s`}>
									<span class="ifs-toggle" aria-hidden="true" />
									{m.nombre}
								</li>
							))
						}
					</ul>
				</article>

				<article data-reveal class="piece piece-d2 ifs-card">
					<p class="ifs-card-kicker">Con tu marca</p>
					<p class="ifs-card-title">Tu CRM, con tu logo y tus colores.</p>
					<div class="ifs-brand" aria-hidden="true">
						<span class="ifs-brand-logo">TI</span>
						<span>
							<b>Tu Inmobiliaria</b>
							<small>Panel de ventas</small>
						</span>
					</div>
				</article>

				<article data-reveal class="piece piece-d3 ifs-card ifs-card--full">
					<div>
						<p class="ifs-card-kicker">Integraciones</p>
						<p class="ifs-card-title">Se conecta con lo que ya usas.</p>
					</div>
					<div class="ifs-logos">
						{integraciones.map((n) => <span>{n}</span>)}
					</div>
				</article>
			</div>
		</div>

		<!-- ============ Cierre ============ -->
		<div data-reveal class="piece piece-d1 ifs-close mt-6">
			<div>
				<p class="text-sm font-semibold text-emerald-300">Sin packs cerrados · sin permanencia</p>
				<p class="mt-2 text-3xl font-semibold text-white sm:text-4xl">
					Todo es modular.<span class="text-zinc-500"> Te hacemos un presupuesto a tu medida.</span>
				</p>
				<p class="mt-3 text-sm text-zinc-400">Cuéntanos cómo trabajáis y te enseñamos una demo con vuestros propios casos.</p>
			</div>
			<div class="flex flex-wrap gap-3">
				<a href="/tarjeta/inmoflow#contacto" class="ifs-btn-primary">Solicitar demo gratuita</a>
				<WhatsAppCTA texto="Hablar por WhatsApp" mensaje="Hola, he visto InmoFlow en vuestra web y quiero una demo para mi inmobiliaria" />
			</div>
		</div>
	</div>
</section>

<style>
	/* ============ Presentación ============ */
	.ifs-mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: linear-gradient(145deg, #6d8677, #3f5448);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.12) inset,
			0 10px 30px rgba(82, 106, 93, 0.45);
	}
	.ifs-title {
		letter-spacing: -0.035em;
		line-height: 1;
	}
	.ifs-btn-primary,
	.ifs-btn-ghost {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 12px 20px;
		border-radius: 999px;
		font-size: 14px;
		font-weight: 600;
		transition:
			transform 0.2s,
			background-color 0.2s;
	}
	.ifs-btn-primary {
		background: #34d399;
		color: #06120c;
	}
	.ifs-btn-primary:hover {
		transform: translateY(-2px);
		background: #6ee7b7;
	}
	.ifs-btn-ghost {
		color: #e4e4e7;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
	}
	.ifs-btn-ghost:hover {
		background: rgba(255, 255, 255, 0.05);
	}

	/* ============ Demo en bucle ============ */
	.ifs-demo {
		--dur: 7s;
	}
	.ifs-tabs {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 8px;
	}
	.ifs-tab {
		display: flex;
		flex-direction: column;
		gap: 10px;
		min-width: 0;
		padding: 6px 0;
		text-align: left;
		cursor: pointer;
	}
	.ifs-tab:focus-visible {
		outline: 2px solid #34d399;
		outline-offset: 4px;
		border-radius: 6px;
	}
	/* barra de progreso tipo "historias": solo transform, nunca width */
	.ifs-tab-bar {
		display: block;
		height: 3px;
		border-radius: 3px;
		background: #27272a;
	}
	.ifs-tab-bar i {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: #34d399;
		transform: scaleX(0);
		transform-origin: left;
	}
	.ifs-tab.is-done .ifs-tab-bar i,
	.ifs-demo:not(.is-playing) .ifs-tab[aria-selected='true'] .ifs-tab-bar i {
		transform: scaleX(1);
	}
	.ifs-demo.is-playing .ifs-tab[aria-selected='true'] .ifs-tab-bar i {
		animation: ifs-fill var(--dur) linear forwards;
	}
	.ifs-demo.is-paused .ifs-tab-bar i {
		animation-play-state: paused !important;
	}
	@keyframes ifs-fill {
		to {
			transform: scaleX(1);
		}
	}
	.ifs-tab-label {
		display: flex;
		align-items: baseline;
		gap: 8px;
		overflow: hidden;
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: #71717a;
		transition: color 0.3s;
	}
	.ifs-tab:hover .ifs-tab-label {
		color: #a1a1aa;
	}
	.ifs-tab[aria-selected='true'] .ifs-tab-label {
		color: #fff;
	}
	.ifs-tab-n {
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		color: #52525b;
	}
	.ifs-tab[aria-selected='true'] .ifs-tab-n {
		color: #34d399;
	}

	.ifs-demo-body {
		display: grid;
		gap: 28px;
		margin-top: 28px;
	}
	.ifs-side {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	/* las cinco explicaciones ocupan el mismo hueco: así el bloque no salta de
	   alto al cambiar de paso */
	.ifs-descs {
		display: grid;
	}
	.ifs-desc {
		grid-area: 1 / 1;
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition:
			opacity 0.35s ease,
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
			visibility 0s linear 0.35s;
	}
	.ifs-desc.is-active {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition-delay: 0s;
	}
	.ifs-desc-kicker {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6ee7b7;
	}
	.ifs-desc-title {
		margin-top: 10px;
		font-size: 26px;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: #fff;
	}
	.ifs-desc-text {
		margin-top: 12px;
		font-size: 16px;
		line-height: 1.6;
		color: #a1a1aa;
	}
	.ifs-desc-points {
		display: grid;
		gap: 8px;
		margin-top: 16px;
	}
	.ifs-desc-points li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		font-size: 14px;
		color: #d4d4d8;
	}
	.ifs-desc-points li::before {
		content: '✓';
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		margin-top: 1px;
		border-radius: 50%;
		background: rgba(52, 211, 153, 0.15);
		color: #34d399;
		font-size: 10px;
		font-weight: 800;
	}
	.ifs-controls {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.ifs-ctrl {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		color: #e4e4e7;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
		cursor: pointer;
		transition: background-color 0.2s;
	}
	.ifs-ctrl:hover {
		background: rgba(255, 255, 255, 0.06);
	}
	.ifs-ctrl:focus-visible {
		outline: 2px solid #34d399;
		outline-offset: 2px;
	}
	.ifs-ico-play,
	.ifs-demo.is-user-paused .ifs-ico-pause {
		display: none;
	}
	.ifs-demo.is-user-paused .ifs-ico-play {
		display: block;
	}
	.ifs-ctrl-hint {
		margin-left: 6px;
		font-size: 12px;
		color: #52525b;
	}
	.ifs-stack {
		display: grid;
		min-height: 420px;
	}
	.ifs-stack > :global(.ifp) {
		grid-area: 1 / 1;
		transition:
			opacity 0.35s ease,
			visibility 0s linear 0.35s;
	}
	.ifs-stack > :global(.ifp:not(.is-active)) {
		opacity: 0;
		visibility: hidden;
	}
	.ifs-stack > :global(.ifp.is-active) {
		transition-delay: 0s;
	}

	@media (min-width: 1024px) {
		.ifs-demo-body {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			align-items: center;
			gap: 56px;
			margin-top: 40px;
		}
		.ifs-desc-title {
			font-size: 32px;
		}
	}
	@media (max-width: 1023px) {
		/* en una sola columna, la ventana va justo bajo las pestañas: así se ve
		   cambiar de página a la vez que se lee su explicación debajo */
		.ifs-demo-body > :global(.ifs-device) {
			order: -1;
		}
		.ifs-demo-body {
			margin-top: 20px;
		}
	}
	@media (max-width: 639px) {
		.ifs-tabs {
			gap: 5px;
		}
		.ifs-tab-label {
			font-size: 11px;
		}
		.ifs-tab-n,
		.ifs-ctrl-hint {
			display: none;
		}
		.ifs-desc-title {
			font-size: 22px;
		}
		.ifs-desc-text {
			font-size: 15px;
		}
		.ifs-stack {
			min-height: 360px;
		}
	}

	/* ============ Bento ============ */
	.ifs-bento {
		display: grid;
		gap: 16px;
	}
	.ifs-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 24px;
		padding: 26px;
		border-radius: 22px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01));
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
	}
	@media (min-width: 768px) {
		.ifs-bento {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.ifs-card--wide {
			grid-column: span 2;
			flex-direction: row;
			align-items: flex-end;
		}
		.ifs-card--wide > div:first-child {
			max-width: 300px;
		}
		.ifs-card--full {
			grid-column: 1 / -1;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
		}
	}
	.ifs-card-kicker {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6ee7b7;
	}
	.ifs-card-title {
		margin-top: 10px;
		font-size: 20px;
		font-weight: 600;
		line-height: 1.25;
		color: #fff;
	}
	.ifs-card-text {
		margin-top: 8px;
		font-size: 14px;
		line-height: 1.55;
		color: #a1a1aa;
	}
	.ifs-modules {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		flex: 1;
		gap: 8px;
		max-width: 440px;
	}
	.ifs-modules li {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 12px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.03);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
		font-size: 13px;
		color: #a1a1aa;
	}
	.ifs-toggle {
		position: relative;
		flex-shrink: 0;
		width: 28px;
		height: 16px;
		border-radius: 999px;
		background: #3f3f46;
		transition: background-color 0.35s ease;
	}
	.ifs-toggle::after {
		content: '';
		position: absolute;
		top: 2px;
		left: 2px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #fff;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	/* los módulos activos se "encienden" uno tras otro al aparecer la tarjeta */
	.is-revealing .ifs-modules li.is-on {
		color: #fff;
		transition: color 0.35s ease calc(0.8s + var(--d));
	}
	.is-revealing .ifs-modules li.is-on .ifs-toggle {
		background: #34d399;
