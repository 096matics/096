---
import WhatsAppCTA from '../WhatsAppCTA.astro';

// Presentación de InmoFlow como producto: un mini-relato de 4 pasos (llega el
// lead -> se organiza solo -> responde solo -> tú cierras) contado con un móvil
// que va avanzando por esas mismas 4 fases. Todo el reloj es CSS puro (una
// única animación con keyframes en vez de JS cambiando atributos) a propósito:
// en "El mecanismo" un reloj en JS que reasigna fases sufrió varias rondas de
// fallos intermitentes reales (transiciones que a veces no arrancaban). Con un
// timeline declarado de una vez y animation-delay para escalonar cada pieza,
// no hay ningún punto donde el navegador pueda "perderse" un disparo.
const pasos = [
	{
		titulo: 'Llega un lead',
		texto: 'Por WhatsApp, Instagram o tu web — todo entra al mismo sitio, sin mirar cuatro pantallas distintas.',
	},
	{
		titulo: 'Se organiza solo',
		texto: 'InmoFlow lo clasifica y lo mete en tu pipeline: nuevo, contactando, interesado.',
	},
	{
		titulo: 'Responde antes que nadie',
		texto: 'Un mensaje automático por WhatsApp en segundos, aunque sea fin de semana o de madrugada.',
	},
	{
		titulo: 'Tú cierras la venta',
		texto: 'Te llega ya cualificado y con seguimiento hecho — solo te queda la visita.',
	},
];
---

<section data-animate class="border-b border-zinc-800 py-16 sm:py-20">
	<div class="mx-auto max-w-6xl px-5 sm:px-6">
		<div data-reveal class="piece piece-d0 if-card relative overflow-hidden rounded-[28px] border border-emerald-400/15 p-7 sm:p-10">
			<div class="if-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
			<div class="if-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

			<div class="relative grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-14">
				<div>
					<div class="flex items-center gap-2.5">
						<span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg border border-emerald-400/50" aria-hidden="true">
							<span class="block h-2 w-2 rounded-full bg-emerald-400"></span>
						</span>
						<span class="text-sm font-bold tracking-wide text-white">InmoFlow</span>
						<span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/40 bg-emerald-400/10 px-2.5 py-1 text-[10px] font-bold tracking-widest text-emerald-400 uppercase">
							<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
							Producto real
						</span>
					</div>
					<h3 class="mt-4 text-2xl font-semibold text-white sm:text-3xl">De un mensaje de WhatsApp a una venta cerrada</h3>
					<p class="mt-3 max-w-md text-zinc-400">
						InmoFlow capta, organiza y responde a tus clientes potenciales solo — tú entras cuando ya está todo listo
						para cerrar.
					</p>

					<ol class="if-steps mt-6 flex flex-col gap-1">
						{
							pasos.map((p, i) => (
								<li class="if-step relative flex gap-3 rounded-2xl border border-transparent p-3">
									<span class="if-step-num grid h-7 w-7 shrink-0 place-items-center rounded-full text-xs font-bold text-zinc-400">{i + 1}</span>
									<div class="min-w-0">
										<p class="if-step-title text-sm font-semibold text-zinc-300">{p.titulo}</p>
										<p class="mt-0.5 text-[13px] text-zinc-500">{p.texto}</p>
									</div>
								</li>
							))
						}
					</ol>

					<div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
						<span class="text-sm text-zinc-400"><strong class="font-bold text-white">+40%</strong> leads cualificados</span>
						<span class="text-sm text-zinc-400"><strong class="font-bold text-white">&lt;5 min</strong> tiempo de respuesta</span>
					</div>

					<div class="mt-6 flex flex-wrap items-center gap-3">
						<a
							href="/tarjeta/inmoflow"
							class="inline-flex items-center gap-1.5 rounded-full bg-emerald-400 px-4 py-2 text-sm font-semibold text-zinc-950 transition-transform hover:-translate-y-0.5"
						>
							Ver InmoFlow completo
							<span aria-hidden="true">→</span>
						</a>
						<WhatsAppCTA texto="Quiero algo así para mi negocio" mensaje="Hola, he visto InmoFlow y quiero algo parecido para mi negocio" />
					</div>
				</div>

				<div class="if-phone-wrap mx-auto" aria-hidden="true">
					<div class="if-phone">
						<div class="if-phone-screen">
							<div class="if-phone-head"><span class="if-live-dot"></span>InmoFlow · WhatsApp</div>
							<div class="if-tag-slot">
								<span class="if-tag if-tag-lead">
									<span class="if-tag-dot"></span>
									Nuevo lead · Valencia
								</span>
								<span class="if-tag if-tag-done">
									<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
									Visita agendada
								</span>
							</div>
							<div class="if-chat">
								<div class="if-bubble in if-msg-1">¿Sigue disponible el piso de la Av. del Mar?</div>
								<div class="if-bubble in if-typing" aria-hidden="true"><span></span><span></span><span></span></div>
								<div class="if-bubble out if-msg-2">¡Sí! Disponible ahora. ¿Te paso horario de visitas?</div>
							</div>
							<div class="if-chat-input">Escribe un mensaje…</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* ============ Fondo tipo "producto": tarjeta propia con halo verde de marca y
	   una rejilla sutil, para que se lea como un producto de verdad y no como una
	   franja de aviso más entre secciones. ============ */
	.if-card {
		background: #0a0f0d;
	}
	.if-glow {
		background:
			radial-gradient(ellipse 60% 80% at 15% 15%, rgba(52, 211, 153, 0.16), transparent 60%),
			radial-gradient(ellipse 50% 60% at 100% 100%, rgba(52, 211, 153, 0.1), transparent 65%);
	}
	.if-grid {
		opacity: 0.5;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
		background-size: 28px 28px;
		mask-image: radial-gradient(ellipse 80% 80% at 50% 30%, #000 40%, transparent 90%);
	}

	/* ============ Pasos: cada uno se resalta por turnos durante ~2s de un ciclo de
	   8s — un único keyframe compartido, escalonado con animation-delay, en vez de
	   4 animaciones distintas o un reloj en JS. Así el orden y el reparto de tiempo
	   quedan garantizados por el navegador, no por temporizadores que puedan
	   desincronizarse entre sí. ============ */
	.if-step {
		animation: if-step-active 8s ease-in-out infinite;
	}
	.if-step:nth-child(1) {
		animation-delay: 0s;
	}
	.if-step:nth-child(2) {
		animation-delay: 2s;
	}
	.if-step:nth-child(3) {
		animation-delay: 4s;
	}
	.if-step:nth-child(4) {
		animation-delay: 6s;
	}
	.if-step-num {
		background: rgba(255, 255, 255, 0.06);
		transition: none;
	}
	@keyframes if-step-active {
		0%,
		20% {
			border-color: rgba(52, 211, 153, 0.35);
			background: rgba(52, 211, 153, 0.07);
		}
		25%,
		100% {
			border-color: transparent;
			background: transparent;
		}
	}
	.if-step:nth-child(1) .if-step-num,
	.if-step:nth-child(2) .if-step-num,
	.if-step:nth-child(3) .if-step-num,
	.if-step:nth-child(4) .if-step-num,
	.if-step .if-step-title {
		animation: if-step-num-active 8s ease-in-out infinite;
	}
	.if-step:nth-child(1) .if-step-num,
	.if-step:nth-child(1) .if-step-title {
		animation-delay: 0s;
	}
	.if-step:nth-child(2) .if-step-num,
	.if-step:nth-child(2) .if-step-title {
		animation-delay: 2s;
	}
	.if-step:nth-child(3) .if-step-num,
	.if-step:nth-child(3) .if-step-title {
		animation-delay: 4s;
	}
	.if-step:nth-child(4) .if-step-num,
	.if-step:nth-child(4) .if-step-title {
		animation-delay: 6s;
	}
	@keyframes if-step-num-active {
		0%,
		20% {
			color: #6ee7b7;
		}
		25%,
		100% {
			color: inherit;
		}
	}

	/* ============ Móvil: el mismo timeline de 8s dibuja la conversación entera —
	   el mensaje entra, aparece la etiqueta de "nuevo lead", se ve un "escribiendo…"
	   y sale la respuesta, y por último el sello de visita agendada. Cada pieza
	   "aparece y se queda" hasta que el ciclo entero se reinicia de golpe. ============ */
	.if-phone-wrap {
		width: 230px;
	}
	.if-phone {
		position: relative;
		width: 230px;
		background: #111;
		border: 6px solid #111;
		border-radius: 30px;
		padding: 9px;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
		animation: if-phone-float 6.5s ease-in-out infinite;
	}
	@keyframes if-phone-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}
	.if-phone-screen {
		position: relative;
		background: #f7f8f6;
		border-radius: 22px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}
	.if-phone-head {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 14px;
		border-bottom: 1px solid #e7ebe6;
		background: #fff;
		font-size: 11px;
		font-weight: 800;
		color: #22313a;
	}
	.if-live-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #2f9e63;
		flex-shrink: 0;
		animation: if-pulse 2.2s infinite;
	}
	@keyframes if-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(47, 158, 99, 0.45);
		}
		70% {
			box-shadow: 0 0 0 7px rgba(47, 158, 99, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(47, 158, 99, 0);
		}
	}

	/* etiqueta de CRM ("nuevo lead" / "visita agendada"), flotando sobre el chat */
	.if-tag-slot {
		position: absolute;
		top: 46px;
		left: 0;
		right: 0;
		height: 0;
		z-index: 4;
		pointer-events: none;
	}
	.if-tag {
		position: absolute;
		top: 0;
		left: 50%;
		display: inline-flex;
		align-items: center;
		gap: 5px;
		border-radius: 999px;
		background: #0a0f0d;
		color: #6ee7b7;
		font-size: 9.5px;
		font-weight: 800;
		padding: 5px 10px;
		white-space: nowrap;
		box-shadow: 0 8px 18px -6px rgba(0, 0, 0, 0.5);
		opacity: 0;
		transform: translate(-50%, -6px) scale(0.9);
	}
	.if-tag-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #6ee7b7;
	}
	.if-tag-lead {
		animation: if-tag-in 8s ease-out infinite;
		animation-delay: 2s;
	}
	.if-tag-done {
		animation: if-tag-in 8s ease-out infinite;
		animation-delay: 6s;
	}
	@keyframes if-tag-in {
		0%,
		2.5% {
			opacity: 0;
			transform: translate(-50%, -6px) scale(0.9);
		}
		8%,
		100% {
			opacity: 1;
			transform: translate(-50%, 0) scale(1);
		}
	}

	.if-chat {
		position: relative;
		padding: 12px;
		padding-top: 34px;
		height: 300px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		overflow: hidden;
	}
	.if-bubble {
		max-width: 88%;
		padding: 9px 10px;
		border-radius: 13px;
		font-size: 11px;
		margin-bottom: 10px;
		color: #22313a;
		opacity: 0;
		transform: translateY(8px) scale(0.97);
	}
	.if-bubble.in {
		background: #fff;
		border: 1px solid #e5e9e5;
	}
	.if-bubble.out {
		margin-left: auto;
		background: #dce9df;
	}
	.if-msg-1 {
		animation: if-bubble-in 8s ease-out infinite;
		animation-delay: 0s;
	}
	.if-typing {
		display: flex;
		gap: 4px;
		align-items: center;
		padding: 11px 12px;
		animation: if-typing-cycle 8s ease-out infinite;
		animation-delay: 4s;
	}
	.if-typing span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #9db1a3;
		animation: if-blink 1.2s infinite;
	}
	.if-typing span:nth-child(2) {
		animation-delay: 0.2s;
	}
	.if-typing span:nth-child(3) {
		animation-delay: 0.4s;
	}
	.if-msg-2 {
		animation: if-bubble-in 8s ease-out infinite;
		animation-delay: 6s;
	}
	@keyframes if-bubble-in {
		0%,
		2.5% {
			opacity: 0;
			transform: translateY(8px) scale(0.97);
		}
		8%,
		100% {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes if-typing-cycle {
		0%,
		100% {
			opacity: 0;
		}
		2%,
		23% {
			opacity: 1;
		}
		27% {
			opacity: 0;
		}
	}
	@keyframes if-blink {
		0%,
		80%,
		100% {
			opacity: 0.25;
			transform: translateY(0);
		}
		40% {
			opacity: 1;
			transform: translateY(-2px);
		}
	}

	.if-chat-input {
		padding: 10px 12px;
		border-top: 1px solid #e7ebe6;
		background: #fff;
		font-size: 10px;
		color: #9aa19d;
	}

	@media (prefers-reduced-motion: reduce) {
		.if-step,
		.if-step-num,
		.if-step-title,
		.if-phone,
		.if-live-dot,
		.if-tag,
		.if-bubble,
		.if-typing,
		.if-typing span {
			animation: none !important;
		}
		.if-tag-lead,
		.if-bubble {
			opacity: 1;
			transform: none;
		}
		.if-tag-done,
		.if-typing {
			opacity: 0;
			display: none;
		}
	}
</style>
