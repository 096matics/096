---
import WhatsAppCTA from '../WhatsAppCTA.astro';

// El stand de producto de InmoFlow en la home. En vez de enseñar "un CRM"
// (pantallas que cualquier software tiene), cuenta lo único que importa a una
// inmobiliaria: qué le pasa a un lead que entra cuando nadie está mirando.
// Cuatro pasos, cada uno con su pantalla y su hora, del sábado por la noche
// al lunes por la mañana. Las funciones y los datos (7 días, desde 100 €,
// API oficial de WhatsApp, sin permanencia) son los de /tarjeta/inmoflow;
// el lead y las horas son un ejemplo ilustrativo.
const pasos = [
	{ hora: '23:47', titulo: 'Entra un lead', texto: 'Desde tu web, WhatsApp, portales o redes: todos caen en el mismo sitio.' },
	{ hora: '23:47', titulo: 'Se le responde al momento', texto: 'Un WhatsApp automático desde tu número, en segundos, no el lunes.' },
	{ hora: '23:49', titulo: 'Se cualifica solo', texto: 'Operación, presupuesto y zona quedan guardados en su ficha del CRM.' },
	{ hora: '23:52', titulo: 'La visita queda agendada', texto: 'Con recordatorio automático. Tú lo ves el lunes con el café.' },
];
const datos = [
	{ valor: '< 7 días', texto: 'para tenerlo funcionando' },
	{ valor: 'Tu número', texto: 'de WhatsApp, vía API oficial' },
	{ valor: 'Desde 100 €', texto: 'presupuesto cerrado' },
	{ valor: '0', texto: 'permanencias ni cuotas' },
];
---

<section data-animate class="ifs border-b border-zinc-800 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl px-5 sm:px-6">
		<div data-reveal class="piece piece-top piece-d0 max-w-2xl">
			<p class="text-sm font-bold tracking-widest text-emerald-400 uppercase">Producto · InmoFlow</p>
			<h2 class="mt-2 text-3xl font-semibold text-white sm:text-5xl sm:leading-[1.05]">
				Sábado, 23:47.<br /><span class="text-zinc-500">Tu inmobiliaria está cerrada. InmoFlow no.</span>
			</h2>
			<p class="mt-4 text-lg text-zinc-400">
				Captación, CRM y seguimiento por WhatsApp para inmobiliarias. Así es el recorrido de un lead que llega fuera de
				horario:
			</p>
		</div>

		<div data-reveal class="piece piece-d1 ifs-stage mt-12 grid gap-6 lg:mt-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10">
			<!-- Pasos: pestañas que además avanzan solas -->
			<div class="ifs-steps" role="tablist" aria-label="Recorrido de un lead en InmoFlow">
				{
					pasos.map((p, i) => (
						<button
							type="button"
							role="tab"
							id={`ifs-tab-${i}`}
							aria-controls={`ifs-panel-${i}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1}
							class="ifs-step"
							data-step={i}
						>
							<span class="ifs-step-time">{p.hora}</span>
							<span class="ifs-step-body">
								<span class="ifs-step-title">{p.titulo}</span>
								<span class="ifs-step-text">{p.texto}</span>
							</span>
							<span class="ifs-step-bar" aria-hidden="true" />
						</button>
					))
				}
			</div>

			<!-- Pantalla del producto: una por paso -->
			<div class="ifs-device">
				<div class="ifs-device-top" aria-hidden="true">
					<span class="ifs-dots"><i></i><i></i><i></i></span>
					<span class="ifs-app"><span class="ifs-logo">⌂</span>InmoFlow</span>
					<span class="ifs-clock" id="ifsClock">Sáb 23:47</span>
				</div>

				<div class="ifs-screens">
					<!-- 1 · Entra el lead -->
					<div class="ifs-screen is-active" role="tabpanel" id="ifs-panel-0" aria-labelledby="ifs-tab-0">
						<p class="ifs-label ifs-in" style="--i:0">Bandeja de entrada · todos tus canales</p>
						<div class="ifs-sources ifs-in" style="--i:1">
							<span>Web</span><span>WhatsApp</span><span>Portales</span><span>Instagram</span><span>Facebook</span>
						</div>
						<div class="ifs-card ifs-card--new ifs-in" style="--i:2">
							<div class="ifs-av" style="--av:#9b7f8b">JG</div>
							<div class="min-w-0 flex-1">
								<div class="ifs-row-between">
									<strong>Javier García</strong>
									<span class="ifs-badge ifs-badge--blue">Nuevo</span>
								</div>
								<p class="ifs-muted">Formulario web · Piso en Av. del Mar, Valencia</p>
								<p class="ifs-quote">“¿Sigue disponible? Me gustaría verlo.”</p>
							</div>
						</div>
						<div class="ifs-card ifs-card--old ifs-in" style="--i:3">
							<div class="ifs-av" style="--av:#7d9c88">LM</div>
							<div class="min-w-0 flex-1">
								<div class="ifs-row-between"><strong>Laura Martínez</strong><span class="ifs-badge">Interesado</span></div>
								<p class="ifs-muted">Portal · Valencia · 180.000 €</p>
							</div>
						</div>
					</div>

					<!-- 2 · Respuesta automática -->
					<div class="ifs-screen" role="tabpanel" id="ifs-panel-1" aria-labelledby="ifs-tab-1" hidden>
						<p class="ifs-label ifs-in" style="--i:0">WhatsApp · Javier García</p>
						<div class="ifs-chat">
							<div class="ifs-bubble ifs-bubble--them ifs-in" style="--i:1">¿Sigue disponible? Me gustaría verlo.<time>23:47</time></div>
							<div class="ifs-bubble ifs-bubble--us ifs-in" style="--i:3">
								¡Hola Javier! Sí, sigue disponible 🙂 Para enseñarte también opciones parecidas: ¿buscas comprar o
								alquilar?<time>23:47 ✓✓</time>
							</div>
							<p class="ifs-auto ifs-in" style="--i:4"><span class="ifs-live"></span>Enviado automáticamente en 4 segundos</p>
						</div>
					</div>

					<!-- 3 · Cualificación en el CRM -->
					<div class="ifs-screen" role="tabpanel" id="ifs-panel-2" aria-labelledby="ifs-tab-2" hidden>
						<div class="ifs-split">
							<div class="ifs-chat ifs-chat--mini">
								<div class="ifs-bubble ifs-bubble--them ifs-in" style="--i:0">Comprar</div>
								<div class="ifs-bubble ifs-bubble--us ifs-in" style="--i:1">¿Presupuesto aproximado?</div>
								<div class="ifs-bubble ifs-bubble--them ifs-in" style="--i:2">Hasta 320.000 €</div>
							</div>
							<div class="ifs-file ifs-in" style="--i:1">
								<div class="ifs-row-between">
									<strong>Ficha · Javier García</strong>
									<span class="ifs-stage-pill"><span class="ifs-stage-from">Nuevo</span><span class="ifs-stage-to">Interesado</span></span>
								</div>
								<dl>
									<div class="ifs-in" style="--i:2"><dt>Operación</dt><dd>Compra</dd></div>
									<div class="ifs-in" style="--i:3"><dt>Presupuesto</dt><dd>320.000 €</dd></div>
									<div class="ifs-in" style="--i:4"><dt>Zona</dt><dd>Valencia · Av. del Mar</dd></div>
									<div class="ifs-in" style="--i:5"><dt>Canal</dt><dd>Formulario web → WhatsApp</dd></div>
								</dl>
							</div>
						</div>
					</div>

					<!-- 4 · Visita agendada -->
					<div class="ifs-screen" role="tabpanel" id="ifs-panel-3" aria-labelledby="ifs-tab-3" hidden>
						<p class="ifs-label ifs-in" style="--i:0">Calendario de visitas · semana que viene</p>
						<div class="ifs-cal ifs-in" style="--i:1">
							{['Lun', 'Mar', 'Mié', 'Jue', 'Vie'].map((d) => <span class="ifs-cal-day">{d}</span>)}
							<span class="ifs-slot ifs-slot--new ifs-in" style="--i:3; grid-column:1; grid-row:2">
								<b>10:30</b> Visita · Javier García<small>Av. del Mar, Valencia</small>
							</span>
							<span class="ifs-slot" style="grid-column:2; grid-row:3"><b>12:00</b> Laura M.</span>
							<span class="ifs-slot" style="grid-column:4; grid-row:2"><b>17:00</b> Carlos R.</span>
							<span class="ifs-slot" style="grid-column:5; grid-row:3"><b>11:15</b> Ana L.</span>
						</div>
						<p class="ifs-auto ifs-in" style="--i:4"><span class="ifs-live"></span>Recordatorio por WhatsApp programado para el lunes a las 9:00</p>
					</div>
				</div>
			</div>
		</div>

		<dl data-reveal class="piece piece-d2 mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-800 lg:grid-cols-4">
			{
				datos.map((d) => (
					<div class="bg-zinc-950 px-5 py-5">
						<dt class="text-2xl font-semibold text-white">{d.valor}</dt>
						<dd class="mt-1 text-sm text-zinc-500">{d.texto}</dd>
					</div>
				))
			}
		</dl>

		<div data-reveal class="piece piece-d3 mt-8 flex flex-wrap items-center gap-3">
			<a
				href="/tarjeta/inmoflow"
				class="inline-flex items-center gap-1.5 rounded-full bg-emerald-400 px-5 py-3 text-sm font-semibold text-zinc-950 transition-transform hover:-translate-y-0.5"
			>
				Ver InmoFlow completo <span aria-hidden="true">→</span>
			</a>
			<WhatsAppCTA texto="Quiero una demo para mi inmobiliaria" mensaje="Hola, he visto InmoFlow en vuestra web y quiero una demo para mi inmobiliaria" />
		</div>
	</div>
</section>

<style>
	/* ============ Pasos (pestañas) ============ */
	.ifs-steps {
		display: grid;
		gap: 6px;
		align-content: start;
	}
	.ifs-step {
		position: relative;
		display: grid;
		grid-template-columns: 52px 1fr;
		gap: 14px;
		width: 100%;
		padding: 16px 16px 18px;
		border-radius: 16px;
		border: 1px solid transparent;
		text-align: left;
		cursor: pointer;
		overflow: hidden;
		transition:
			background-color 0.3s,
			border-color 0.3s;
	}
	.ifs-step:hover {
		background: rgba(255, 255, 255, 0.025);
	}
	.ifs-step[aria-selected='true'] {
		background: rgba(52, 211, 153, 0.06);
		border-color: rgba(52, 211, 153, 0.22);
	}
	.ifs-step:focus-visible {
		outline: 2px solid #34d399;
		outline-offset: 2px;
	}
	.ifs-step-time {
		font-variant-numeric: tabular-nums;
		font-size: 13px;
		font-weight: 700;
		color: #52525b;
		padding-top: 2px;
		transition: color 0.3s;
	}
	.ifs-step[aria-selected='true'] .ifs-step-time {
		color: #34d399;
	}
	.ifs-step-body {
		display: grid;
		gap: 4px;
	}
	.ifs-step-title {
		font-weight: 600;
		color: #a1a1aa;
		transition: color 0.3s;
	}
	.ifs-step[aria-selected='true'] .ifs-step-title {
		color: #fff;
	}
	.ifs-step-text {
		font-size: 14px;
		line-height: 1.45;
		color: #71717a;
		display: none;
	}
	.ifs-step[aria-selected='true'] .ifs-step-text {
		display: block;
	}
	/* barra de progreso del autoplay: solo transform (scaleX), nunca width */
	.ifs-step-bar {
		position: absolute;
		left: 16px;
		right: 16px;
		bottom: 8px;
		height: 2px;
		border-radius: 2px;
		background: #34d399;
		transform: scaleX(0);
		transform-origin: left;
		opacity: 0;
	}
	.ifs-step[aria-selected='true'] .ifs-step-bar {
		opacity: 1;
	}
	.ifs-stage.is-auto .ifs-step[aria-selected='true'] .ifs-step-bar {
		animation: ifs-progress 6s linear forwards;
	}
	.ifs-stage.is-paused .ifs-step-bar {
		animation-play-state: paused !important;
	}
	@keyframes ifs-progress {
		to {
			transform: scaleX(1);
		}
	}

	/* ============ Dispositivo: los colores claros propios de InmoFlow ============ */
	.ifs-device {
		position: relative;
		border-radius: 22px;
		background: #fbfbf8;
		color: #22313a;
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.06),
			0 30px 80px -20px rgba(52, 211, 153, 0.18),
			0 30px 60px rgba(0, 0, 0, 0.45);
		overflow: hidden;
		align-self: start;
	}
	.ifs-device-top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 11px 16px;
		background: #fff;
		border-bottom: 1px solid #e7ebe6;
		font-size: 12px;
	}
	.ifs-dots {
		display: flex;
		gap: 6px;
	}
	.ifs-dots i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #e2e6e2;
	}
	.ifs-app {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-weight: 800;
	}
	.ifs-logo {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border-radius: 6px;
		background: #526a5d;
		color: #fff;
		font-size: 12px;
	}
	.ifs-clock {
		justify-self: end;
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		color: #66727a;
	}
	.ifs-screens {
		display: grid;
		min-height: 360px;
		padding: 22px;
	}
	.ifs-screen {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.ifs-screen[hidden] {
		display: none;
	}
	/* entrada escalonada de cada pieza de la pantalla activa */
	.ifs-in {
		opacity: 0;
		transform: translateY(10px);
	}
	.ifs-screen.is-active .ifs-in {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.45s ease,
			transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--i, 0) * 0.35s + 0.1s);
	}

	.ifs-label {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #66727a;
	}
	.ifs-muted {
		font-size: 12px;
		color: #66727a;
	}
	.ifs-row-between {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		font-size: 14px;
	}
	.ifs-sources {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.ifs-sources span {
		padding: 5px 10px;
		border-radius: 999px;
		background: #eef2ed;
		color: #526a5d;
		font-size: 11px;
		font-weight: 700;
	}
	.ifs-card {
		display: flex;
		gap: 12px;
		padding: 14px;
		border-radius: 14px;
		background: #fff;
		border: 1px solid #e7ebe6;
	}
	.ifs-card--new {
		border-color: #b9d3c1;
		box-shadow: 0 10px 30px rgba(36, 52, 45, 0.1);
	}
	.ifs-card--old {
		opacity: 0.6;
	}
	.ifs-screen.is-active .ifs-card--old {
		opacity: 0.6;
	}
	.ifs-quote {
		margin-top: 8px;
		font-size: 13px;
		color: #22313a;
	}
	.ifs-av {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--av);
		color: #fff;
		font-size: 12px;
		font-weight: 800;
	}
	.ifs-badge {
		padding: 3px 9px;
		border-radius: 999px;
		background: #e7efe8;
		color: #5b7464;
		font-size: 11px;
		font-weight: 700;
		white-space: nowrap;
	}
	.ifs-badge--blue {
		background: #e8eef3;
		color: #637c90;
	}

	.ifs-chat {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 16px;
		border-radius: 16px;
		background: #eef2ed;
		flex: 1;
	}
	.ifs-bubble {
		max-width: 82%;
		padding: 10px 12px;
		border-radius: 14px;
		font-size: 13px;
		line-height: 1.45;
	}
	.ifs-bubble time {
		display: block;
		margin-top: 4px;
		font-size: 10px;
		color: #8a958f;
		text-align: right;
	}
	.ifs-bubble--them {
		align-self: flex-start;
		background: #fff;
		border-bottom-left-radius: 4px;
	}
	.ifs-bubble--us {
		align-self: flex-end;
		background: #d4e7d9;
		border-bottom-right-radius: 4px;
	}
	.ifs-auto {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		align-self: flex-start;
		padding: 6px 12px;
		border-radius: 999px;
		background: #fff;
		border: 1px solid #d6e4da;
		color: #2f7a53;
		font-size: 12px;
		font-weight: 700;
	}
	.ifs-live {
		position: relative;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #2f9e63;
	}
	.ifs-live::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: #2f9e63;
		animation: ifs-ping 2s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
	}
	@keyframes ifs-ping {
		from {
			transform: scale(1);
			opacity: 0.55;
		}
		to {
			transform: scale(3);
			opacity: 0;
		}
	}

	.ifs-split {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: 14px;
		flex: 1;
	}
	.ifs-chat--mini .ifs-bubble {
		max-width: 92%;
		font-size: 12px;
	}
	.ifs-file {
		padding: 16px;
		border-radius: 16px;
		background: #fff;
		border: 1px solid #e7ebe6;
		box-shadow: 0 10px 30px rgba(36, 52, 45, 0.08);
	}
	.ifs-file dl {
		display: grid;
		gap: 2px;
		margin-top: 12px;
	}
	.ifs-file dl div {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding: 9px 0;
		border-top: 1px solid #eef1ee;
		font-size: 13px;
	}
	.ifs-file dt {
		color: #66727a;
	}
	.ifs-file dd {
		font-weight: 700;
		text-align: right;
	}
	/* el estado cambia de "Nuevo" a "Interesado" cuando la ficha ya está completa */
	.ifs-stage-pill {
		display: grid;
		font-size: 11px;
		font-weight: 700;
	}
	.ifs-stage-pill span {
		grid-area: 1 / 1;
		padding: 3px 9px;
		border-radius: 999px;
		white-space: nowrap;
		text-align: center;
		transition: opacity 0.4s ease 2.2s;
	}
	.ifs-stage-from {
		background: #e8eef3;
		color: #637c90;
	}
	.ifs-stage-to {
		background: #e7efe8;
		color: #2f7a53;
		opacity: 0;
	}
	.ifs-screen.is-active .ifs-stage-from {
		opacity: 0;
	}
	.ifs-screen.is-active .ifs-stage-to {
		opacity: 1;
	}

	.ifs-cal {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		grid-template-rows: auto repeat(2, minmax(64px, auto));
		gap: 6px;
		padding: 12px;
		border-radius: 16px;
		background: #fff;
		border: 1px solid #e7ebe6;
	}
	.ifs-cal-day {
		grid-row: 1;
		font-size: 11px;
		font-weight: 700;
		color: #66727a;
		text-align: center;
		padding-bottom: 4px;
	}
	.ifs-slot {
		align-self: start;
		padding: 7px 8px;
		border-radius: 10px;
		background: #f1f4ee;
		font-size: 11px;
		line-height: 1.3;
		color: #66727a;
	}
	.ifs-slot b {
		display: block;
		color: #22313a;
	}
	.ifs-slot small {
		display: block;
		margin-top: 2px;
		font-size: 10px;
	}
	.ifs-slot--new {
		background: #526a5d;
		color: #dfe8e1;
		box-shadow: 0 8px 24px rgba(82, 106, 93, 0.35);
	}
	.ifs-slot--new b {
		color: #fff;
	}

	@media (max-width: 1023px) {
		/* en móvil/tablet los pasos se vuelven una fila de pestañas compacta; el
		   texto del paso activo va debajo, a todo el ancho */
		.ifs-steps {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 4px;
		}
		.ifs-step {
			grid-template-columns: 1fr;
			gap: 4px;
			padding: 10px 10px 14px;
			position: static;
		}
		.ifs-steps {
			position: relative;
			padding-bottom: 0;
		}
		.ifs-step-title {
			font-size: 12px;
			line-height: 1.25;
		}
		.ifs-step-text {
			display: none !important;
		}
		.ifs-step-bar {
			left: auto;
			right: auto;
			bottom: auto;
			position: relative;
			display: block;
			width: 100%;
			margin-top: 6px;
		}
	}
	@media (max-width: 639px) {
		.ifs-screens {
			padding: 16px;
			min-height: 380px;
		}
		.ifs-split {
			grid-template-columns: 1fr;
		}
		.ifs-chat--mini {
			flex: none;
		}
		.ifs-step-time {
			font-size: 11px;
		}
		.ifs-step-title {
			font-size: 11px;
		}
		.ifs-cal {
			padding: 8px;
			gap: 4px;
		}
		.ifs-slot {
			padding: 6px;
			font-size: 10px;
		}
		.ifs-slot small {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ifs-live::after {
			animation: none;
		}
		.ifs-in,
		.ifs-screen.is-active .ifs-in {
			opacity: 1;
			transform: none;
			transition: none;
		}
		.ifs-stage-pill span {
			transition: none;
		}
	}
</style>

<script>
	// Pestañas con autoplay: cada paso dura lo que su barra de progreso (6 s, en
	// CSS). Al acabar la animación de la barra se pasa al siguiente. Si la
	// persona hace clic en un paso, se queda en él (se para el autoplay). Fuera
	// de pantalla, la barra se pausa y con ella el avance.
	const stage = document.querySelector<HTMLElement>('.ifs-stage');
	if (stage) {
		const tabs = Array.from(stage.querySelectorAll<HTMLButtonElement>('.ifs-step'));
		const panels = Array.from(stage.querySelectorAll<HTMLElement>('.ifs-screen'));
		const clock = stage.querySelector<HTMLElement>('#ifsClock');
		const horas = ['Sáb 23:47', 'Sáb 23:47', 'Sáb 23:49', 'Sáb 23:52'];
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;

		const show = (i: number, focus = false) => {
			current = i;
			tabs.forEach((t, j) => {
				const on = j === i;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				// reinicia la animación de la barra
				const bar = t.querySelector<HTMLElement>('.ifs-step-bar');
				if (bar && on) {
					bar.style.animation = 'none';
					void bar.offsetWidth;
					bar.style.animation = '';
				}
			});
			panels.forEach((p, j) => {
				p.classList.remove('is-active');
				p.hidden = j !== i;
			});
			// un frame con la pantalla visible pero sin .is-active para que las
			// transiciones de entrada arranquen desde su estado inicial
			requestAnimationFrame(() => requestAnimationFrame(() => panels[i].classList.add('is-active')));
			if (clock) clock.textContent = horas[i];
			if (focus) tabs[i].focus();
		};

		tabs.forEach((t, i) => {
			t.addEventListener('click', () => {
				stage.classList.remove('is-auto');
				show(i);
			});
			t.addEventListener('keydown', (e) => {
				const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
				if (!dir) return;
				e.preventDefault();
				stage.classList.remove('is-auto');
				show((current + dir + tabs.length) % tabs.length, true);
			});
			t.querySelector('.ifs-step-bar')?.addEventListener('animationend', () => {
				if (stage.classList.contains('is-auto')) show((i + 1) % tabs.length);
			});
		});

		if (!reduceMotion) {
			stage.classList.add('is-auto', 'is-paused');
			new IntersectionObserver(
				(entries) => {
					for (const entry of entries) stage.classList.toggle('is-paused', !entry.isIntersecting);
				},
				{ threshold: 0.35 },
			).observe(stage);
		}
		show(0);
	}
</script>
