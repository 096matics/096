---
import WhatsAppCTA from '../WhatsAppCTA.astro';
import Ventana from './inmoflow/Ventana.astro';
import Pantalla from './inmoflow/Pantalla.astro';

// Presentación de producto de InmoFlow en la home. El eje es el recorrido de
// un lead, de que entra a que tiene visita, contado sobre la propia app: en
// escritorio la ventana se queda fija y cambia de pantalla según el paso que
// estás leyendo; en móvil cada paso lleva su pantalla debajo. Las funciones
// salen de /tarjeta/inmoflow; el lead y las horas son un ejemplo ilustrativo.
// A propósito no hay precios ni plazos de montaje: todo es modular y se
// presupuesta a medida.
const pasos = [
	{
		n: '01',
		kicker: 'Captación',
		titulo: 'Todos tus canales, una sola bandeja.',
		texto: 'Web, portales, WhatsApp, Instagram o Facebook: cada contacto entra en el mismo sitio, con su origen y su mensaje. Se acabó perseguir leads por cinco pestañas.',
		hora: '23:47',
	},
	{
		n: '02',
		kicker: 'Respuesta',
		titulo: 'Contesta en segundos. A cualquier hora.',
		texto: 'InmoFlow le escribe por WhatsApp desde tu propio número, con la API oficial, en cuanto el lead entra. El cliente no se enfría esperando al lunes.',
		hora: '23:47',
	},
	{
		n: '03',
		kicker: 'Cualificación',
		titulo: 'La ficha se rellena mientras conversa.',
		texto: 'Operación, presupuesto, zona: cada respuesta se guarda en su ficha y el cliente avanza solo por tu embudo de ventas. Sabes a quién llamar primero.',
		hora: '23:49',
	},
	{
		n: '04',
		kicker: 'Visita',
		titulo: 'Y la visita, ya en tu agenda.',
		texto: 'Se agenda con su recordatorio automático por WhatsApp. Tú solo llegas a enseñar el piso.',
		hora: '23:52',
	},
];

const integraciones = ['WhatsApp', 'Facebook', 'Instagram', 'Google', 'Meta', 'Stripe', 'Zapier'];
const modulos = [
	{ nombre: 'Captación de leads', on: true },
	{ nombre: 'CRM', on: true },
	{ nombre: 'WhatsApp automático', on: true },
	{ nombre: 'Agenda de visitas', on: false },
	{ nombre: 'Informes', on: false },
	{ nombre: 'Web de captación', on: false },
];
const barras = [
	{ canal: 'Web', h: 78 },
	{ canal: 'Portales', h: 100 },
	{ canal: 'WhatsApp', h: 64 },
	{ canal: 'Redes', h: 42 },
];
---

<section id="inmoflow" data-animate class="ifs border-b border-zinc-800 pt-24 pb-24 sm:pt-32 sm:pb-32">
	<div class="mx-auto max-w-6xl px-5 sm:px-6">
		<!-- ============ Presentación ============ -->
		<header class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_auto]">
			<div data-reveal class="piece piece-top piece-d0 max-w-3xl">
				<div class="flex items-center gap-3">
					<span class="ifs-mark" aria-hidden="true">
						<svg viewBox="0 0 32 32" width="22" height="22"><path d="M16 8l8 7h-2.5v8h-4v-5h-3v5h-4v-8H8z" fill="#fff"></path></svg>
					</span>
					<span class="text-lg font-semibold tracking-tight text-white">InmoFlow</span>
					<span class="rounded-full border border-emerald-400/30 px-2.5 py-0.5 text-[11px] font-semibold tracking-wide text-emerald-300">
						Para inmobiliarias
					</span>
				</div>
				<h2 class="ifs-title mt-7 text-4xl font-semibold text-white sm:text-6xl">
					Ningún lead<br class="hidden sm:block" /> sin respuesta.
				</h2>
				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-400 sm:text-xl">
					El sistema todo en uno que capta cada contacto, le contesta por WhatsApp al instante y te lo deja con la
					visita agendada. Mientras tú haces lo que de verdad vende: enseñar casas.
				</p>
			</div>
			<div data-reveal class="piece piece-d1 flex flex-wrap gap-3 lg:justify-end">
				<a href="/tarjeta/inmoflow#contacto" class="ifs-btn-primary">Solicitar demo gratuita</a>
				<a href="/tarjeta/inmoflow" class="ifs-btn-ghost">Ver producto <span aria-hidden="true">→</span></a>
			</div>
		</header>

		<!-- ============ Recorrido ============ -->
		<div class="ifs-tour mt-16 sm:mt-24">
			<ol class="ifs-steps">
				{
					pasos.map((p, i) => (
						<li class="ifs-step" data-step={i} data-active={i === 0 ? 'true' : 'false'}>
							<div class="ifs-step-copy">
								<p class="ifs-step-kicker">
									<span class="ifs-step-n">{p.n}</span>
									{p.kicker}
								</p>
								<h3 class="ifs-step-title">{p.titulo}</h3>
								<p class="ifs-step-text">{p.texto}</p>
							</div>
							<Ventana nav={i} hora={p.hora} class="ifs-step-device">
								<Pantalla paso={i as 0 | 1 | 2 | 3} />
							</Ventana>
						</li>
					))
				}
			</ol>

			<div class="ifs-sticky" aria-hidden="true">
				<div class="ifs-sticky-inner">
					<Ventana nav={0} hora={pasos[0].hora} class="ifs-main-device">
						<div class="ifs-stack">
							{pasos.map((_, i) => <Pantalla paso={i as 0 | 1 | 2 | 3} class={i === 0 ? 'is-active' : ''} />)}
						</div>
					</Ventana>
					<div class="ifs-progress">
						{pasos.map((p, i) => <span data-dot={i} class={i === 0 ? 'is-on' : ''}>{p.kicker}</span>)}
					</div>
				</div>
			</div>
		</div>

		<!-- ============ Todo lo demás ============ -->
		<div class="mt-24 sm:mt-32">
			<h3 data-reveal class="piece piece-d0 max-w-xl text-2xl font-semibold text-white sm:text-3xl">
				Y todo lo que tu inmobiliaria necesita alrededor.
			</h3>
			<div class="ifs-bento mt-8">
				<article data-reveal class="piece piece-d1 ifs-card ifs-card--wide">
					<div>
						<p class="ifs-card-kicker">Informes y métricas</p>
						<p class="ifs-card-title">Qué canal te trae clientes, en tiempo real.</p>
						<p class="ifs-card-text">Mide lo que importa y decide con datos, no con intuición.</p>
					</div>
					<div class="ifs-bars" aria-hidden="true">
						{
							barras.map((b, i) => (
								<span class="ifs-bar" style={`--h:${b.h}%; --d:${i * 0.12}s`}>
									<i />
									<small>{b.canal}</small>
								</span>
							))
						}
					</div>
				</article>

				<article data-reveal class="piece piece-d2 ifs-card">
					<p class="ifs-card-kicker">Con tu marca</p>
					<p class="ifs-card-title">Tu CRM, con tu logo y tus colores.</p>
					<div class="ifs-brand" aria-hidden="true">
						<span class="ifs-brand-logo">TI</span>
						<span>
							<b>Tu Inmobiliaria</b>
							<small>Panel de ventas</small>
						</span>
					</div>
				</article>

				<article data-reveal class="piece piece-d2 ifs-card">
					<p class="ifs-card-kicker">Integraciones</p>
					<p class="ifs-card-title">Se conecta con lo que ya usas.</p>
					<div class="ifs-logos">
						{integraciones.map((n) => <span>{n}</span>)}
					</div>
				</article>

				<article data-reveal class="piece piece-d3 ifs-card ifs-card--wide">
					<div>
						<p class="ifs-card-kicker">Modular</p>
						<p class="ifs-card-title">Monta solo las piezas que necesitas.</p>
						<p class="ifs-card-text">Empieza por una y añade las demás cuando quieras. Lo configuramos nosotros y formamos a tu equipo.</p>
					</div>
					<ul class="ifs-modules" aria-label="Módulos de InmoFlow">
						{
							modulos.map((m, i) => (
								<li class={m.on ? 'is-on' : ''} style={`--d:${i * 0.12}s`}>
									<span class="ifs-toggle" aria-hidden="true" />
									{m.nombre}
								</li>
							))
						}
					</ul>
				</article>
			</div>
		</div>

		<!-- ============ Cierre ============ -->
		<div data-reveal class="piece piece-d1 ifs-close mt-6">
			<div>
				<p class="text-sm font-semibold text-emerald-300">Sin packs cerrados · sin permanencia</p>
				<p class="mt-2 text-3xl font-semibold text-white sm:text-4xl">
					Todo es modular.<span class="text-zinc-500"> Te hacemos un presupuesto a tu medida.</span>
				</p>
				<p class="mt-3 text-sm text-zinc-400">Cuéntanos cómo trabajáis y te enseñamos una demo con vuestros propios casos.</p>
			</div>
			<div class="flex flex-wrap gap-3">
				<a href="/tarjeta/inmoflow#contacto" class="ifs-btn-primary">Solicitar demo gratuita</a>
				<WhatsAppCTA texto="Hablar por WhatsApp" mensaje="Hola, he visto InmoFlow en vuestra web y quiero una demo para mi inmobiliaria" />
			</div>
		</div>
	</div>
</section>

<style>
	/* ============ Presentación ============ */
	.ifs-mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: linear-gradient(145deg, #6d8677, #3f5448);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.12) inset,
			0 10px 30px rgba(82, 106, 93, 0.45);
	}
	.ifs-title {
		letter-spacing: -0.035em;
		line-height: 1;
	}
	.ifs-btn-primary,
	.ifs-btn-ghost {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 12px 20px;
		border-radius: 999px;
		font-size: 14px;
		font-weight: 600;
		transition:
			transform 0.2s,
			background-color 0.2s;
	}
	.ifs-btn-primary {
		background: #34d399;
		color: #06120c;
	}
	.ifs-btn-primary:hover {
		transform: translateY(-2px);
		background: #6ee7b7;
	}
	.ifs-btn-ghost {
		color: #e4e4e7;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
	}
	.ifs-btn-ghost:hover {
		background: rgba(255, 255, 255, 0.05);
	}

	/* ============ Recorrido ============ */
	.ifs-steps {
		display: grid;
		gap: 64px;
	}
	.ifs-step-kicker {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6ee7b7;
	}
	.ifs-step-n {
		font-variant-numeric: tabular-nums;
		color: #52525b;
	}
	.ifs-step-title {
		margin-top: 12px;
		font-size: 26px;
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #fff;
	}
	.ifs-step-text {
		margin-top: 12px;
		font-size: 16px;
		line-height: 1.6;
		color: #a1a1aa;
	}
	.ifs-step :global(.ifs-step-device) {
		margin-top: 24px;
	}
	.ifs-sticky {
		display: none;
	}

	@media (min-width: 1024px) {
		.ifs-tour {
			display: grid;
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 56px;
		}
		.ifs-steps {
			gap: 0;
			/* el primer y último paso necesitan aire para poder llegar al centro */
			padding: 8vh 0 24vh;
		}
		.ifs-step {
			display: flex;
			align-items: center;
			min-height: 72vh;
			padding-left: 28px;
			border-left: 1px solid #27272a;
			position: relative;
		}
		.ifs-step::before {
			content: '';
			position: absolute;
			left: -1px;
			top: 50%;
			width: 1px;
			height: 140px;
			margin-top: -70px;
			background: #34d399;
			transform: scaleY(0);
			transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.ifs-step[data-active='true']::before {
			transform: scaleY(1);
		}
		.ifs-step-copy {
			opacity: 0.3;
			transition: opacity 0.5s ease;
		}
		.ifs-step[data-active='true'] .ifs-step-copy {
			opacity: 1;
		}
		.ifs-step-title {
			font-size: 34px;
		}
		.ifs-step :global(.ifs-step-device) {
			display: none;
		}
		.ifs-sticky {
			display: block;
		}
		.ifs-sticky-inner {
			position: sticky;
			top: max(96px, calc(50vh - 290px));
		}
		.ifs-stack {
			display: grid;
			min-height: 420px;
		}
		.ifs-stack > :global(.ifp) {
			grid-area: 1 / 1;
			transition:
				opacity 0.35s ease,
				visibility 0s linear 0.35s;
		}
		.ifs-stack > :global(.ifp:not(.is-active)) {
			opacity: 0;
			visibility: hidden;
		}
		.ifs-stack > :global(.ifp.is-active) {
			transition-delay: 0s;
		}
		.ifs-progress {
			display: flex;
			justify-content: center;
			gap: 20px;
			margin-top: 22px;
			font-size: 12px;
			font-weight: 600;
			color: #52525b;
		}
		.ifs-progress span {
			position: relative;
			padding-top: 10px;
			transition: color 0.3s;
		}
		.ifs-progress span::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 2px;
			border-radius: 2px;
			background: #27272a;
		}
		.ifs-progress span.is-on {
			color: #e4e4e7;
		}
		.ifs-progress span.is-on::before {
			background: #34d399;
		}
	}

	/* ============ Bento ============ */
	.ifs-bento {
		display: grid;
		gap: 16px;
	}
	@media (min-width: 768px) {
		.ifs-bento {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.ifs-card--wide {
			grid-column: span 2;
		}
	}
	.ifs-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 24px;
		padding: 26px;
		border-radius: 22px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01));
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
	}
	@media (min-width: 768px) {
		.ifs-card--wide {
			flex-direction: row;
			align-items: flex-end;
		}
		.ifs-card--wide > div:first-child {
			max-width: 300px;
		}
	}
	.ifs-card-kicker {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6ee7b7;
	}
	.ifs-card-title {
		margin-top: 10px;
		font-size: 20px;
		line-height: 1.25;
		font-weight: 600;
		color: #fff;
	}
	.ifs-card-text {
		margin-top: 8px;
		font-size: 14px;
		line-height: 1.55;
		color: #a1a1aa;
	}
	.ifs-bars {
		display: flex;
		align-items: flex-end;
		gap: 14px;
		flex: 1;
		height: 150px;
		max-width: 360px;
	}
	.ifs-bar {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: center;
		gap: 8px;
		flex: 1;
		height: 100%;
	}
	.ifs-bar i {
		width: 100%;
		height: var(--h);
		border-radius: 10px 10px 4px 4px;
		background: linear-gradient(180deg, #6ee7b7, rgba(52, 211, 153, 0.25));
		transform: scaleY(0);
		transform-origin: bottom;
	}
	.is-revealing .ifs-bar i {
		transform: scaleY(1);
		transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) calc(0.6s + var(--d));
	}
	.ifs-bar small {
		font-size: 11px;
		color: #71717a;
	}
	.ifs-brand {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px;
		border-radius: 14px;
		background: #fbfbf8;
		color: #22313a;
	}
	.ifs-brand-logo {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: #1e3a8a;
		color: #fff;
		font-size: 13px;
		font-weight: 800;
		animation: ifs-brand 6s ease-in-out infinite;
	}
	@keyframes ifs-brand {
		0%,
		30% {
			background: #1e3a8a;
		}
		36%,
		63% {
			background: #b45309;
		}
		70%,
		100% {
			background: #526a5d;
		}
	}
	.ifs-brand b {
		display: block;
		font-size: 14px;
	}
	.ifs-brand small {
		font-size: 12px;
		color: #7b8680;
	}
	.ifs-logos {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.ifs-logos span {
		padding: 6px 12px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.05);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
		font-size: 13px;
		color: #d4d4d8;
	}
	.ifs-modules {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
		flex: 1;
		max-width: 440px;
	}
	.ifs-modules li {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 12px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.03);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
		font-size: 13px;
		color: #a1a1aa;
	}
	.ifs-toggle {
		position: relative;
		width: 28px;
		height: 16px;
		flex-shrink: 0;
		border-radius: 999px;
		background: #3f3f46;
		transition: background-color 0.35s ease;
	}
	.ifs-toggle::after {
		content: '';
		position: absolute;
		top: 2px;
		left: 2px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #fff;
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	/* los módulos activos se "encienden" uno tras otro al aparecer la tarjeta */
	.is-revealing .ifs-modules li.is-on {
		color: #fff;
		transition: color 0.35s ease calc(0.8s + var(--d));
	}
	.is-revealing .ifs-modules li.is-on .ifs-toggle {
		background: #34d399;
		transition-delay: calc(0.8s + var(--d));
	}
	.is-revealing .ifs-modules li.is-on .ifs-toggle::after {
		transform: translateX(12px);
		transition-delay: calc(0.8s + var(--d));
	}

	/* ============ Cierre ============ */
	.ifs-close {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		padding: 32px;
		border-radius: 22px;
		background:
			radial-gradient(ellipse 60% 120% at 0% 0%, rgba(52, 211, 153, 0.14), transparent 60%),
			rgba(255, 255, 255, 0.02);
		box-shadow: inset 0 0 0 1px rgba(52, 211, 153, 0.2);
	}
	@media (max-width: 639px) {
		.ifs-card,
		.ifs-close {
			padding: 22px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ifs-bar i {
			transform: none;
		}
		.ifs-brand-logo {
			animation: none;
		}
	}
</style>

<script>
	// Escritorio: el paso que cruza el centro de la pantalla manda — activa su
	// pantalla en la ventana fija, el menú lateral, el reloj y la barra de
	// progreso. Móvil: cada paso lleva su propia ventana y se activa (una sola
	// vez) cuando entra en pantalla.
	const root = document.querySelector<HTMLElement>('.ifs');
	if (root) {
		const steps = Array.from(root.querySelectorAll<HTMLElement>('.ifs-step'));
		const main = root.querySelector<HTMLElement>('.ifs-main-device');
		const screens = main ? Array.from(main.querySelectorAll<HTMLElement>('.ifp')) : [];
		const navItems = main ? Array.from(main.querySelectorAll<HTMLElement>('[data-nav]')) : [];
		const clock = main?.querySelector<HTMLElement>('[data-clock]');
		const dots = Array.from(root.querySelectorAll<HTMLElement>('.ifs-progress [data-dot]'));
		const horas = steps.map((s) => s.querySelector<HTMLElement>('[data-clock]')?.textContent ?? '');
		let current = 0;

		const activate = (i: number) => {
			if (i === current) return;
			current = i;
			steps.forEach((s, j) => (s.dataset.active = String(j === i)));
			navItems.forEach((n) => n.classList.toggle('is-current', Number(n.dataset.nav) === i));
			dots.forEach((d, j) => d.classList.toggle('is-on', j === i));
			if (clock) clock.textContent = horas[i];
			screens.forEach((s) => s.classList.remove('is-active'));
			// un frame en reposo para que las entradas vuelvan a arrancar desde cero
			requestAnimationFrame(() => requestAnimationFrame(() => screens[i]?.classList.add('is-active')));
		};

		const centerObserver = new IntersectionObserver(
			(entries) => {
				for (const e of entries) if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.step));
			},
			{ rootMargin: '-50% 0px -50% 0px' },
		);
		steps.forEach((s) => centerObserver.observe(s));

		// la ventana fija arranca en reposo y se enciende al llegar a ella
		if (main && screens[0]) {
			screens[0].classList.remove('is-active');
			const once = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting)) {
						screens[current]?.classList.add('is-active');
						once.disconnect();
					}
				},
				{ threshold: 0.4 },
			);
			once.observe(main);
		}

		const mobileScreens = Array.from(root.querySelectorAll<HTMLElement>('.ifs-step .ifp'));
		const mobileObserver = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					e.target.classList.add('is-active');
					mobileObserver.unobserve(e.target);
				}
			},
			{ threshold: 0.45 },
		);
		mobileScreens.forEach((s) => mobileObserver.observe(s));
	}
</script>
