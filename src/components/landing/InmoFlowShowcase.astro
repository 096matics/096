---
import WhatsAppCTA from '../WhatsAppCTA.astro';

// Segundo intento de esta sección: la primera versión (una tarjeta verde propia
// con un móvil inventado) no se parecía en nada al producto real y desentonaba
// con el resto de la página. Esta reutiliza tal cual la composición del hero de
// InmoFlow (panel de oportunidades + móvil de WhatsApp superpuesto, mismos
// datos de ejemplo, mismos textos de beneficios) para que se lea inequívocamente
// como "esto es InmoFlow", dentro de una tarjeta con el mismo lenguaje visual
// que el resto de 096matics (border-zinc-800/bg-zinc-900, como las de "El
// mecanismo"). La mejora sobre el original: el panel y el móvil ya no son dos
// bucles independientes — cuentan la MISMA historia (entra Javier por WhatsApp,
// se le responde, y su fila en el panel cambia de "Lead nuevo" a "Contactando"
// en el momento exacto en que se le contesta), con un timeline en @keyframes
// puro para que quede fiable (ver Mecanismo.astro para el porqué de esa
// elección).
const leads = [
	{ nombre: 'Laura Martínez', meta: 'Valencia · 180.000 €', estado: 'Interesado', cls: '' },
	{ nombre: 'Carlos Ruiz', meta: 'Paterna · 250.000 €', estado: 'Contactando', cls: 'yellow' },
	{ nombre: 'Ana López', meta: 'Torrent · 320.000 €', estado: 'Interesado', cls: '' },
];
const beneficios = [
	{ titulo: 'Respuesta inmediata', texto: 'a cualquier hora, aunque nadie esté mirando el móvil' },
	{ titulo: 'Nada se pierde', texto: 'cada conversación queda ordenada, sola, sin hojas de cálculo' },
	{ titulo: 'Seguimiento automático', texto: '24 horas, 7 días, sin que se le olvide a nadie' },
];
// pequeño narrador sincronizado con el timeline de 9000ms de más abajo — sin
// esto, la animación se ve bien pero no queda claro QUÉ está pasando en cada
// momento ni por qué importa; con esto, cada fase del chat se explica sola.
const relato = [
	'Un cliente escribe por WhatsApp',
	'InmoFlow responde al instante',
	'Sigue la conversación sin que nadie la toque',
	'El lead queda organizado solo',
];
---

<section data-animate class="border-b border-zinc-800 py-16 sm:py-20">
	<div class="mx-auto max-w-6xl px-5 sm:px-6">
		<div data-reveal class="piece piece-top piece-d0 mx-auto max-w-2xl text-center">
			<span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/40 bg-emerald-400/10 px-2.5 py-1 text-[10px] font-bold tracking-widest text-emerald-400 uppercase">
				<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
				InmoFlow · Otro proyecto nuestro
			</span>
			<h3 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">Un lead entra. InmoFlow ya le ha respondido.</h3>
			<p class="mt-3 text-zinc-400">
				Cada minuto sin respuesta es una venta que se enfría. InmoFlow contesta a cada cliente al instante, sea la
				hora que sea, sigue la conversación por su cuenta y avisa al equipo solo cuando de verdad hace falta que
				alguien entre — para que ningún lead se pierda por no llegar a tiempo.
			</p>
		</div>

		<div data-reveal class="piece piece-d1 if-stage relative mt-10 overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/40 p-6 sm:p-10">
			<div class="if-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

			<p class="if-caption relative mx-auto mb-6 max-w-xs text-center text-sm font-semibold text-emerald-300 sm:max-w-none" aria-hidden="true">
				{relato.map((linea, i) => (
					<span class={`if-caption-step if-caption-${i + 1}`}>{linea}</span>
				))}
			</p>

			<div class="if-visual relative mx-auto" aria-hidden="true">
				<div class="if-dashboard absolute top-0 left-0">
					<div class="if-dash-top">
						<div class="if-dash-title"><span class="if-live-dot"></span>Oportunidades</div>
						<div class="if-dash-tabs">
							<span class="if-pill if-pill-live"><span class="if-live-dot if-live-dot--sm"></span>Lead nuevo · 19</span>
							<span class="if-pill">Contactando · 12</span>
							<span class="if-pill">Interesado · 9</span>
						</div>
					</div>
					<div class="if-dash-table">
						<div class="if-lead-row if-lead-row-javier">
							<div class="if-avatar" style="--av:#9b7f8b">JG</div>
							<div class="if-lead-info">
								<div class="if-lead-name">Javier García</div>
								<div class="if-lead-meta">Valencia · 310.000 €</div>
							</div>
							<span class="if-status if-status-new">Lead nuevo</span>
							<span class="if-status if-status-contacting">Contactando</span>
						</div>
						{
							leads.map((l) => (
								<div class="if-lead-row">
									<div class="if-avatar" style={`--av:${l.cls === 'yellow' ? '#a08f74' : '#7d9c88'}`}>
										{l.nombre
											.split(' ')
											.map((w) => w[0])
											.join('')}
									</div>
									<div class="if-lead-info">
										<div class="if-lead-name">{l.nombre}</div>
										<div class="if-lead-meta">{l.meta}</div>
									</div>
									<span class={`if-status ${l.cls}`}>{l.estado}</span>
								</div>
							))
						}
					</div>
				</div>

				<div class="if-phone">
					<div class="if-phone-screen">
						<div class="if-phone-head"><span class="if-live-dot"></span>Javier García</div>
						<div class="if-chat">
							<div class="if-bubble in if-msg-1">¿Sigue disponible el piso de la Av. del Mar? ¿Es de compra o alquiler?</div>
							<div class="if-bubble out if-msg-2">Comprar</div>
							<div class="if-bubble in if-typing" aria-hidden="true"><span></span><span></span><span></span></div>
							<div class="if-bubble in if-msg-3">Perfecto, ¿cuál es tu presupuesto?</div>
							<div class="if-bubble out if-msg-4">Hasta 320.000 €</div>
						</div>
						<div class="if-chat-input">Escribe un mensaje…</div>
					</div>
				</div>
			</div>

			<div class="relative mt-8 grid gap-5 border-t border-zinc-800 pt-6 sm:grid-cols-3">
				{
					beneficios.map((b) => (
						<div class="flex items-start gap-2.5">
							<span class="mt-0.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
							<p class="text-sm text-zinc-300">
								<strong class="font-semibold text-white">{b.titulo}</strong> <span class="text-zinc-500">{b.texto}</span>
							</p>
						</div>
					))
				}
			</div>

			<div class="relative mt-7 flex flex-wrap items-center gap-3">
				<a
					href="/tarjeta/inmoflow"
					class="inline-flex items-center gap-1.5 rounded-full bg-emerald-400 px-4 py-2 text-sm font-semibold text-zinc-950 transition-transform hover:-translate-y-0.5"
				>
					Ver InmoFlow completo
					<span aria-hidden="true">→</span>
				</a>
				<WhatsAppCTA texto="Quiero algo así para mi negocio" mensaje="Hola, he visto InmoFlow y quiero algo parecido para mi negocio" />
			</div>
		</div>
	</div>
</section>

<style>
	.if-glow {
		background:
			radial-gradient(ellipse 60% 70% at 12% 10%, rgba(52, 211, 153, 0.12), transparent 60%),
			radial-gradient(ellipse 50% 55% at 92% 90%, rgba(52, 211, 153, 0.08), transparent 60%);
	}

	/* las ~8 animaciones infinitas de esta tarjeta (puntos en vivo, mensajes,
	   estados, el flotar del móvil...) antes corrían sin parar desde que
	   cargaba la página, seguiera el usuario mirando la sección o llevara rato
	   desplazado a otra parte — eso es trabajo de más para el hilo principal en
	   todo momento, y es la otra mitad del lag que se notaba en la página. Se
	   pausan del todo mientras la tarjeta no está en pantalla (ver el script al
	   final) y solo corren mientras de verdad se están viendo. */
	.if-stage {
		--if-play: paused;
	}
	.if-stage.if-playing {
		--if-play: running;
	}

	/* narrador: 4 frases que se van turnando encima de la animación, cada una
	   en el instante exacto de la historia a la que se refiere (mismos puntos
	   del timeline de 9000ms que los mensajes/el cambio de estado más abajo) —
	   así queda claro qué está pasando y por qué importa, no solo que "algo se
	   mueve". Apiladas unas sobre otras (posición absoluta) para que ninguna
	   empuje a las demás mientras se cruzan. */
	.if-caption {
		position: relative;
		height: 1.25em;
	}
	.if-caption-step {
		position: absolute;
		inset: 0;
		opacity: 0;
	}
	.if-caption-1 {
		animation: if-caption-1-cycle 9000ms linear infinite;
		animation-play-state: var(--if-play);
	}
	.if-caption-2 {
		animation: if-caption-2-cycle 9000ms linear infinite;
		animation-play-state: var(--if-play);
	}
	.if-caption-3 {
		animation: if-caption-3-cycle 9000ms linear infinite;
		animation-play-state: var(--if-play);
	}
	.if-caption-4 {
		animation: if-caption-4-cycle 9000ms linear infinite;
		animation-play-state: var(--if-play);
	}
	@keyframes if-caption-1-cycle {
		0%,
		12% {
			opacity: 1;
		}
		14% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}
	@keyframes if-caption-2-cycle {
		0%,
		13% {
			opacity: 0;
		}
		15% {
			opacity: 1;
		}
		38% {
			opacity: 1;
		}
		40% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}
	@keyframes if-caption-3-cycle {
		0%,
		39% {
			opacity: 0;
		}
		41% {
			opacity: 1;
		}
		56% {
			opacity: 1;
		}
		58% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}
	@keyframes if-caption-4-cycle {
		0%,
		57% {
			opacity: 0;
		}
		59% {
			opacity: 1;
		}
		100% {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.if-caption-step {
			animation: none !important;
		}
		.if-caption-4 {
			opacity: 1;
		}
	}

	/* ============ Panel + móvil: la misma composición del hero real de InmoFlow
	   (panel arriba-izquierda, móvil superpuesto abajo-derecha), con sus colores
	   propios (claros) en vez de adaptarlos al tema oscuro — así se lee sin dudas
	   como una captura del producto real, no como una reinterpretación. ============ */
	.if-visual {
		min-height: 360px;
		max-width: 460px;
	}
	.if-dashboard {
		right: 78px;
		background: #fff;
		border: 1px solid #dfe5df;
		border-radius: 18px;
		box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
		padding: 16px;
	}
	.if-dash-top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 14px;
	}
	.if-dash-title {
		display: flex;
		align-items: center;
		gap: 7px;
		font-weight: 800;
		font-size: 13px;
		color: #22313a;
	}
	/* el punto "en vivo" y su anillo van en capas separadas a propósito: animar
	   box-shadow (como hacía la versión anterior) obliga a repintar el píxel
	   entero en cada frame — con 3 puntos de estos corriendo a la vez de forma
	   infinita, ese repintado constante era buena parte del lag que se notaba
	   al bajar por la página. Un ::after que solo anima transform+opacity lo
	   resuelve el compositor solo, sin tocar el hilo principal. */
	.if-live-dot {
		position: relative;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #2f9e63;
		flex-shrink: 0;
	}
	.if-live-dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: #2f9e63;
		animation: if-ping 2.2s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
		animation-play-state: var(--if-play);
	}
	@keyframes if-ping {
		0% {
			transform: scale(1);
			opacity: 0.55;
		}
		100% {
			transform: scale(3.2);
			opacity: 0;
		}
	}
	.if-dash-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.if-pill {
		padding: 5px 8px;
		border-radius: 999px;
		background: #eef2ed;
		color: #526a5d;
		font-weight: 700;
		font-size: 9px;
	}
	.if-pill-live {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}
	.if-live-dot--sm {
		width: 4px;
		height: 4px;
	}
	.if-dash-table {
		display: grid;
		gap: 8px;
	}
	.if-lead-row {
		position: relative;
		display: grid;
		grid-template-columns: 30px 1fr auto;
		gap: 10px;
		align-items: center;
		padding: 8px;
		border: 1px solid #edf0ed;
		border-radius: 12px;
		background: #fff;
	}
	.if-lead-row-javier {
		z-index: 1;
	}
	/* antes esto animaba background-color/border-color directamente sobre la fila
	   — repinta esa zona en cada frame del cruce. Una capa aparte que solo cambia
	   de opacidad hace el mismo efecto visual (fondo+borde verdes aparecen y se
	   van) pero el compositor la resuelve sin repintar nada debajo. */
	.if-lead-row-javier::before {
		content: '';
		position: absolute;
		inset: -1px;
		border-radius: 12px;
		background: #eaf5ee;
		border: 1px solid #bfe0cc;
		opacity: 0;
		pointer-events: none;
	}
	@keyframes if-row-highlight {
		0%,
		56% {
			opacity: 0;
		}
		58%,
		64% {
			opacity: 1;
		}
		66%,
		100% {
			opacity: 0;
		}
	}
	.if-lead-row-javier::before {
		animation: if-row-highlight 9000ms linear infinite;
		animation-play-state: var(--if-play);
	}
	.if-avatar {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 9px;
		font-weight: 800;
		color: #fff;
		background: var(--av, #93a89a);
		flex-shrink: 0;
	}
	.if-lead-info {
		min-width: 0;
	}
	.if-lead-name {
		font-size: 11px;
		font-weight: 700;
		color: #22313a;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.if-lead-meta {
		font-size: 9px;
		color: #66727a;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.if-status {
		font-size: 9px;
		font-weight: 700;
		padding: 4px 7px;
		border-radius: 999px;
		background: #e7efe8;
		color: #5b7464;
		white-space: nowrap;
	}
	.if-status.yellow {
		background: #f4ede0;
		color: #9b7745;
	}
	.if-status-new,
	.if-status-contacting {
		position: absolute;
		right: 8px;
		top: 50%;
		transform: translateY(-50%);
		background: #e8eef3;
		color: #637c90;
	}
	.if-status-contacting {
		background: #f4ede0;
		color: #9b7745;
	}
	@keyframes if-status-new-cycle {
		0%,
		58% {
			opacity: 1;
		}
		60%,
		100% {
			opacity: 0;
		}
	}
	@keyframes if-status-contacting-cycle {
		0%,
		58% {
			opacity: 0;
		}
		61%,
		100% {
			opacity: 1;
		}
	}
	.if-status-new {
		animation: if-status-new-cycle 9000ms linear infinite;
		animation-play-state: var(--if-play);
	}
	.if-status-contacting {
		animation: if-status-contacting-cycle 9000ms linear infinite;
		animation-play-state: var(--if-play);
	}

	.if-phone {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 168px;
		background: #111;
		border: 5px solid #111;
		border-radius: 26px;
		padding: 7px;
		z-index: 2;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
		animation: if-phone-float 6.5s ease-in-out infinite;
		animation-play-state: var(--if-play);
	}
	@keyframes if-phone-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-7px);
		}
	}
	.if-phone-screen {
		background: #f7f8f6;
		border-radius: 20px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}
	.if-phone-head {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 10px;
		border-bottom: 1px solid #e7ebe6;
		background: #fff;
		font-size: 9px;
		font-weight: 800;
		color: #22313a;
	}
	.if-chat {
		position: relative;
		padding: 9px;
		height: 232px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		overflow: hidden;
	}
	.if-bubble {
		max-width: 88%;
		padding: 7px 8px;
		border-radius: 11px;
		font-size: 9px;
		line-height: 1.35;
		margin-bottom: 7px;
		color: #22313a;
		opacity: 0;
		transform: translateY(6px) scale(0.97);
	}
	.if-bubble.in {
		background: #fff;
		border: 1px solid #e5e9e5;
	}
	.if-bubble.out {
		margin-left: auto;
		background: #dce9df;
	}
	.if-msg-1 {
		opacity: 1;
		transform: none;
	}
	@keyframes if-bubble-in {
		0%,
		2.5% {
			opacity: 0;
			transform: translateY(6px) scale(0.97);
		}
		6%,
		100% {
			opacity: 1;
			transform: none;
		}
	}
	.if-msg-2 {
		animation: if-bubble-in 9000ms ease-out infinite;
		animation-delay: 1260ms;
		animation-play-state: var(--if-play);
	}
	.if-msg-3 {
		animation: if-bubble-in 9000ms ease-out infinite;
		animation-delay: 3600ms;
		animation-play-state: var(--if-play);
	}
	.if-msg-4 {
		animation: if-bubble-in 9000ms ease-out infinite;
		animation-delay: 5220ms;
		animation-play-state: var(--if-play);
	}
	.if-typing {
		display: flex;
		gap: 3px;
		align-items: center;
		padding: 9px 10px;
	}
	@keyframes if-typing-cycle {
		0%,
		28% {
			opacity: 0;
		}
		30.5%,
		39% {
			opacity: 1;
		}
		41%,
		100% {
			opacity: 0;
		}
	}
	.if-typing {
		animation: if-typing-cycle 9000ms ease-out infinite;
		animation-play-state: var(--if-play);
	}
	.if-typing span {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #9db1a3;
		animation: if-blink 1.2s infinite;
		animation-play-state: var(--if-play);
	}
	.if-typing span:nth-child(2) {
		animation-delay: 0.2s;
	}
	.if-typing span:nth-child(3) {
		animation-delay: 0.4s;
	}
	@keyframes if-blink {
		0%,
		80%,
		100% {
			opacity: 0.25;
			transform: translateY(0);
		}
		40% {
			opacity: 1;
			transform: translateY(-2px);
		}
	}
	.if-chat-input {
		padding: 8px 10px;
		border-top: 1px solid #e7ebe6;
		background: #fff;
		font-size: 8px;
		color: #9aa19d;
	}

	@media (max-width: 639px) {
		/* en desktop el móvil se superpone a la esquina del panel (como en el hero
		   real de InmoFlow), pero en una columna tan estrecha eso tapaba 2 filas
		   de leads enteras. En móvil, mejor uno debajo del otro, sin solapar nada. */
		.if-visual {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 28px;
			min-height: 0;
			max-width: 280px;
		}
		.if-dashboard {
			position: static;
			width: 100%;
		}
		.if-phone {
			position: static;
			margin: 0 auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.if-live-dot::after,
		.if-lead-row-javier::before,
		.if-status-new,
		.if-status-contacting,
		.if-phone,
		.if-bubble,
		.if-typing,
		.if-typing span {
			animation: none !important;
		}
		.if-status-new {
			opacity: 0;
		}
		.if-status-contacting {
			opacity: 1;
		}
		.if-bubble {
			opacity: 1;
			transform: none;
		}
		.if-typing {
			opacity: 0;
			display: none;
		}
	}
</style>

<script>
	// las animaciones de esta tarjeta solo corren mientras está realmente en
	// pantalla — .if-playing (ver el CSS de arriba, controla --if-play) se
	// activa/desactiva en cada entrada/salida del viewport, así el hilo
	// principal no tiene que mantener ~8 animaciones infinitas corriendo
	// mientras el usuario está leyendo otra sección de la página.
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const stage = document.querySelector<HTMLElement>('.if-stage');

	if (stage && !reduceMotion) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					entry.target.classList.toggle('if-playing', entry.isIntersecting);
				}
			},
			{ threshold: 0.15 }
		);
		observer.observe(stage);
	}
</script>
