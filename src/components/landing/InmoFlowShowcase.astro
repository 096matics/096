---
import WhatsAppCTA from '../WhatsAppCTA.astro';

// Tercer intento de esta sección. Las dos versiones anteriores construían su
// propia coreografía en @keyframes puro — vistosa, pero inventada por
// nosotros, no lo que InmoFlow hace de verdad. Esta reutiliza literalmente
// el mecanismo de animación del propio hero real de InmoFlow (el mismo
// archivo en Desktop/Inmoflow/Index.html): un chat de WhatsApp que se
// escribe solo mensaje a mensaje con su indicador de "escribiendo…", y un
// panel de leads en el que van entrando filas nuevas en directo (con FLIP,
// para que el resto de filas se acomoden con un pequeño desplazamiento en
// vez de saltar). Ni el texto ni las cifras se inventan: el copy y los
// beneficios son los mismos tres que usa la propia InmoFlow en su hero real,
// solo sin la palabra "CRM" (esa ya se explica en /tarjeta/inmoflow).
const beneficios = [
	{ titulo: 'Respuesta inmediata', texto: 'a cada nuevo lead' },
	{ titulo: 'Seguimiento automático', texto: '24 horas, 7 días' },
	{ titulo: 'Más visitas, más ventas', texto: 'con menos gestión' },
];
const leadsIniciales = [
	{ ini: 'JG', nombre: 'Javier García', meta: 'Valencia · 310.000 €', estado: 'Lead nuevo', cls: 'blue', av: '#9b7f8b' },
	{ ini: 'LM', nombre: 'Laura Martínez', meta: 'Valencia · 180.000 €', estado: 'Interesado', cls: '', av: '#7d9c88' },
	{ ini: 'CR', nombre: 'Carlos Ruiz', meta: 'Paterna · 250.000 €', estado: 'Contactando', cls: 'yellow', av: '#a08f74' },
	{ ini: 'AL', nombre: 'Ana López', meta: 'Torrent · 320.000 €', estado: 'Interesado', cls: '', av: '#74889b' },
];
---

<section data-animate class="border-b border-zinc-800 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl px-5 sm:px-6">
		<div data-reveal class="piece piece-top piece-d0 mx-auto max-w-2xl text-center">
			<p class="text-sm font-bold tracking-widest text-emerald-400 uppercase">Caso real · InmoFlow</p>
			<h2 class="mt-2 text-3xl font-semibold text-white sm:text-4xl">Un lead entra. InmoFlow ya le ha respondido.</h2>
			<p class="mt-3 text-lg text-zinc-400">
				InmoFlow es el sistema todo en uno para inmobiliarias: capta leads desde tu web, WhatsApp y portales, y
				responde automáticamente para que ningún cliente se quede esperando.
			</p>
		</div>

		<div data-reveal class="piece piece-d1 if-stage relative mt-14 overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/40 p-6 sm:p-10">
			<div class="if-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

			<div class="if-visual relative mx-auto" aria-hidden="true">
				<div class="if-dashboard absolute top-0 left-0">
					<div class="if-dash-top">
						<div class="if-dash-title"><span class="if-live-dot"></span>Oportunidades</div>
						<div class="if-dash-tabs">
							<span class="if-pill if-pill-live" id="ifLeadPill"><span class="if-live-dot if-live-dot--sm"></span>Lead nuevo · 19</span>
							<span class="if-pill">Contactando · 12</span>
							<span class="if-pill">Interesado · 9</span>
						</div>
					</div>
					<div class="if-dash-table" id="ifLeadTable">
						{
							leadsIniciales.map((l) => (
								<div class="if-lead-row">
									<div class="if-avatar" style={`--av:${l.av}`}>{l.ini}</div>
									<div class="if-lead-info">
										<div class="if-lead-name">{l.nombre}</div>
										<div class="if-lead-meta">{l.meta}</div>
									</div>
									<span class={`if-status ${l.cls}`}>{l.estado}</span>
								</div>
							))
						}
					</div>
				</div>

				<div class="if-phone">
					<div class="if-phone-screen">
						<div class="if-phone-head"><span class="if-live-dot"></span>Javier García</div>
						<div class="if-chat" id="ifChat">
							<div class="if-bubble in">¿Sigue disponible el piso de la Av. del Mar? ¿Es de compra o alquiler?</div>
							<div class="if-bubble out">Comprar</div>
							<div class="if-bubble in">Perfecto. ¿Cuál es tu presupuesto aproximado?</div>
							<div class="if-bubble out">Hasta 320.000 €</div>
						</div>
						<div class="if-chat-input">Escribe un mensaje…</div>
					</div>
				</div>
			</div>

			<div class="relative mt-8 grid gap-5 border-t border-zinc-800 pt-6 sm:grid-cols-3">
				{
					beneficios.map((b) => (
						<div class="flex items-start gap-2.5">
							<span class="mt-0.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
							<p class="text-sm text-zinc-300">
								<strong class="font-semibold text-white">{b.titulo}</strong> <span class="text-zinc-500">{b.texto}</span>
							</p>
						</div>
					))
				}
			</div>

			<div class="relative mt-7 flex flex-wrap items-center gap-3">
				<a
					href="/tarjeta/inmoflow"
					class="inline-flex items-center gap-1.5 rounded-full bg-emerald-400 px-4 py-2 text-sm font-semibold text-zinc-950 transition-transform hover:-translate-y-0.5"
				>
					Ver InmoFlow completo
					<span aria-hidden="true">→</span>
				</a>
				<WhatsAppCTA texto="Quiero algo así para mi negocio" mensaje="Hola, he visto InmoFlow y quiero algo parecido para mi negocio" />
			</div>
		</div>
	</div>
</section>

<style>
	.if-glow {
		background:
			radial-gradient(ellipse 60% 70% at 12% 10%, rgba(52, 211, 153, 0.12), transparent 60%),
			radial-gradient(ellipse 50% 55% at 92% 90%, rgba(52, 211, 153, 0.08), transparent 60%);
	}

	/* ============ Panel + móvil: la misma composición del hero real de InmoFlow
	   (panel arriba-izquierda, móvil superpuesto abajo-derecha), con sus colores
	   propios (claros) en vez de adaptarlos al tema oscuro. ============ */
	.if-visual {
		min-height: 360px;
		max-width: 460px;
	}
	.if-dashboard {
		right: 78px;
		background: #fff;
		border: 1px solid #dfe5df;
		border-radius: 18px;
		box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
		padding: 16px;
	}
	.if-dash-top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 14px;
	}
	.if-dash-title {
		display: flex;
		align-items: center;
		gap: 7px;
		font-weight: 800;
		font-size: 13px;
		color: #22313a;
	}
	/* el punto "en vivo" anima solo transform+opacity en una capa aparte (::after)
	   — nunca box-shadow, que obligaría a repintar en cada frame. */
	.if-live-dot {
		position: relative;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #2f9e63;
		flex-shrink: 0;
	}
	.if-live-dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: #2f9e63;
		animation: if-ping 2.2s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
	}
	@keyframes if-ping {
		0% {
			transform: scale(1);
			opacity: 0.55;
		}
		100% {
			transform: scale(3.2);
			opacity: 0;
		}
	}
	.if-dash-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.if-pill {
		padding: 5px 8px;
		border-radius: 999px;
		background: #eef2ed;
		color: #526a5d;
		font-weight: 700;
		font-size: 9px;
	}
	.if-pill-live {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}
	.if-live-dot--sm {
		width: 4px;
		height: 4px;
	}
	.if-dash-table {
		display: grid;
		gap: 8px;
	}
	.if-lead-row {
		position: relative;
		display: grid;
		grid-template-columns: 30px 1fr auto;
		gap: 10px;
		align-items: center;
		padding: 8px;
		border: 1px solid #edf0ed;
		border-radius: 12px;
		background: #fff;
	}
	/* la fila que acaba de entrar por JS empieza así (ver el script) y se anima
	   hasta su estado normal — mismo patrón que usa el hero real de InmoFlow. */
	.if-lead-row.if-lead-new {
		opacity: 0;
		transform: translateY(-14px) scale(0.97);
	}
	.if-lead-row.if-lead-new.if-lead-show {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.5s ease,
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.if-avatar {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 9px;
		font-weight: 800;
		color: #fff;
		background: var(--av, #93a89a);
		flex-shrink: 0;
	}
	.if-lead-info {
		min-width: 0;
	}
	.if-lead-name {
		font-size: 11px;
		font-weight: 700;
		color: #22313a;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.if-lead-meta {
		font-size: 9px;
		color: #66727a;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.if-status {
		font-size: 9px;
		font-weight: 700;
		padding: 4px 7px;
		border-radius: 999px;
		background: #e7efe8;
		color: #5b7464;
		white-space: nowrap;
	}
	.if-status.yellow {
		background: #f4ede0;
		color: #9b7745;
	}
	.if-status.blue {
		background: #e8eef3;
		color: #637c90;
	}

	.if-phone {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 168px;
		background: #111;
		border: 5px solid #111;
		border-radius: 26px;
		padding: 7px;
		z-index: 2;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
		animation: if-phone-float 6.5s ease-in-out infinite;
	}
	@keyframes if-phone-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-7px);
		}
	}
	.if-phone-screen {
		background: #f7f8f6;
		border-radius: 20px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}
	.if-phone-head {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 10px;
		border-bottom: 1px solid #e7ebe6;
		background: #fff;
		font-size: 9px;
		font-weight: 800;
		color: #22313a;
	}
	.if-chat {
		position: relative;
		padding: 9px;
		height: 232px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		overflow: hidden;
	}
	.if-bubble {
		max-width: 88%;
		padding: 7px 8px;
		border-radius: 11px;
		font-size: 9px;
		line-height: 1.35;
		margin-bottom: 7px;
		color: #22313a;
	}
	.if-bubble.in {
		background: #fff;
		border: 1px solid #e5e9e5;
	}
	.if-bubble.out {
		margin-left: auto;
		background: #dce9df;
	}
	.if-bubble.if-typing-msg {
		display: flex;
		gap: 3px;
		align-items: center;
		padding: 9px 10px;
	}
	.if-bubble.if-typing-msg span {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #9db1a3;
		animation: if-blink 1.2s infinite;
	}
	.if-bubble.if-typing-msg span:nth-child(2) {
		animation-delay: 0.2s;
	}
	.if-bubble.if-typing-msg span:nth-child(3) {
		animation-delay: 0.4s;
	}
	@keyframes if-blink {
		0%,
		80%,
		100% {
			opacity: 0.25;
			transform: translateY(0);
		}
		40% {
			opacity: 1;
			transform: translateY(-2px);
		}
	}
	.if-chat-input {
		padding: 8px 10px;
		border-top: 1px solid #e7ebe6;
		background: #fff;
		font-size: 8px;
		color: #9aa19d;
	}

	@media (max-width: 639px) {
		/* el panel de leads es un añadido de esta tarjeta (no está en el hero real
		   a este ancho tampoco: InmoFlow lo oculta por debajo de 701px y deja solo
		   el móvil) — mismo criterio aquí, así en pantallas estrechas no compite
		   con el móvil por el espacio. */
		.if-dashboard {
			display: none;
		}
		.if-visual {
			display: flex;
			justify-content: center;
			min-height: 0;
			max-width: 280px;
		}
		.if-phone {
			position: static;
			margin: 0 auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.if-live-dot::after,
		.if-phone {
			animation: none !important;
		}
	}
</style>

<script>
	// Mismo mecanismo que el hero real de InmoFlow (Desktop/Inmoflow/Index.html):
	// un chat que se reescribe solo, mensaje a mensaje, con su indicador de
	// "escribiendo…", y un panel en el que van entrando leads nuevos en directo
	// (con FLIP: se mide la posición de las filas antes y después de insertar la
	// nueva, y se anima la diferencia, para que no salten de golpe). Ambos bucles
	// se pausan del todo mientras la tarjeta no está en pantalla, para no gastar
	// hilo principal en algo que nadie está mirando.
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const stage = document.querySelector<HTMLElement>('.if-stage');
	if (!stage || reduceMotion) {
		// nothing to animate
	} else {
		let playing = false;
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) playing = entry.isIntersecting;
		}, { threshold: 0.15 });
		observer.observe(stage);

		const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
		const waitUntilPlaying = async () => {
			while (!playing) await sleep(300);
		};

		/* ---------- Chat de WhatsApp: misma conversación que la real ---------- */
		const chat = stage.querySelector<HTMLElement>('#ifChat');
		if (chat) {
			const conversation = [
				{ dir: 'in', text: '¿Sigue disponible el piso de la Av. del Mar? ¿Es de compra o alquiler?' },
				{ dir: 'out', text: 'Comprar' },
				{ dir: 'in', text: 'Perfecto. ¿Cuál es tu presupuesto aproximado?' },
				{ dir: 'out', text: 'Hasta 320.000 €' },
				{ dir: 'in', text: 'Genial. Tengo 3 viviendas que encajan contigo. ¿Te las enseño?' },
				{ dir: 'out', text: 'Sí, perfecto 🙌' },
			];
			(async function runChat() {
				for (;;) {
					await waitUntilPlaying();
					chat.innerHTML = '';
					for (const m of conversation) {
						if (!playing) break;
						if (m.dir === 'in') {
							const typing = document.createElement('div');
							typing.className = 'if-bubble in if-typing-msg';
							typing.setAttribute('aria-hidden', 'true');
							typing.innerHTML = '<span></span><span></span><span></span>';
							chat.appendChild(typing);
							await sleep(1000 + Math.random() * 400);
							typing.remove();
						} else {
							await sleep(550);
						}
						const bubble = document.createElement('div');
						bubble.className = 'if-bubble ' + m.dir;
						bubble.textContent = m.text;
						chat.appendChild(bubble);
						await sleep(900);
					}
					await sleep(3200);
				}
			})();
		}

		/* ---------- Leads entrando en directo en el panel (FLIP) ---------- */
		const table = stage.querySelector<HTMLElement>('#ifLeadTable');
		const pill = stage.querySelector<HTMLElement>('#ifLeadPill');
		const dashboardVisible = window.matchMedia('(min-width: 640px)').matches;
		if (table && pill && dashboardVisible) {
			const feed = [
				{ ini: 'MF', name: 'Marta Ferrer', meta: 'Gandía · 195.000 €', cls: 'blue', label: 'Lead nuevo' },
				{ ini: 'DS', name: 'Diego Sanchís', meta: 'Valencia · 420.000 €', cls: 'yellow', label: 'Contactando' },
				{ ini: 'EP', name: 'Elena Prats', meta: 'Cullera · 150.000 €', cls: '', label: 'Interesado' },
				{ ini: 'RB', name: 'Raúl Blasco', meta: 'Alzira · 230.000 €', cls: 'blue', label: 'Lead nuevo' },
			];
			let total = 19;
			let i = 0;
			setInterval(() => {
				if (!playing) return;
				const existing = Array.from(table.querySelectorAll<HTMLElement>('.if-lead-row'));
				if (!existing.length) return;
				const topsBefore = existing.map((r) => r.getBoundingClientRect().top);

				const d = feed[i++ % feed.length];
				const row = document.createElement('div');
				row.className = 'if-lead-row if-lead-new';
				row.innerHTML =
					`<div class="if-avatar" style="--av:#74889b">${d.ini}</div>` +
					`<div class="if-lead-info"><div class="if-lead-name">${d.name}</div><div class="if-lead-meta">${d.meta}</div></div>` +
					`<span class="if-status ${d.cls}">${d.label}</span>`;
				table.prepend(row);

				existing.forEach((r, idx) => {
					const delta = r.getBoundingClientRect().top - topsBefore[idx];
					if (!delta) return;
					r.style.transition = 'none';
					r.style.transform = `translateY(${-delta}px)`;
				});
				void table.offsetWidth;
				existing.forEach((r) => {
					r.style.transition = '';
					r.style.transform = '';
				});

				void row.offsetHeight;
				row.classList.add('if-lead-show');
				pill.lastChild!.textContent = `Lead nuevo · ${++total}`;

				setTimeout(() => {
					const all = Array.from(table.querySelectorAll<HTMLElement>('.if-lead-row'));
					while (all.length > 4) all.pop()?.remove();
				}, 650);
			}, 4800);
		}
	}
</script>
