---
interface Demo {
	sector: string;
	negocio: string;
	color: string;
	imagen: string;
}
interface Props {
	demos: Demo[];
}
const { demos } = Astro.props;

// iconos genéricos de la pantalla de inicio — sin logos ni nombres, solo para
// que se lea como un móvil de verdad antes del toque NFC, nunca como una app real
const gridIcons = ['#fbbf24', '#fb923c', '#f472b6', '#facc15', '#fb923c', '#f59e0b', '#fbbf24', '#f472b6'];
const dockIcons = ['#fbbf24', '#f472b6', '#fb923c', '#facc15'];
---

<div
	class="demo-stage demo-resenas relative mx-auto flex h-[300px] w-full max-w-[280px] items-center justify-center sm:h-[340px]"
	data-role="resenas"
	data-total-steps={demos.length}
	data-active-step="0"
>
	<span class="demo-flash pointer-events-none absolute top-1/2 left-1/2 z-20 h-14 w-14 rounded-full" aria-hidden="true"></span>

	<!-- tarjeta NFC de reseñas: se acerca al móvil igual que en el otro producto
	     (aquí es siempre la tarjeta la que se mueve hacia un móvil quieto, para
	     que las dos animaciones cuenten la misma historia) -->
	<div class="demo-google-card absolute top-1/2 left-1/2 z-0 flex w-32 flex-col items-center gap-2.5 rounded-2xl bg-white px-4 pt-5 pb-4 shadow-2xl shadow-black/60">
		<svg width="22" height="22" viewBox="0 0 24 24">
			<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
			<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.67-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A10.99 10.99 0 0 0 12 23z" />
			<path fill="#FBBC05" d="M5.84 14.09A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.09V7.07H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.93l3.66-2.84z" />
			<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a10.99 10.99 0 0 0-9.82 6.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
		</svg>
		<!-- insignia circular: la "medalla" de 5 estrellas, como un sello de valoración -->
		<div class="demo-rating-badge grid h-[68px] w-[68px] shrink-0 place-items-center rounded-full">
			<div class="grid h-[58px] w-[58px] place-items-center rounded-full bg-amber-50">
				<div class="flex flex-col items-center">
					<span class="text-base leading-none font-extrabold text-zinc-800">5.0</span>
					<div class="mt-1 flex gap-[1.5px]" aria-hidden="true">
						{Array.from({ length: 5 }).map(() => (
							<svg width="7.5" height="7.5" viewBox="0 0 20 20" fill="#F5A623"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z" /></svg>
						))}
					</div>
				</div>
			</div>
		</div>
		<p class="text-center text-[10px] leading-tight font-bold text-zinc-800">¡Valóranos en Google!</p>
	</div>

	<!-- móvil, quieto en el centro — es la tarjeta la que llega hasta él -->
	<div class="demo-phone-wrap relative z-10 mx-auto">
		<div class="demo-phone h-64 w-32 shrink-0 rounded-[2rem] border-2 border-zinc-700 bg-zinc-950 p-2 shadow-2xl sm:h-72 sm:w-36">
			<div class="absolute top-3 left-1/2 h-1.5 w-10 -translate-x-1/2 rounded-full bg-zinc-700"></div>
			<div class="demo-clip relative h-full w-full overflow-hidden rounded-[1.6rem] bg-zinc-900">
				<div class="demo-screen-idle absolute inset-0 flex flex-col overflow-hidden bg-gradient-to-b from-amber-950 via-zinc-900 to-black">
					<div class="flex items-center justify-between px-4 pt-2.5 text-[8px] font-semibold text-white/60">
						<span>9:41</span>
						<div class="flex items-center gap-1">
							<svg width="10" height="7" viewBox="0 0 16 12" fill="currentColor"><rect x="0" y="7" width="3" height="5" rx="0.5" /><rect x="4.5" y="4" width="3" height="8" rx="0.5" /><rect x="9" y="1" width="3" height="11" rx="0.5" /></svg>
							<svg width="12" height="8" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 4.5a10 10 0 0 1 14 0M3.5 7.5a6.3 6.3 0 0 1 9 0M6 10.3a2.6 2.6 0 0 1 4 0" stroke-linecap="round" /></svg>
						</div>
					</div>
					<div class="grid flex-1 grid-cols-4 content-start gap-x-3 gap-y-5 px-4 pt-7">
						{gridIcons.map((c) => (
							<div class="flex flex-col items-center gap-1">
								<span class="demo-app-icon aspect-square w-full rounded-[22%]" style={`background:linear-gradient(160deg, ${c}, color-mix(in srgb, ${c} 62%, #000))`}>
									<span class="demo-app-icon-glyph" />
								</span>
								<span class="demo-app-label h-[3px] w-3/5 rounded-full bg-white/40" />
							</div>
						))}
					</div>
					<div class="mx-4 mb-3.5 flex justify-center">
						<div class="demo-dock flex items-center gap-1 rounded-[10px] px-1.5 py-1.5">
							{dockIcons.map((c) => (
								<span class="demo-app-icon h-3.5 w-3.5 rounded-[22%]" style={`background:linear-gradient(160deg, ${c}, color-mix(in srgb, ${c} 62%, #000))`}>
									<span class="demo-app-icon-glyph" />
								</span>
							))}
						</div>
					</div>
					<div class="flex justify-center pb-2">
						<span class="h-1 w-10 rounded-full bg-white/25"></span>
					</div>
				</div>

				{
					demos.map((d, i) => (
						<div class="demo-screen absolute inset-0 flex flex-col justify-between bg-white px-3.5 pt-8 pb-4 text-zinc-900" data-step={i}>
							<div>
								<div class="flex items-center gap-2">
									<div
										class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
										style={`background:${d.color}`}
									>
										{d.negocio.charAt(0)}
									</div>
									<p class="max-w-[95px] truncate text-[12px] font-semibold">{d.negocio}</p>
								</div>
								<div class="demo-stars relative mt-4 flex w-fit gap-1">
									<span class="demo-tap-ping demo-tap-ping-stars pointer-events-none absolute -inset-2 rounded-full" aria-hidden="true"></span>
									<span class="demo-tap-finger demo-tap-finger-stars pointer-events-none absolute" aria-hidden="true"></span>
									{Array.from({ length: 5 }).map((_, s) => (
										<svg width="15" height="15" viewBox="0 0 20 20" class="demo-star" style={`--star-delay:${s * 90}ms`} fill="#3f3f46">
											<path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6.1L10 14.9l-5.4 3 1.3-6.1L1.3 7.7l6.1-.6L10 1.5z" />
										</svg>
									))}
								</div>
								<p class="mt-3 text-[10.5px] leading-snug text-zinc-400">Escribe una reseña pública...</p>
							</div>
							<div class="demo-save-btn relative w-full overflow-hidden rounded-full py-2 text-center text-[11px] font-medium text-white" style={`background:${d.color}`}>
								Publicar
								<span class="demo-tap-ping absolute inset-0 rounded-full" aria-hidden="true"></span>
								<span class="demo-tap-finger pointer-events-none absolute" aria-hidden="true"></span>
							</div>
						</div>
					))
				}
				<div class="demo-screen demo-screen-success absolute inset-0 flex flex-col items-center justify-center gap-2 bg-white px-4 text-center text-zinc-900">
					<div class="flex h-9 w-9 items-center justify-center rounded-full border border-emerald-400/60 bg-emerald-400/15 text-emerald-500">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12" /></svg>
					</div>
					<p class="text-[13px] font-semibold">¡Reseña publicada!</p>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	/* ============ Igual que en el móvil de contacto: reloj entero en @keyframes
	   puro (ver el comentario largo en ContactoDemo.astro) — mismas constantes,
	   8800ms de ciclo local, mismos puntos de fase en %. ============ */
	.demo-clip {
		transform: translateZ(0);
		isolation: isolate;
	}

	.demo-screen-idle {
		opacity: 1;
	}
	@keyframes demo-idle-cycle {
		0% {
			opacity: 1;
		}
		16.477% {
			opacity: 1;
		}
		16.487% {
			/* ver el comentario largo en ContactoDemo.astro: dos paradas con el mismo
			   % no crean un corte, Chromium se queda con la última y convierte todo
			   lo anterior en rampa — de ahí que la pantalla pareciera apagarse poco
			   a poco durante toda la aproximación. */
			opacity: 0;
		}
		84.091% {
			opacity: 0;
		}
		86.364% {
			opacity: 0;
		}
		91.477% {
			opacity: 1;
		}
		100% {
			opacity: 1;
		}
	}
	.demo-screen-idle {
		animation: demo-idle-cycle 8800ms linear infinite;
	}

	/* iconos de la pantalla de inicio: forma "squircle" (radio ~22%) igual que en
	   iOS/Android de verdad, con solo una pizca de sombra para dar volumen — antes
	   llevaban un brillo tan fuerte que parecían botones de plástico, no iconos */
	.demo-app-icon {
		position: relative;
		overflow: hidden;
		box-shadow: inset 0 -3px 5px rgba(0, 0, 0, 0.22);
	}
	.demo-app-icon-glyph {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 42%;
		height: 42%;
		transform: translate(-50%, -50%);
		border-radius: 30%;
		background: rgba(255, 255, 255, 0.92);
	}
	.demo-app-label {
		opacity: 0.8;
	}
	/* sin backdrop-filter: un blur tan cerca de una esquina redondeada con overflow
	   recortado es justo el combo que hace que Chromium deje "rayas" o un borde
	   recto donde no debería — con un fondo semitransparente normal se ve casi
	   igual de "esmerilado" sin ese riesgo */
	.demo-dock {
		background: rgba(40, 40, 46, 0.55);
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
	}
	/* solo fundido, sin escalar — evita el "descuadre" en las esquinas redondeadas
	   que dejaba ver la capa de detrás mientras dos escalas distintas se cruzaban */
	.demo-screen {
		opacity: 0;
	}
	@keyframes demo-screen-in-cycle {
		0%,
		16.477% {
			opacity: 0;
		}
		21.591% {
			opacity: 1;
		}
		62.5% {
			opacity: 1;
		}
		67.614% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}
	.demo-screen.is-current {
		animation: demo-screen-in-cycle 8800ms linear;
	}
	.demo-screen-success {
		opacity: 0;
	}
	@keyframes demo-success-cycle {
		0%,
		62.5% {
			opacity: 0;
		}
		64.773% {
			opacity: 1;
		}
		84.091% {
			opacity: 1;
		}
		86.364% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}
	.demo-screen-success {
		animation: demo-success-cycle 8800ms linear infinite;
	}

	.demo-google-card {
		border: 1px solid rgba(0, 0, 0, 0.06);
	}
	.demo-rating-badge {
		background: conic-gradient(#f5a623 0deg 360deg);
		padding: 5px;
	}

	/* la tarjeta es la que se mueve (el móvil se queda quieto en el centro) — misma
	   coreografía que en el producto de contacto, en espejo, para que las dos
	   animaciones se lean como la misma historia y no cada una a su aire */
	.demo-google-card {
		opacity: 1;
		transform: translate(calc(-50% + 60%), calc(-50% + 6%)) rotate(5deg) scale(1);
	}
	@keyframes demo-google-card-cycle {
		0% {
			opacity: 0;
			transform: translate(calc(-50% + 175%), calc(-50% + 14%)) rotate(9deg) scale(0.85);
		}
		14.773% {
			opacity: 1;
			transform: translate(calc(-50% + 60%), calc(-50% + 6%)) rotate(5deg) scale(1);
		}
		16.477% {
			opacity: 1;
			transform: translate(calc(-50% + 60%), calc(-50% + 6%)) rotate(5deg) scale(1);
		}
		26.704% {
			opacity: 0;
			transform: translate(-50%, -50%) rotate(0deg) scale(0.4);
		}
		84.091% {
			opacity: 0;
			transform: translate(-50%, -50%) rotate(0deg) scale(0.4);
		}
		98.864% {
			opacity: 0;
			transform: translate(calc(-50% + 175%), calc(-50% + 14%)) rotate(9deg) scale(0.85);
		}
		100% {
			opacity: 0;
			transform: translate(calc(-50% + 175%), calc(-50% + 14%)) rotate(9deg) scale(0.85);
		}
	}
	.demo-google-card {
		animation: demo-google-card-cycle 8800ms cubic-bezier(0.16, 1, 0.3, 1) infinite;
	}

	.demo-flash {
		transform: translate(-50%, -50%) scale(0.4);
		background: radial-gradient(circle, rgba(245, 158, 11, 0.9), transparent 70%);
		opacity: 0;
	}
	@keyframes demo-flash-cycle {
		0%,
		16.477% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(0.4);
		}
		16.487% {
			opacity: 0.9;
			transform: translate(-50%, -50%) scale(0.4);
		}
		22.159% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(2.6);
		}
		100% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(2.6);
		}
	}
	.demo-flash {
		animation: demo-flash-cycle 8800ms cubic-bezier(0.16, 1, 0.3, 1) infinite;
	}

	/* primer toque: sobre las estrellas */
	.demo-star {
		fill: #3f3f46;
	}
	@keyframes demo-star-cycle {
		0%,
		32.955% {
			fill: #3f3f46;
		}
		35.796% {
			fill: #f5a623;
		}
		84.091% {
			fill: #f5a623;
		}
		86.932% {
			fill: #3f3f46;
		}
		100% {
			fill: #3f3f46;
		}
	}
	.demo-screen.is-current .demo-star {
		/* siempre amarillo/ámbar, como cualquier estrellita de reseña real — con el
		   color de cada negocio (verde, azul...) no se leían como una valoración */
		animation: demo-star-cycle 8800ms linear;
		animation-delay: var(--star-delay);
	}
	.demo-tap-ping-stars {
		background: rgba(255, 255, 255, 0.5);
		opacity: 0;
		transform: scale(0.6);
	}
	@keyframes demo-tap-ping-stars-cycle {
		0%,
		32.955% {
			opacity: 0;
			transform: scale(0.6);
		}
		32.965% {
			opacity: 0.8;
			transform: scale(0.6);
		}
		43.182% {
			opacity: 0;
			transform: scale(1.7);
		}
		100% {
			opacity: 0;
			transform: scale(1.7);
		}
	}
	.demo-screen.is-current .demo-tap-ping-stars {
		animation: demo-tap-ping-stars-cycle 8800ms ease-out;
	}
	.demo-tap-finger-stars {
		top: 50%;
		left: 20px;
		transform: translate(-50%, -220%) scale(0.75);
	}
	@keyframes demo-finger-tap-stars-cycle {
		0%,
		32.955% {
			opacity: 0;
			transform: translate(-50%, -220%) scale(0.75);
		}
		35.819% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
		37.864% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(0.8);
		}
		39.909% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
		43.182% {
			opacity: 0;
			transform: translate(-50%, -220%) scale(0.75);
		}
		100% {
			opacity: 0;
			transform: translate(-50%, -220%) scale(0.75);
		}
	}
	.demo-screen.is-current .demo-tap-finger-stars {
		animation: demo-finger-tap-stars-cycle 8800ms ease-out;
	}

	/* segundo toque: sobre publicar */
	.demo-tap-ping {
		background: rgba(255, 255, 255, 0.55);
		opacity: 0;
		transform: scale(0.7);
	}
	@keyframes demo-tap-ping-btn-cycle {
		0%,
		47.727% {
			opacity: 0;
			transform: scale(0.7);
		}
		47.737% {
			opacity: 0.8;
			transform: scale(0.7);
		}
		57.954% {
			opacity: 0;
			transform: scale(1.8);
		}
		100% {
			opacity: 0;
			transform: scale(1.8);
		}
	}
	.demo-screen.is-current .demo-save-btn > .demo-tap-ping {
		animation: demo-tap-ping-btn-cycle 8800ms ease-out;
	}
	@keyframes demo-btn-press-cycle {
		0%,
		47.727% {
			transform: scale(1);
		}
		50.795% {
			transform: scale(0.94);
		}
		53.352% {
			transform: scale(1.03);
		}
		57.954% {
			transform: scale(1);
		}
		100% {
			transform: scale(1);
		}
	}
	.demo-screen.is-current .demo-save-btn {
		animation: demo-btn-press-cycle 8800ms ease-out;
	}
	.demo-save-btn > .demo-tap-finger {
		top: 50%;
		left: 50%;
	}
	@keyframes demo-finger-tap-btn-cycle {
		0%,
		47.727% {
			opacity: 0;
			transform: translate(-50%, -220%) scale(0.75);
		}
		50.591% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
		52.636% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(0.8);
		}
		54.682% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
		57.954% {
			opacity: 0;
			transform: translate(-50%, -220%) scale(0.75);
		}
		100% {
			opacity: 0;
			transform: translate(-50%, -220%) scale(0.75);
		}
	}
	.demo-screen.is-current .demo-save-btn > .demo-tap-finger {
		animation: demo-finger-tap-btn-cycle 8800ms ease-out;
	}
	/* dedo que baja, toca y vuelve a subir — mucho más legible que solo un ping */
	.demo-tap-finger {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.95);
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
		transform: translate(-50%, -220%) scale(0.75);
		opacity: 0;
		z-index: 5;
	}

	@media (prefers-reduced-motion: reduce) {
		.demo-phone-wrap,
		.demo-screen,
		.demo-screen-idle,
		.demo-screen-success,
		.demo-flash,
		.demo-tap-ping,
		.demo-tap-ping-stars,
		.demo-tap-finger,
		.demo-tap-finger-stars,
		.demo-save-btn,
		.demo-star {
			animation: none !important;
		}
		.demo-screen-idle {
			opacity: 1;
		}
	}
</style>
