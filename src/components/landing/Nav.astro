---
import Logo from '../Logo.astro';

// el orden aquí debe coincidir con el orden real de las secciones en la página
// (ver src/pages/index.astro) — si no, el riel resalta los puntos fuera de orden
// al bajar, dando la sensación de que "salta" en vez de seguir el scroll.
const links = [
	{ href: '#productos', label: 'El mecanismo' },
	{ href: '#portafolio', label: 'Portafolio' },
	{ href: '#proceso', label: 'Así empezamos' },
	{ href: '#preguntas', label: 'Preguntas' },
];

const rail = [
	{ id: 'top', label: 'Inicio' },
	{ id: 'productos', label: 'El mecanismo' },
	{ id: 'portafolio', label: 'Portafolio' },
	{ id: 'proceso', label: 'Así empezamos' },
	{ id: 'preguntas', label: 'Preguntas' },
	{ id: 'contacto', label: 'Contacto' },
];
---

<header id="landingNav" class="fixed inset-x-0 top-0 z-40 transition-colors duration-300">
	<div class="relative mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-6">
		<a href="#top" class="z-10 text-base"><Logo /></a>

		<nav aria-label="Secciones" class="section-rail absolute left-1/2 hidden -translate-x-1/2 lg:flex">
			<div class="rail-track relative flex items-center gap-8">
				<span class="rail-line-bg absolute top-1/2 h-px -translate-y-1/2 bg-zinc-700/60" id="railLineBg" aria-hidden="true"></span>
				<span class="rail-line-fill absolute top-1/2 h-px -translate-y-1/2" id="railLineFill" aria-hidden="true"></span>
				<span class="rail-tip absolute top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full" id="railTip" aria-hidden="true"></span>
				{
					rail.map((item) => (
						<a href={`#${item.id}`} data-dot={item.id} class="rail-item group relative flex flex-col items-center py-1" aria-label={item.label}>
							<span class="rail-dot relative z-[1] block h-1.5 w-1.5 rounded-full bg-zinc-600 transition-all duration-300" />
							<span class="rail-label pointer-events-none absolute top-4 rounded-md bg-zinc-900/90 px-2 py-1 text-[10px] font-medium whitespace-nowrap text-zinc-300 opacity-0 shadow-lg ring-1 ring-white/10 transition-all duration-200">
								{item.label}
							</span>
						</a>
					))
				}
			</div>
		</nav>

		<div class="z-10 flex items-center gap-3">
			<a
				href="https://wa.me/34727700065?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20096matics"
				target="_blank"
				rel="noopener noreferrer"
				class="hidden rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 px-4 py-2 text-[13px] font-semibold text-white transition-transform hover:-translate-y-0.5 sm:inline-flex"
			>
				Habla con nosotros
			</a>
			<button
				id="navMenuBtn"
				class="grid h-9 w-9 place-items-center rounded-full border border-white/10 bg-white/5 text-zinc-300 lg:hidden"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="navMenu"
			>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path id="navMenuIconOpen" d="M4 7h16M4 12h16M4 17h16" />
				</svg>
			</button>
		</div>
	</div>

	<nav id="navMenu" class="mx-4 hidden flex-col gap-1 rounded-2xl border border-white/10 bg-zinc-950/95 p-3 backdrop-blur lg:hidden" aria-label="Secciones (móvil)">
		{
			links.map((l) => (
				<a href={l.href} class="rounded-xl px-3 py-2.5 text-sm font-medium text-zinc-300 hover:bg-white/5 hover:text-white">
					{l.label}
				</a>
			))
		}
		<a
			href="https://wa.me/34727700065?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20096matics"
			target="_blank"
			rel="noopener noreferrer"
			class="mt-1 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 px-3 py-2.5 text-center text-sm font-semibold text-white"
		>
			Habla con nosotros
		</a>
	</nav>
</header>

<style>
	#landingNav.is-scrolled {
		background: rgba(9, 9, 11, 0.75);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
	}
	.section-rail {
		opacity: 0.65;
		transition: opacity 0.3s ease;
	}
	.section-rail:hover {
		opacity: 1;
	}
	.rail-label {
		transform: translateY(-2px);
	}
	.group:hover .rail-label {
		opacity: 1;
		transform: translateY(0);
	}
	.rail-item[data-active='true'] .rail-label {
		opacity: 0.85;
		transform: translateY(0);
	}

	/* ============ Riel como barra de progreso de la página: una línea que se rellena
	   con el scroll y una punta que viaja en su extremo — los puntos de cada sección
	   se "encienden" en cuanto la línea los alcanza, así que el punto y la luz son
	   literalmente la misma cosa, nunca dos efectos por separado. ============ */
	.rail-line-fill {
		background: linear-gradient(90deg, #6366f1, #a855f7);
		width: 0;
		opacity: 0;
		transition: width 0.08s linear;
	}
	.rail-line-fill.is-visible {
		opacity: 1;
	}
	.rail-tip {
		background: #c7d2fe;
		box-shadow: 0 0 8px 2px rgba(129, 140, 248, 0.75);
		opacity: 0;
		transition: left 0.08s linear;
	}
	.rail-tip.is-visible {
		opacity: 1;
	}
	.rail-dot {
		transition:
			background-color 0.3s ease,
			box-shadow 0.3s ease,
			transform 0.3s ease;
	}
	/* la línea ya la ha alcanzado: el punto queda "encendido" a su paso */
	.rail-item[data-passed='true'] .rail-dot {
		background: #a5b4fc;
		transform: scale(1.25);
	}
	/* la sección activa además destaca con su propio brillo, sin dejar de ser el
	   mismo punto que ya estaba encendido por la línea */
	.rail-item[data-active='true'] .rail-dot {
		background: linear-gradient(135deg, #818cf8, #c084fc);
		box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.22);
		transform: scale(1.6);
	}
	/* pequeño anillo que respira alrededor del punto activo — "estás aquí", sin
	   competir con el brillo de la línea al pasar por él */
	.rail-item[data-active='true'] .rail-dot::after {
		content: '';
		position: absolute;
		inset: -6px;
		border-radius: 999px;
		border: 1px solid rgba(196, 181, 253, 0.55);
		animation: rail-dot-breathe 2.2s ease-out infinite;
	}
	@keyframes rail-dot-breathe {
		0% {
			transform: scale(0.6);
			opacity: 0.9;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.rail-line-fill,
		.rail-tip {
			transition: none;
		}
		.rail-dot,
		.rail-label {
			transition: none;
		}
		.rail-item[data-active='true'] .rail-dot::after {
			animation: none;
			display: none;
		}
	}
</style>

<script>
	const header = document.getElementById('landingNav');
	const menuBtn = document.getElementById('navMenuBtn');
	const menu = document.getElementById('navMenu');

	if (header) {
		const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}

	if (menuBtn && menu) {
		menuBtn.addEventListener('click', () => {
			const isOpen = menu.classList.toggle('flex');
			menu.classList.toggle('hidden');
			menuBtn.setAttribute('aria-expanded', String(isOpen));
		});
		menu.querySelectorAll('a').forEach((a) =>
			a.addEventListener('click', () => {
				menu.classList.add('hidden');
				menu.classList.remove('flex');
				menuBtn.setAttribute('aria-expanded', 'false');
			})
		);
	}

	const track = document.querySelector<HTMLElement>('.rail-track');
	const lineBg = document.getElementById('railLineBg');
	const lineFill = document.getElementById('railLineFill');
	const tip = document.getElementById('railTip');
	const railLinks = document.querySelectorAll<HTMLAnchorElement>('.rail-item');
	const sections = Array.from(railLinks)
		.map((link) => ({ link, el: document.getElementById(link.dataset.dot ?? '') }))
		.filter((s): s is { link: HTMLAnchorElement; el: HTMLElement } => !!s.el);

	// el riel es una barra de progreso de la página entera: la línea se rellena según
	// el scroll (0 al principio, 1 al final) y cada punto se "enciende" en cuanto esa
	// misma línea lo alcanza — el punto no es un efecto aparte, es donde está la línea.
	function updateRail() {
		if (!track || !lineBg || !lineFill || !tip || !sections.length) return;
		const doc = document.documentElement;
		const maxScroll = doc.scrollHeight - window.innerHeight;
		const progress = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;

		const dots = sections.map((s) => s.link.querySelector<HTMLElement>('.rail-dot')!);
		const trackRect = track.getBoundingClientRect();
		const positions = dots.map((dot) => {
			const r = dot.getBoundingClientRect();
			return r.left - trackRect.left + r.width / 2;
		});
		const startX = positions[0];
		const endX = positions[positions.length - 1];
		const currentX = startX + (endX - startX) * progress;

		lineBg.style.left = `${startX}px`;
		lineBg.style.width = `${endX - startX}px`;
		lineFill.style.left = `${startX}px`;
		lineFill.style.width = `${Math.max(0, currentX - startX)}px`;
		lineFill.classList.add('is-visible');
		tip.style.left = `${currentX}px`;
		tip.classList.add('is-visible');

		sections.forEach((s, i) => {
			s.link.toggleAttribute('data-passed', positions[i] <= currentX + 1);
		});
	}

	// qué sección es "la activa" (etiqueta visible, punto con más brillo) sigue
	// basado en cuál tiene el centro más cerca del centro del viewport — recalculado
	// en cada frame de scroll para no depender de umbrales fijos.
	let ticking = false;
	function updateActiveSection() {
		ticking = false;
		if (!sections.length) return;
		const viewportCenter = window.innerHeight / 2;
		let closest = sections[0];
		let closestDist = Infinity;
		for (const s of sections) {
			const rect = s.el.getBoundingClientRect();
			const center = rect.top + rect.height / 2;
			const dist = Math.abs(center - viewportCenter);
			if (dist < closestDist) {
				closestDist = dist;
				closest = s;
			}
		}
		if (closest.link.getAttribute('data-active') !== 'true') {
			railLinks.forEach((l) => l.removeAttribute('data-active'));
			closest.link.setAttribute('data-active', 'true');
		}
		updateRail();
	}

	function requestUpdate() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(updateActiveSection);
	}

	if (sections.length) {
		updateActiveSection();
		window.addEventListener('scroll', requestUpdate, { passive: true });
		window.addEventListener('resize', requestUpdate);
	}

	railLinks.forEach((link) => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			document.getElementById(link.dataset.dot ?? '')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
</script>
