---
import Logo from '../Logo.astro';
---

<nav
	id="landingSideNav"
	class="fixed top-1/2 left-5 z-40 flex -translate-y-1/2 flex-col items-start gap-4 opacity-0 transition-opacity duration-300 sm:left-8"
	aria-label="Secciones"
>
	<button id="landingSideNavLogo" class="mb-2 text-lg" aria-label="Ir al inicio">
		<Logo />
	</button>
	<ul id="landingSideNavList" class="flex flex-col gap-4"></ul>
</nav>

<style>
	.side-nav-item {
		display: flex;
		align-items: center;
		gap: 10px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(228, 228, 231, 0.45);
		text-align: left;
		transition:
			color 0.25s ease,
			font-size 0.25s ease,
			letter-spacing 0.25s ease;
	}
	.side-nav-item::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: rgba(228, 228, 231, 0.35);
		flex-shrink: 0;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}
	.side-nav-item.active {
		color: #fff;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.08em;
	}
	.side-nav-item.active::before {
		background: linear-gradient(90deg, #3b82f6, #a855f7);
		transform: scale(1.8);
	}
	#landingSideNavLogo {
		cursor: pointer;
	}
	@media (max-width: 640px) {
		.side-nav-label {
			display: none;
		}
	}
</style>
