---
import Logo from '../Logo.astro';
---

<nav
	id="landingSideNav"
	class="fixed top-1/2 left-5 z-40 flex -translate-y-1/2 flex-col items-start gap-5 opacity-0 transition-opacity duration-300 sm:left-8"
	aria-label="Secciones"
>
	<button id="landingSideNavLogo" class="text-lg" aria-label="Ir al inicio"><Logo /></button>
	<div class="side-nav-track">
		<span class="side-nav-rail"></span>
		<span id="landingSideNavIndicator" class="side-nav-indicator"></span>
		<ul id="landingSideNavList" class="side-nav-list"></ul>
	</div>
</nav>

<style is:global>
	@property --dot-a {
		syntax: '<color>';
		inherits: true;
		initial-value: #6366f1;
	}
	@property --dot-b {
		syntax: '<color>';
		inherits: true;
		initial-value: #a855f7;
	}
	.side-nav-track {
		position: relative;
		--dot-a: #6366f1;
		--dot-b: #a855f7;
		transition:
			--dot-a 1.8s ease,
			--dot-b 1.8s ease;
	}
	.side-nav-list {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 15px;
	}
	.side-nav-list li {
		transition: padding 0.4s cubic-bezier(0.19, 1, 0.22, 1);
	}
	.side-nav-list li:has(.side-nav-item.active) {
		padding: 9px 0;
	}
	/* mientras medimos la posición final del punto activo, anulamos las transiciones que cambian su tamaño/hueco */
	.side-nav-track.nav-measuring .side-nav-item,
	.side-nav-track.nav-measuring li {
		transition: none !important;
	}
	.side-nav-rail {
		position: absolute;
		left: -3.5px;
		top: 10px;
		bottom: 10px;
		width: 1px;
		background: rgba(228, 228, 231, 0.12);
	}
	.side-nav-indicator {
		position: absolute;
		left: -7px;
		top: 0;
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: linear-gradient(90deg, var(--dot-a), var(--dot-b));
		opacity: 0;
		transform: translateY(0);
		transition: transform 1.5s cubic-bezier(0.65, 0, 0.35, 1);
		animation: side-dot-pulse 1.8s ease-in-out infinite;
		z-index: 1;
		pointer-events: none;
	}
	.side-nav-indicator.is-visible {
		opacity: 1;
	}
	.side-nav-item {
		position: relative;
		display: flex;
		align-items: center;
		gap: 16px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px 0;
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(228, 228, 231, 0.45);
		text-align: left;
		transition:
			color 0.3s ease,
			font-size 0.25s ease,
			letter-spacing 0.25s ease,
			gap 0.35s cubic-bezier(0.19, 1, 0.22, 1),
			transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
	}
	.side-nav-item::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: rgba(228, 228, 231, 0.35);
		flex-shrink: 0;
		transition:
			background 0.25s ease,
			opacity 0.2s ease;
	}
	.side-nav-item:hover {
		color: rgba(228, 228, 231, 0.75);
	}
	.side-nav-item.active {
		color: var(--dot-a);
		font-size: 14.5px;
		font-weight: 700;
		letter-spacing: 0.09em;
		gap: 20px;
		transform: translateX(4px);
	}
	.side-nav-item.active::before {
		opacity: 0;
	}
	@keyframes side-dot-pulse {
		0%,
		100% {
			box-shadow: 0 0 6px color-mix(in srgb, var(--dot-a) 55%, transparent);
		}
		50% {
			box-shadow: 0 0 15px color-mix(in srgb, var(--dot-a) 95%, transparent);
		}
	}
	#landingSideNavLogo {
		cursor: pointer;
	}
	@media (max-width: 640px) {
		.side-nav-label {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.side-nav-indicator {
			animation: none;
			box-shadow: 0 0 10px color-mix(in srgb, var(--dot-a) 80%, transparent);
		}
	}
</style>
