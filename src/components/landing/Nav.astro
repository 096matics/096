---
import Logo from '../Logo.astro';
---

<nav
	id="landingSideNav"
	class="fixed top-1/2 left-5 z-40 flex -translate-y-1/2 flex-col items-start gap-5 opacity-0 transition-opacity duration-300 sm:left-8"
	aria-label="Secciones"
>
	<button id="landingSideNavLogo" class="text-lg" aria-label="Ir al inicio"><Logo /></button>
	<div class="side-nav-track">
		<span class="side-nav-rail"></span>
		<span id="landingSideNavIndicator" class="side-nav-indicator"></span>
		<ul id="landingSideNavList" class="side-nav-list"></ul>
	</div>
</nav>

<style>
	.side-nav-track {
		position: relative;
	}
	.side-nav-list {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 15px;
	}
	.side-nav-rail {
		position: absolute;
		left: 2.5px;
		top: 10px;
		bottom: 10px;
		width: 1px;
		background: rgba(228, 228, 231, 0.12);
	}
	.side-nav-indicator {
		position: absolute;
		left: -1px;
		top: 0;
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: linear-gradient(90deg, #3b82f6, #a855f7);
		opacity: 0;
		transform: translateY(0);
		transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
		animation: side-dot-pulse 1.8s ease-in-out infinite;
		z-index: 1;
		pointer-events: none;
	}
	.side-nav-indicator.is-visible {
		opacity: 1;
	}
	.side-nav-item {
		position: relative;
		display: flex;
		align-items: center;
		gap: 11px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px 0;
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(228, 228, 231, 0.45);
		text-align: left;
		transition:
			color 0.25s ease,
			font-size 0.25s ease,
			letter-spacing 0.25s ease,
			gap 0.35s cubic-bezier(0.19, 1, 0.22, 1),
			transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
	}
	.side-nav-item::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: rgba(228, 228, 231, 0.35);
		flex-shrink: 0;
		transition:
			background 0.25s ease,
			opacity 0.2s ease;
	}
	.side-nav-item:hover {
		color: rgba(228, 228, 231, 0.75);
	}
	.side-nav-item.active {
		color: #fff;
		font-size: 13.5px;
		font-weight: 600;
		letter-spacing: 0.08em;
		gap: 16px;
		transform: translateX(4px);
	}
	.side-nav-item.active::before {
		opacity: 0;
	}
	@keyframes side-dot-pulse {
		0%,
		100% {
			box-shadow: 0 0 6px rgba(139, 92, 246, 0.55);
		}
		50% {
			box-shadow: 0 0 15px rgba(139, 92, 246, 0.95);
		}
	}
	#landingSideNavLogo {
		cursor: pointer;
	}
	@media (max-width: 640px) {
		.side-nav-label {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.side-nav-indicator {
			animation: none;
			box-shadow: 0 0 10px rgba(139, 92, 246, 0.8);
		}
	}
</style>
