---
import WhatsAppCTA from '../WhatsAppCTA.astro';

const equipo = [
	{
		nombre: 'David Ferrer Herraiz',
		rol: 'Cofundador',
		ruta: '/tarjeta/personal-david',
		imagen: '/plantillas/personal-david.jpg',
		descripcion: 'Tarjeta digital personal · 096matics',
	},
	{
		nombre: 'Carlos Cantos Blasco',
		rol: 'Cofundador',
		ruta: '/tarjeta/personal-carlos',
		imagen: '/plantillas/personal-carlos.jpg',
		descripcion: 'Tarjeta digital personal · 096matics',
	},
];

const VCARD =
	'data:text/vcard;charset=utf-8,BEGIN%3AVCARD%0AVERSION%3A3.0%0AN%3A096matics%3B%3B%3B%3B%0AFN%3A096matics%0AORG%3A096matics%0ATITLE%3ATarjetas%20digitales%20NFC%0ATEL%3BTYPE%3DCELL%3A%2B34727700065%0AEMAIL%3Acontacto%40096matics.com%0AURL%3Ahttps%3A%2F%2F096matics.com%0AEND%3AVCARD';
---

<section
	id="contacto"
	data-page
	data-nav="Contacto"
	data-glow-a="#3b82f6"
	data-glow-b="#a855f7"
	class="flex min-h-dvh flex-col border-t border-zinc-800 py-16 sm:py-20"
>
	<div class="m-auto max-w-5xl px-6">
		<p class="piece piece-top piece-d0 text-sm tracking-widest text-indigo-400 uppercase">Contacto</p>
		<h2 class="piece-materialize piece-d1 mt-3 text-3xl font-semibold text-white sm:text-4xl">
			Hablemos de tu negocio
		</h2>
		<p class="piece piece-left piece-d1 mt-4 max-w-2xl text-zinc-400">
			Cuéntanos qué necesitas y te decimos si 096matics encaja, sin compromiso.
		</p>
		<div class="piece piece-bottom piece-d2 mt-8">
			<WhatsAppCTA texto="Escríbenos por WhatsApp" mensaje="Hola, quiero información sobre 096matics" />
		</div>

		<div class="mt-14 grid gap-10 sm:grid-cols-2">
			<div class="piece piece-left piece-d3">
				<p class="text-xs tracking-widest text-zinc-500 uppercase">Nuestro equipo</p>
				<div class="mt-4 grid max-w-xs grid-cols-2 gap-3">
					{
						equipo.map((persona) => (
							<div
								role="button"
								tabindex="0"
								data-preview-trigger
								data-preview-group="equipo"
								data-preview-img={persona.imagen}
								data-preview-sector={persona.rol}
								data-preview-title={persona.nombre}
								data-preview-desc={persona.descripcion}
								data-preview-href={persona.ruta}
								data-preview-cta="Abrir esta tarjeta →"
								class="group cursor-pointer overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 transition-colors hover:border-zinc-600"
							>
								<img
									src={persona.imagen}
									alt={persona.nombre}
									class="aspect-square w-full object-cover"
									loading="lazy"
								/>
								<div class="p-2.5">
									<p class="truncate text-xs font-medium text-white">{persona.nombre}</p>
									<p class="text-[11px] text-zinc-500">{persona.rol}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
			<div class="piece piece-right piece-d4">
				<p class="text-xs tracking-widest text-zinc-500 uppercase">Contacto directo</p>
				<div class="contact-icons mt-5 flex items-end gap-6">
					<a
						href="https://wa.me/34727700065"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="WhatsApp"
						class="contact-icon contact-icon--a"
					>
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
							<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" />
						</svg>
					</a>
					<a
						href="https://www.instagram.com/096matics/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram"
						class="contact-icon contact-icon--b"
					>
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
							<rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle
								cx="17.5"
								cy="6.5"
								r="1"
							/>
						</svg>
					</a>
					<a href="mailto:contacto@096matics.com" aria-label="Email" class="contact-icon contact-icon--c">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
							<path d="M22 6l-10 7L2 6" /><rect x="2" y="4" width="20" height="16" rx="2" />
						</svg>
					</a>
				</div>
				<a download="096matics.vcf" href={VCARD} class="mt-4 inline-block text-xs text-zinc-600 hover:text-zinc-300"
					>↓ Guardar contacto de 096matics</a
				>
			</div>
		</div>

		<div class="piece piece-bottom piece-d5 mt-14 flex flex-col gap-2 border-t border-zinc-800 pt-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
			<p>096matics · Sagunto, Valencia</p>
			<a href="https://wa.me/34727700065" class="transition-colors hover:text-zinc-300">+34 727 700 065</a>
		</div>
	</div>
</section>

<style>
	.contact-icon {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		color: #a1a1aa;
		transition:
			color 0.25s ease,
			transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.contact-icon::before {
		content: '';
		position: absolute;
		inset: -10px;
		border-radius: 999px;
		background: radial-gradient(circle, rgba(139, 92, 246, 0.4), transparent 70%);
		opacity: 0;
		filter: blur(4px);
		transition: opacity 0.25s ease;
	}
	.contact-icon svg {
		position: relative;
		z-index: 1;
	}
	.contact-icon:hover,
	.contact-icon:focus-visible {
		color: #fff;
	}
	.contact-icon:hover::before,
	.contact-icon:focus-visible::before {
		opacity: 1;
	}
	.contact-icon--a {
		transform: translateY(-3px) rotate(-4deg);
	}
	.contact-icon--b {
		transform: translateY(4px) rotate(3deg);
	}
	.contact-icon--c {
		transform: translateY(-1px) rotate(-2deg);
	}
	.contact-icon--a:hover {
		transform: translateY(-6px) rotate(-4deg) scale(1.08);
	}
	.contact-icon--b:hover {
		transform: translateY(1px) rotate(3deg) scale(1.08);
	}
	.contact-icon--c:hover {
		transform: translateY(-4px) rotate(-2deg) scale(1.08);
	}
</style>
