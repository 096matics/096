---
import WhatsAppCTA from '../WhatsAppCTA.astro';
---

<section id="contacto" class="scroll-mt-20 border-t border-zinc-800 py-16 sm:py-20">
	<div class="mx-auto max-w-5xl px-6">
		<p class="text-sm tracking-widest text-amber-400 uppercase">Contacto</p>
		<h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Hablemos de tu negocio</h2>
		<p class="mt-4 max-w-2xl text-zinc-400">
			Cuéntanos qué necesitas y te decimos si 096matics encaja, sin compromiso.
		</p>
		<div class="mt-8">
			<WhatsAppCTA texto="Escríbenos por WhatsApp" mensaje="Hola, quiero información sobre 096matics" />
		</div>

		<div class="mt-16 grid gap-10 sm:grid-cols-2">
			<div>
				<p class="text-xs tracking-widest text-zinc-500 uppercase">Nuestro equipo</p>
				<div class="mt-4 rounded-2xl border border-dashed border-zinc-800 bg-zinc-900/20 px-6 py-10 text-center">
					<p class="text-sm text-zinc-500">Próximamente: tarjetas personales del equipo</p>
				</div>
			</div>
			<div>
				<p class="text-xs tracking-widest text-zinc-500 uppercase">Síguenos</p>
				<div class="mt-4 flex gap-3">
					<span
						class="flex h-11 w-11 items-center justify-center rounded-full border border-dashed border-zinc-800 text-xs text-zinc-600"
						aria-hidden="true"
					>
						IG
					</span>
					<span
						class="flex h-11 w-11 items-center justify-center rounded-full border border-dashed border-zinc-800 text-xs text-zinc-600"
						aria-hidden="true"
					>
						@
					</span>
				</div>
				<p class="mt-3 text-xs text-zinc-600">Próximamente</p>
			</div>
		</div>
	</div>
</section>
