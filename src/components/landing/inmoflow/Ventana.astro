---
// Marco de la app de InmoFlow (barra superior + menú lateral) que envuelve
// cada pantalla del recorrido. Sin overflow:hidden a propósito: en Safari de
// iPhone un overflow:hidden intermedio sobre contenido animado con bordes
// redondeados puede dejar de pintarlo (ver la nota en global.css). Cada pieza
// lleva su propio radio en su esquina.
interface Props {
	nav?: number;
	hora?: string;
	class?: string;
}
const { nav = 0, hora = '23:47', class: className = '' } = Astro.props;

const menu = [
	{ label: 'Bandeja', d: 'M4 13h4l2 3h4l2-3h4M4 13l2.5-7h11L20 13v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z' },
	{ label: 'Conversaciones', d: 'M5 18l-1 3 3.5-1.5A8 8 0 1 0 5 18z' },
	{ label: 'Clientes', d: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM3 20a6 6 0 0 1 12 0M16 4.5a3.5 3.5 0 0 1 0 6.5M18 14.5a6 6 0 0 1 3 5.5' },
	{ label: 'Agenda', d: 'M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM4 10h16M8 3v4M16 3v4' },
	{ label: 'Informes', d: 'M4 20h16M7 16v-5M12 16V7M17 16v-8' },
];
---

<div class={`ifw ${className}`} aria-hidden="true">
	<div class="ifw-top">
		<span class="ifw-dots"><i></i><i></i><i></i></span>
		<span class="ifw-brand">
			<span class="ifw-logo">
				<svg viewBox="0 0 32 32" width="12" height="12"><path d="M16 8l8 7h-2.5v8h-4v-5h-3v5h-4v-8H8z" fill="#fff"></path></svg>
			</span>
			InmoFlow
		</span>
		<span class="ifw-clock" data-clock>{hora}</span>
	</div>
	<div class="ifw-body">
		<nav class="ifw-side">
			{
				menu.map((m, i) => (
					<span class={`ifw-nav ${i === nav ? 'is-current' : ''}`} data-nav={i}>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d={m.d} />
						</svg>
						<span class="ifw-nav-label">{m.label}</span>
					</span>
				))
			}
		</nav>
		<div class="ifw-main">
			<slot />
		</div>
	</div>
</div>

<style>
	.ifw {
		position: relative;
		border-radius: 20px;
		background: #fbfbf8;
		color: #22313a;
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.07),
			0 40px 90px -30px rgba(52, 211, 153, 0.25),
			0 30px 70px rgba(0, 0, 0, 0.5);
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
	}
	.ifw-top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 11px 16px;
		border-radius: 20px 20px 0 0;
		background: #fff;
		border-bottom: 1px solid #e7ebe6;
		font-size: 12px;
	}
	.ifw-dots {
		display: flex;
		gap: 6px;
	}
	.ifw-dots i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #e2e6e2;
	}
	.ifw-brand {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-weight: 800;
		letter-spacing: -0.01em;
	}
	.ifw-logo {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border-radius: 6px;
		background: #526a5d;
	}
	.ifw-clock {
		justify-self: end;
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		color: #8a958f;
	}
	.ifw-body {
		display: grid;
		grid-template-columns: 148px minmax(0, 1fr);
	}
	.ifw-side {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 14px 10px;
		border-right: 1px solid #eceff0;
		border-radius: 0 0 0 20px;
		background: #f5f7f3;
	}
	.ifw-nav {
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 8px 10px;
		border-radius: 10px;
		font-size: 12px;
		font-weight: 600;
		color: #7b8680;
		transition:
			background-color 0.35s,
			color 0.35s;
	}
	.ifw-nav.is-current {
		background: #fff;
		color: #22313a;
		box-shadow: 0 1px 2px rgba(36, 52, 45, 0.08);
	}
	.ifw-nav.is-current svg {
		color: #526a5d;
	}
	.ifw-main {
		min-width: 0;
		padding: 20px;
	}

	@media (max-width: 1279px) {
		.ifw-body {
			grid-template-columns: 52px minmax(0, 1fr);
		}
		.ifw-side {
			align-items: center;
			padding: 14px 8px;
		}
		.ifw-nav {
			padding: 8px;
		}
		.ifw-nav-label {
			display: none;
		}
	}
	@media (max-width: 639px) {
		.ifw {
			border-radius: 16px;
		}
		.ifw-top {
			border-radius: 16px 16px 0 0;
			padding: 10px 12px;
		}
		.ifw-body {
			grid-template-columns: minmax(0, 1fr);
		}
		.ifw-side {
			display: none;
		}
		.ifw-main {
			padding: 14px;
		}
	}
</style>
