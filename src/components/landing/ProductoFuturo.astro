---
import WhatsAppCTA from '../WhatsAppCTA.astro';
---

<section data-animate class="border-b border-zinc-800 bg-white/[0.015]">
	<div data-reveal class="piece piece-d0 mx-auto flex max-w-6xl flex-col items-start gap-4 px-5 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
		<div class="flex items-start gap-3.5 sm:items-center">
			<span class="mt-1 inline-flex shrink-0 items-center gap-1.5 rounded-full border border-dashed border-amber-400/50 px-2.5 py-1 text-[10px] font-bold tracking-widest text-amber-400 uppercase sm:mt-0">
				<span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
				Próximamente
			</span>
			<div>
				<p class="font-semibold text-white">Scoring de clientes: sabrás a quién llamar primero</p>
				<p class="mt-0.5 max-w-lg text-sm text-zinc-500">
					Analizamos tus clientes y los clasificamos según su probabilidad real de compra.
				</p>
			</div>
		</div>
		<WhatsAppCTA
			texto="Avísame cuando esté listo"
			mensaje="Hola, quiero que me aviséis cuando esté listo el scoring de clientes"
			variant="amber"
			class="shrink-0"
		/>
	</div>
</section>
