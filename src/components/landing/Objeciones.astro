---
const preguntas = [
	{
		pregunta: '¿Cuánto tarda la instalación?',
		respuesta: 'Primera visita para conocer tu negocio, segunda con la tarjeta lista y configurada. Sin líos técnicos de tu parte.',
	},
	{
		pregunta: '¿Necesito contratar algo o pagar cuota?',
		respuesta: 'Te lo explicamos claro por WhatsApp, sin compromiso, antes de que decidas nada.',
	},
	{
		pregunta: '¿Sirve con cualquier móvil?',
		respuesta: 'Sí — cualquier móvil moderno con NFC, sin instalar ninguna app.',
	},
];
---

<section
	id="preguntas"
	data-page
	data-nav="Preguntas"
	data-glow-a="#22d3ee"
	data-glow-b="#3b82f6"
	class="flex min-h-dvh flex-col border-t border-zinc-800 py-4 sm:py-20 [@media(max-width:639px)_and_(max-height:780px)]:py-2"
>
	<div class="m-auto w-full max-w-5xl px-6">
		<p class="piece piece-top piece-d0 text-sm tracking-widest text-cyan-400 uppercase">Antes de escribirnos</p>
		<h2 class="piece piece-left piece-d1 mt-2 text-3xl font-semibold text-white sm:mt-3 sm:text-4xl [@media(max-width:639px)_and_(max-height:780px)]:mt-1">
			Lo que la gente pregunta antes de decidirse
		</h2>

		<div data-hscroll class="preguntas-scroll piece piece-bottom piece-d2 mt-4 flex gap-3 sm:mt-8 sm:grid sm:grid-cols-3 sm:gap-4 [@media(max-width:639px)_and_(max-height:780px)]:mt-2">
			{
				preguntas.map((p) => (
					<div class="preguntas-scroll-item rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4 sm:p-5">
						<p class="text-sm font-medium text-white">{p.pregunta}</p>
						<p class="mt-2 text-xs leading-relaxed text-zinc-500 sm:text-sm">{p.respuesta}</p>
					</div>
				))
			}
		</div>
		<p class="mt-2 text-xs text-zinc-600 sm:hidden [@media(max-width:639px)_and_(max-height:780px)]:mt-1">
			← Desliza para ver las tres →
		</p>
	</div>
</section>

<style>
	.preguntas-scroll {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		margin-left: -1.5rem;
		margin-right: -1.5rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		padding-bottom: 2px;
	}
	.preguntas-scroll::-webkit-scrollbar {
		display: none;
	}
	.preguntas-scroll-item {
		width: 78%;
		min-width: 0;
		flex-shrink: 0;
		scroll-snap-align: center;
	}
	@media (max-width: 639px) {
		.preguntas-scroll {
			mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
			-webkit-mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
		}
	}
	@media (min-width: 640px) {
		.preguntas-scroll {
			margin-left: 0;
			margin-right: 0;
			padding-left: 0;
			padding-right: 0;
		}
		.preguntas-scroll-item {
			width: auto;
			flex-shrink: 1;
		}
	}
</style>
