---
const preguntas = [
	{
		pregunta: '¿Cuánto tarda la instalación?',
		respuesta:
			'Primera visita para conocer tu negocio, segunda con la tarjeta lista y configurada. Sin líos técnicos de tu parte.',
	},
	{
		pregunta: '¿Necesito contratar algo o pagar cuota?',
		respuesta: 'Te lo explicamos claro por WhatsApp, sin compromiso, antes de que decidas nada.',
	},
	{
		pregunta: '¿Sirve con cualquier móvil?',
		respuesta: 'Sí — cualquier móvil moderno con NFC, sin instalar ninguna app.',
	},
	{
		pregunta: '¿Qué pasa si cambio de local o de datos?',
		respuesta:
			'Nos lo dices por WhatsApp y lo actualizamos nosotros — la tarjeta física no cambia, solo lo que hay detrás.',
	},
];
---

<section id="preguntas" data-animate class="border-b border-zinc-800 py-24 sm:py-32">
	<div class="mx-auto max-w-6xl px-5 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
			<div data-reveal class="piece piece-left piece-d0">
				<p class="text-sm font-bold tracking-widest text-cyan-400 uppercase">Antes de escribirnos</p>
				<h2 class="mt-2 text-3xl font-semibold text-white sm:text-4xl">Lo que la gente pregunta antes de decidirse</h2>
			</div>

			<div data-reveal class="piece piece-right piece-d1 faq-grid border-t border-zinc-800">
				{
					preguntas.map((p, i) => (
						<div class="faq border-b border-zinc-800">
							<button
								type="button"
								id={`faq-q${i}`}
								aria-expanded="false"
								aria-controls={`faq-a${i}`}
								class="flex w-full items-center justify-between gap-4 py-4.5 text-left text-[15px] font-semibold text-white"
							>
								<span>{p.pregunta}</span>
								<span class="faq-icon text-lg text-indigo-400">+</span>
							</button>
							<div id={`faq-a${i}`} class="answer" role="region" aria-labelledby={`faq-q${i}`}>
								<div class="min-h-0 overflow-hidden">
									<p class="px-0 pb-4.5 text-sm leading-relaxed text-zinc-400">{p.respuesta}</p>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.faq {
		transition: background-color 0.25s ease;
	}
	.faq:hover {
		background: rgba(255, 255, 255, 0.02);
	}
	.faq-icon {
		flex-shrink: 0;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.faq.open .faq-icon {
		transform: rotate(45deg);
	}
	.faq .answer {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.faq.open .answer {
		grid-template-rows: 1fr;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('.faq > button').forEach((btn) => {
		btn.addEventListener('click', () => {
			const faq = btn.closest('.faq');
			const open = faq?.classList.toggle('open');
			btn.setAttribute('aria-expanded', String(!!open));
		});
	});
</script>
