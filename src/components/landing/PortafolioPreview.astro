---
import { getCollection } from 'astro:content';
import SectorCard from '../SectorCard.astro';

const sectores = (await getCollection('sectores')).slice(0, 3);
---

<section id="portafolio" data-page class="scroll-mt-20 flex min-h-dvh flex-col justify-center border-t border-zinc-800 py-16 sm:py-20">
	<div class="reveal mx-auto max-w-5xl px-6">
		<p class="text-sm tracking-widest text-indigo-400 uppercase">Portafolio</p>
		<h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Ejemplos por sector</h2>
		<p class="mt-4 max-w-2xl text-zinc-400">
			Así se vería la tarjeta NFC en tu negocio. Elige el sector más parecido al tuyo.
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-3">
			{
				sectores.map((s) => (
					<SectorCard
						slug={s.id}
						titulo={s.data.titulo}
						resumen={s.data.resumen}
						negocioEjemplo={s.data.negocioEjemplo}
						colorHex={s.data.colorHex}
					/>
				))
			}
		</div>

		<a
			href="/portafolio"
			class="mt-8 inline-block text-sm font-medium text-zinc-300 transition-colors hover:text-white"
		>
			Ver todo el portafolio →
		</a>
	</div>
</section>
