---
import { getCollection } from 'astro:content';
import PlantillaCard from '../PlantillaCard.astro';

const plantillas = await getCollection('plantillas');
const destacadas = ['seguros-estandar', 'resenas-ticket', 'otras-ideas-linktree'];
const preview = destacadas
	.map((id) => plantillas.find((p) => p.id === id))
	.filter((p): p is NonNullable<typeof p> => !!p);
---

<section
	id="portafolio"
	data-page
	data-nav="Portafolio"
	data-glow-a="#a855f7"
	data-glow-b="#f59e0b"
	class="flex min-h-dvh flex-col border-t border-zinc-800 py-16 sm:py-20"
>
	<div class="m-auto max-w-5xl px-6">
		<p class="piece piece-top piece-d0 text-sm tracking-widest text-indigo-400 uppercase">Portafolio</p>
		<h2 class="piece piece-left piece-d1 mt-3 text-3xl font-semibold text-white sm:text-4xl">
			Plantillas y ejemplos reales
		</h2>
		<p class="piece piece-left piece-d1 mt-4 max-w-2xl text-zinc-400">
			Así se ven nuestras tarjetas NFC en la práctica. Elige el sector o el estilo más parecido al tuyo.
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-3">
			{
				preview.map((p, i) => (
					<div class={`piece piece-bottom piece-d${Math.min(2 + i, 6)}`}>
						<PlantillaCard
							nombre={p.data.nombre}
							descripcion={p.data.descripcion}
							sector={p.data.sector}
							colorHex={p.data.colorHex}
							imagen={p.data.imagen}
							ruta={p.data.ruta}
						/>
					</div>
				))
			}
		</div>

		<a
			href="/portafolio"
			class="piece piece-bottom piece-d6 group mt-8 inline-flex items-center gap-2 rounded-full border border-indigo-400/40 bg-indigo-500/10 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:border-indigo-400/70 hover:bg-indigo-500/20"
		>
			Ver todo el portafolio
			<span class="transition-transform group-hover:translate-x-0.5">→</span>
		</a>
	</div>
</section>
