---
import { getCollection } from 'astro:content';
import PlantillaCard from '../PlantillaCard.astro';

const plantillas = await getCollection('plantillas');
const destacadas = ['seguros-estandar', 'resenas-ticket', 'otras-ideas-linktree'];
const preview = destacadas
	.map((id) => plantillas.find((p) => p.id === id))
	.filter((p): p is NonNullable<typeof p> => !!p);
---

<section
	id="portafolio"
	data-page
	data-nav="Portafolio"
	data-glow-a="#a855f7"
	data-glow-b="#f59e0b"
	class="flex min-h-dvh flex-col border-t border-zinc-800 py-8 sm:py-20"
>
	<div class="m-auto max-w-5xl px-6">
		<p class="piece piece-top piece-d0 text-sm tracking-widest text-indigo-400 uppercase">Portafolio</p>
		<h2 class="piece piece-left piece-d1 mt-3 text-3xl font-semibold text-white sm:text-4xl">
			Plantillas y ejemplos reales
		</h2>
		<p class="piece piece-left piece-d1 mt-3 max-w-2xl text-zinc-400 sm:mt-4">
			Así se ven nuestras tarjetas NFC en la práctica. Elige el sector o el estilo más parecido al tuyo.
		</p>

		<div class="portfolio-scroll mt-5 flex gap-4 sm:mt-10 sm:grid sm:grid-cols-3">
			{
				preview.map((p, i) => (
					<div class={`piece piece-bottom piece-d${Math.min(2 + i, 6)} portfolio-scroll-item`}>
						<PlantillaCard
							nombre={p.data.nombre}
							descripcion={p.data.descripcion}
							sector={p.data.sector}
							colorHex={p.data.colorHex}
							imagen={p.data.imagen}
							ruta={p.data.ruta}
						/>
					</div>
				))
			}
		</div>
		<p class="mt-2 text-xs text-zinc-600 sm:hidden">← Deslízate para ver las tres →</p>

		<a
			href="/portafolio"
			class="piece piece-bottom piece-d6 group mt-4 inline-flex items-center gap-2 rounded-full border border-indigo-400/40 bg-indigo-500/10 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:border-indigo-400/70 hover:bg-indigo-500/20 sm:mt-8"
		>
			Ver todo el portafolio
			<span class="transition-transform group-hover:translate-x-0.5">→</span>
		</a>
	</div>
</section>

<style>
	.portfolio-scroll {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		margin-left: -1.5rem;
		margin-right: -1.5rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		padding-bottom: 4px;
	}
	.portfolio-scroll::-webkit-scrollbar {
		display: none;
	}
	.portfolio-scroll-item {
		width: 78%;
		flex-shrink: 0;
		scroll-snap-align: center;
	}
	@media (min-width: 640px) {
		.portfolio-scroll {
			overflow-x: visible;
			margin-left: 0;
			margin-right: 0;
			padding-left: 0;
			padding-right: 0;
			padding-bottom: 0;
		}
		.portfolio-scroll-item {
			width: auto;
			flex-shrink: 1;
		}
	}
</style>
