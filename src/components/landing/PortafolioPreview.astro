---
import { getCollection } from 'astro:content';
import PlantillaCard from '../PlantillaCard.astro';

const plantillas = await getCollection('plantillas');
const preview = plantillas
	.filter((p) => p.data.categoria !== 'cliente' && p.data.estado !== 'privado' && p.data.imagen)
	.slice(0, 3);
---

<section id="portafolio" data-page class="scroll-mt-20 flex min-h-dvh flex-col justify-center border-t border-zinc-800 py-16 sm:py-20">
	<div class="reveal mx-auto max-w-5xl px-6">
		<p class="text-sm tracking-widest text-indigo-400 uppercase">Portafolio</p>
		<h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Plantillas y ejemplos reales</h2>
		<p class="mt-4 max-w-2xl text-zinc-400">
			Así se ven nuestras tarjetas NFC en la práctica. Elige el sector o el estilo más parecido al tuyo.
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-3">
			{
				preview.map((p) => (
					<PlantillaCard
						nombre={p.data.nombre}
						descripcion={p.data.descripcion}
						sector={p.data.sector}
						colorHex={p.data.colorHex}
						imagen={p.data.imagen}
						ruta={p.data.ruta}
					/>
				))
			}
		</div>

		<a
			href="/portafolio"
			class="mt-8 inline-block text-sm font-medium text-zinc-300 transition-colors hover:text-white"
		>
			Ver todo el portafolio →
		</a>
	</div>
</section>
