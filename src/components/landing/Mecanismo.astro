---
import ContactoDemo from './ContactoDemo.astro';
import ResenasDemo from './ResenasDemo.astro';
import WhatsAppCTA from '../WhatsAppCTA.astro';

// negocios de ejemplo para las animaciones de los móviles — plantillas/colores reales
// del portafolio. Cada demo usa las suyas propias, sin repetir entre las dos.
// tapX/tapY: centro real del enlace "Guardar contacto" (o "vCard") en cada
// plantilla, en % de su captura (640×1362) — medidos sobre la imagen ampliada
// con una retícula, porque los valores anteriores caían entre dos botones o
// sobre el icono del teléfono. Como la pantalla del móvil tiene casi la misma
// proporción que la captura, el % de la imagen coincide con el de la pantalla.
// Arcade Studio se quitó de aquí: esa plantilla no tiene ningún botón de
// guardar contacto, así que no hay nada real que señalar en ella.
const demosContacto = [
	{ sector: 'Inmobiliarias', negocio: 'Plano Inmobiliaria', color: '#ff6a3d', imagen: '/plantillas/inmobiliarias-blueprint.png', tapX: 50, tapY: 62 },
	{ sector: 'Seguros', negocio: 'Vitalia Seguros', color: '#5B93E8', imagen: '/plantillas/seguros-estandar.png', tapX: 50, tapY: 60 },
	{ sector: 'Inmobiliarias', negocio: 'Costa Norte', color: '#2B6E4E', imagen: '/plantillas/inmobiliarias-editorial.png', tapX: 11, tapY: 85.8 },
	{ sector: 'Autónomos', negocio: 'Terminal Dev', color: '#4fd1c5', imagen: '/plantillas/cv-terminal.png', tapX: 64.7, tapY: 64.1 },
];
const demosResenas = [
	{ sector: 'Inmobiliarias', negocio: 'Editorial Home', color: '#2B6E4E', imagen: '/plantillas/inmobiliarias-editorial.png' },
	{ sector: 'Inmobiliarias', negocio: 'Clásica Inmo', color: '#E3B24E', imagen: '/plantillas/inmobiliarias-estandar.png' },
	{ sector: 'Otras ideas', negocio: 'Enlace Personal', color: '#E8A33D', imagen: '/plantillas/otras-ideas-linktree.jpg' },
	{ sector: 'Autónomos', negocio: 'Foto & Freelance', color: '#F0B94D', imagen: '/plantillas/cv-fotografico.png' },
];

const ramas = [
	{
		id: 'personal',
		accentHex: '#6366f1',
		kicker: 'Contacto personal',
		titulo: 'Guarda tu contacto',
		descripcion: 'Tu perfil se abre al instante y, con un botón, tus datos quedan guardados en el móvil del otro para siempre.',
		chips: ['Contacto, redes y portfolio en un toque', 'Landing a tu marca, no una plantilla', 'Actualizamos tus datos cuando quieras'],
		pasos: ['Acerca la tarjeta', 'Se abre tu perfil', 'Guarda tu contacto'],
		ctaTexto: 'Pide tu tarjeta personal',
		ctaMensaje: 'Hola, quiero una tarjeta NFC personal',
		mockupTipo: 'contacto' as const,
		mockupNegocio: 'tu perfil',
	},
	{
		id: 'resenas',
		accentHex: '#f59e0b',
		kicker: 'Reseñas de Google',
		titulo: 'Deja una reseña',
		descripcion: 'Aterriza directo en la ventana de reseña de tu ficha de Google — sin apps, sin buscar el negocio, sin escribir el nombre.',
		chips: ['Enlace directo a tu ficha de Google', 'No alojamos ninguna página nueva', 'La tarjeta no caduca ni se actualiza'],
		pasos: ['Acerca la tarjeta', 'Se abre tu ficha', 'Reseña publicada'],
		ctaTexto: 'Pide tu tarjeta de reseñas',
		ctaMensaje: 'Hola, quiero tarjetas NFC para reseñas de Google',
		mockupTipo: 'resena' as const,
		mockupNegocio: 'tu negocio',
	},
];
---

<section id="productos" data-animate class="border-b border-zinc-800 py-24 sm:py-32">
	<div class="mecanismo-scope mx-auto max-w-6xl px-5 sm:px-6">
		<div data-reveal class="piece piece-top piece-d0 mx-auto max-w-xl text-center">
			<p class="text-sm font-bold tracking-widest text-indigo-400 uppercase">El mecanismo</p>
			<h2 class="mt-2 text-3xl font-semibold text-white sm:text-4xl">Un toque. Dos caminos posibles.</h2>
			<p class="mt-3 text-lg text-zinc-400">Tú decides por qué camino llevas a tu cliente.</p>
		</div>

		<div data-reveal class="piece piece-pop piece-d1 relative mx-auto mt-14 flex max-w-xs flex-col items-center">
			<div class="nfc-origin relative grid h-16 w-16 place-items-center rounded-full border border-zinc-700 bg-zinc-900">
				<span class="nfc-origin-ring absolute inset-0 rounded-full border border-indigo-400/50"></span>
				<span class="nfc-origin-ring absolute inset-0 rounded-full border border-amber-400/50" style="animation-delay:1s"></span>
				<span class="nfc-origin-burst absolute inset-0 rounded-full" data-burst="personal" aria-hidden="true"></span>
				<span class="nfc-origin-burst absolute inset-0 rounded-full" data-burst="resenas" aria-hidden="true"></span>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e4e4e7" stroke-width="1.8">
					<path d="M6 8.5a8 8 0 0 1 0 7M9.5 6a12 12 0 0 1 0 12M13 3.5a16 16 0 0 1 0 17" />
				</svg>
			</div>
			<p class="mt-3 text-xs font-semibold tracking-wide text-zinc-400 uppercase">Acercas la tarjeta al móvil</p>
		</div>

		<svg class="fork-connector mt-2 hidden w-full lg:block" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true">
			<path
				class="fork-connector-path"
				data-fork="personal"
				d="M50,0 L50,12 C50,18 48,18 36,18 L27,18 C24,18 24,20 24,24 L24,34"
				fill="none"
				stroke="#3f3f46"
				stroke-width="0.4"
				vector-effect="non-scaling-stroke"
			/>
			<path
				class="fork-connector-path"
				data-fork="resenas"
				d="M50,0 L50,12 C50,18 52,18 64,18 L73,18 C76,18 76,20 76,24 L76,34"
				fill="none"
				stroke="#3f3f46"
				stroke-width="0.4"
				vector-effect="non-scaling-stroke"
			/>
		</svg>

		<div class="mt-10 grid gap-8 lg:mt-6 lg:grid-cols-2 lg:gap-8">
			{
				ramas.map((r, i) => (
					<div
						data-reveal
						data-rama={r.id}
						class={`piece ${i === 0 ? 'piece-left' : 'piece-right'} piece-d2 rama-card flex h-full min-w-0 flex-col items-center justify-between rounded-3xl border border-zinc-800 bg-zinc-900/40 p-6 text-center sm:p-8`}
						style={`--p-accent:${r.accentHex}`}
					>
						<div class="min-w-0 max-w-sm">
							<p class="text-xs font-bold tracking-widest uppercase" style={`color:${r.accentHex}`}>
								{r.kicker}
							</p>
							<h3 class="mt-1.5 text-2xl font-semibold text-white">{r.titulo}</h3>

							<p class="mt-3 text-sm text-zinc-400">{r.descripcion}</p>

							<div class="mt-5 grid gap-2.5 text-left">
								{r.chips.map((chip) => (
									<div class="flex items-start gap-2.5">
										<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${r.accentHex}`} />
										<span class="text-[13px] text-zinc-300">{chip}</span>
									</div>
								))}
							</div>

							<ol class="mt-5 flex min-h-[28px] flex-wrap items-start justify-center gap-1.5 sm:flex-nowrap">
								{r.pasos.map((paso, idx) => (
									<li class="flex items-center gap-1.5 rounded-full border border-zinc-800 bg-white/[0.03] py-1 pr-2.5 pl-1 text-[11px] whitespace-nowrap text-zinc-400">
										<span
											class="grid h-[16px] w-[16px] shrink-0 place-items-center rounded-full text-[8.5px] font-bold text-zinc-950"
											style={`background:${r.accentHex}`}
										>
											{idx + 1}
										</span>
										{paso}
									</li>
								))}
							</ol>

							<div class="mt-6">
								<WhatsAppCTA texto={r.ctaTexto} mensaje={r.ctaMensaje} variant={r.accentHex === '#f59e0b' ? 'amber' : 'brand'} />
							</div>
						</div>

						<div class="mt-8 flex w-full justify-center">
							{r.mockupTipo === 'contacto' ? <ContactoDemo demos={demosContacto} /> : <ResenasDemo demos={demosResenas} />}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.nfc-origin-ring {
		animation: nfc-origin-pulse 2.6s ease-out infinite;
	}
	@keyframes nfc-origin-pulse {
		0% {
			transform: scale(0.9);
			opacity: 0.9;
		}
		100% {
			transform: scale(2.4);
			opacity: 0;
		}
	}
	.rama-card {
		transition:
			transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}
	.rama-card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--p-accent) 55%, #3f3f46);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--p-accent) 35%, transparent) inset,
			0 22px 44px -18px color-mix(in srgb, var(--p-accent) 55%, transparent);
	}

	/* el caminito se rellena de color al pasar el ratón por la tarjeta que llega a él
	   — morado para contacto, ámbar para reseñas — para que se note la conexión */
	.fork-connector-path {
		transition:
			stroke 0.3s ease,
			stroke-width 0.3s ease,
			opacity 0.3s ease;
		opacity: 0.6;
	}
	.mecanismo-scope:has(.rama-card[data-rama='personal']:hover) .fork-connector-path[data-fork='personal'] {
		stroke: #6366f1;
		stroke-width: 1.1;
		opacity: 1;
	}
	.mecanismo-scope:has(.rama-card[data-rama='resenas']:hover) .fork-connector-path[data-fork='resenas'] {
		stroke: #f59e0b;
		stroke-width: 1.1;
		opacity: 1;
	}

	/* al pasar el ratón, además de iluminarse el camino, el origen lanza un pulso
	   propio — del color del producto y más grande y llamativo que el pulso normal */
	.nfc-origin-burst {
		opacity: 0;
		border: 2px solid transparent;
	}
	.mecanismo-scope:has(.rama-card[data-rama='personal']:hover) .nfc-origin-burst[data-burst='personal'] {
		border-color: #818cf8;
		animation: nfc-burst-pulse 0.9s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.mecanismo-scope:has(.rama-card[data-rama='resenas']:hover) .nfc-origin-burst[data-burst='resenas'] {
		border-color: #f59e0b;
		animation: nfc-burst-pulse 0.9s cubic-bezier(0.16, 1, 0.3, 1);
	}
	@keyframes nfc-burst-pulse {
		0% {
			opacity: 0.95;
			transform: scale(0.85);
		}
		100% {
			opacity: 0;
			transform: scale(3.4);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.nfc-origin-ring {
			animation: none;
		}
		.nfc-origin-burst {
			animation: none !important;
		}
	}
</style>

<script>
	// las dos demos de móvil (contacto y reseñas) comparten un único reloj — para
	// que el momento de "contacto" (flash) y el de "toque" (botón/estrellas)
	// coincidan siempre en ambas. Toda la coreografía vive en @keyframes de
	// 8800ms dentro de cada componente (ver ContactoDemo.astro/ResenasDemo.astro);
	// aquí solo se decide qué negocio enseña cada móvil.
	//
	// Antes eso lo hacía un setInterval(8800) aparte, y se desacompasaba de las
	// animaciones CSS: al cambiar de pestaña el navegador frena los temporizadores
	// pero no el reloj de las animaciones, y a la vuelta la plantilla cambiaba a
	// media animación (el toque caía descolocado). Ahora el cambio de negocio lo
	// dispara el propio reloj CSS: el evento animationiteration de la tarjeta,
	// que salta exactamente al terminar cada ciclo.
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const stages = Array.from(document.querySelectorAll<HTMLElement>('.demo-stage'));
	const clock = document.querySelector<HTMLElement>('.demo-contacto .demo-card');

	if (stages.length && clock && !reduceMotion) {
		const totalSteps = Math.max(...stages.map((s) => Number(s.dataset.totalSteps ?? 1)));
		let step = 0;

		const setStep = (n: number) => {
			stages.forEach((stage) => {
				stage.dataset.activeStep = String(n);
				stage.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => {
					el.classList.toggle('is-current', el.dataset.step === String(n));
				});
			});
		};

		setStep(step);
		// arranca todas las animaciones de ambos móviles en el mismo instante
		stages.forEach((stage) => stage.getAnimations({ subtree: true }).forEach((a) => (a.currentTime = 0)));

		clock.addEventListener('animationiteration', (e) => {
			if (e.animationName !== 'demo-card-cycle') return;
			step = (step + 1) % totalSteps;
			setStep(step);
		});
	}
</script>
