---
import NfcMockup from '../NfcMockup.astro';
import ComoFunciona from '../ComoFunciona.astro';
import StatsGrid from '../StatsGrid.astro';
import WhatsAppCTA from '../WhatsAppCTA.astro';

interface Paso {
	titulo: string;
	descripcion: string;
}

interface Props {
	id: string;
	navLabel: string;
	numero: string;
	titulo: string;
	descripcion: string;
	paraQuien: string;
	accent?: 'amber' | 'brand';
	accentHex: string;
	mockupTipo: 'resena' | 'contacto';
	mockupNegocio: string;
	pasos: Paso[];
	ctaTexto: string;
	ctaMensaje: string;
	conStats?: boolean;
}

const {
	id,
	navLabel,
	numero,
	titulo,
	descripcion,
	paraQuien,
	accent = 'brand',
	accentHex,
	mockupTipo,
	mockupNegocio,
	pasos,
	ctaTexto,
	ctaMensaje,
	conStats = false,
} = Astro.props;

const accentText = accent === 'brand' ? 'text-indigo-400' : 'text-amber-400';
const ctaVariant = accent === 'amber' ? 'amber' : 'brand';
---

<section
	id={id}
	data-page
	data-nav={navLabel}
	class="flex min-h-dvh flex-col border-t border-zinc-800 py-16 sm:py-20"
>
	<div class="reveal m-auto max-w-5xl px-6">
		<p class={`text-sm tracking-widest uppercase ${accentText}`}>{numero}</p>
		<h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{titulo}</h2>
		<p class="mt-4 max-w-2xl text-lg text-zinc-400">{descripcion}</p>
		<p class="mt-2 text-sm text-zinc-500">{paraQuien}</p>

		<div class="mt-8">
			<WhatsAppCTA texto={ctaTexto} mensaje={ctaMensaje} variant={ctaVariant} />
		</div>

		<div class="mt-12">
			<NfcMockup color={accentHex} negocio={mockupNegocio} tipo={mockupTipo} />
		</div>

		<div class="mt-12 max-w-2xl">
			<ComoFunciona kicker="Cómo funciona" titulo="En 3 pasos" pasos={pasos} accent={accent} />
		</div>

		{
			conStats && (
				<div class="mt-4">
					<StatsGrid />
				</div>
			)
		}
	</div>
</section>
