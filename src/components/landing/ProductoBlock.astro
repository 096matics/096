---
import NfcMockup from '../NfcMockup.astro';
import ComoFunciona from '../ComoFunciona.astro';
import StatsGrid from '../StatsGrid.astro';
import WhatsAppCTA from '../WhatsAppCTA.astro';

interface Paso {
	titulo: string;
	descripcion: string;
}

interface Props {
	id: string;
	navLabel: string;
	numero: string;
	titulo: string;
	descripcion: string;
	paraQuien: string;
	accent?: 'amber' | 'brand';
	accentHex: string;
	glowA?: string;
	glowB?: string;
	mockupTipo: 'resena' | 'contacto';
	mockupNegocio: string;
	pasos: Paso[];
	ctaTexto: string;
	ctaMensaje: string;
	conStats?: boolean;
}

const {
	id,
	navLabel,
	numero,
	titulo,
	descripcion,
	paraQuien,
	accent = 'brand',
	accentHex,
	glowA,
	glowB,
	mockupTipo,
	mockupNegocio,
	pasos,
	ctaTexto,
	ctaMensaje,
	conStats = false,
} = Astro.props;

const accentText = accent === 'brand' ? 'text-indigo-400' : 'text-amber-400';
const ctaVariant = accent === 'amber' ? 'amber' : 'brand';

const social =
	mockupTipo === 'contacto'
		? 'Contacto guardado en menos de 10 segundos, sin apps ni tarjetas de papel.'
		: '★★★★★ reseña dejada en menos de 10 segundos, sin salir de la app de Google.';
---

<section
	id={id}
	data-page
	data-nav={navLabel}
	data-glow-a={glowA}
	data-glow-b={glowB}
	class="flex min-h-dvh flex-col border-t border-zinc-800 px-6 py-6 sm:py-12"
>
	<div class="m-auto grid w-full max-w-6xl gap-4 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-14">
		<div>
			<p class={`piece piece-top piece-d0 text-sm tracking-widest uppercase ${accentText}`}>{numero}</p>
			<h2 class="piece piece-left piece-d1 mt-1.5 text-3xl font-semibold text-white sm:mt-2 sm:text-4xl">
				{titulo}
			</h2>
			<p class="piece piece-left piece-d2 mt-2 max-w-xl text-lg text-zinc-400 sm:mt-3">{descripcion}</p>
			<p class="piece piece-left piece-d2 mt-1.5 text-sm text-zinc-500 sm:mt-2">{paraQuien}</p>

			<div class="piece piece-bottom piece-d3 mt-3 flex flex-wrap items-center gap-4 sm:mt-5">
				<WhatsAppCTA texto={ctaTexto} mensaje={ctaMensaje} variant={ctaVariant} />
				<p class="text-xs text-zinc-500">{social}</p>
			</div>

			<div class="piece piece-bottom piece-d4 mt-4 sm:mt-6">
				<ComoFunciona kicker="Cómo funciona" titulo="En 3 pasos" pasos={pasos} accent={accent} />
			</div>

			{
				conStats && (
					<div class="piece piece-bottom piece-d5 mt-2 sm:mt-3">
						<StatsGrid />
					</div>
				)
			}
		</div>

		<div class="piece piece-pop piece-d2 hidden justify-center sm:flex lg:justify-end">
			<NfcMockup color={accentHex} negocio={mockupNegocio} tipo={mockupTipo} compact />
		</div>
	</div>
</section>
