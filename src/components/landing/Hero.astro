---
import WhatsAppCTA from '../WhatsAppCTA.astro';
---

<section
	id="top"
	data-page
	data-nav="Inicio"
	data-glow-a="#6366f1"
	data-glow-b="#a855f7"
	class="flex min-h-dvh flex-col"
>
	<div class="m-auto max-w-5xl px-6 py-20 text-center sm:py-28">
		<p class="piece piece-top piece-d0 text-sm tracking-widest text-indigo-400 uppercase">
			Tarjetas NFC para negocios locales
		</p>
		<h1 class="piece-pixel piece-d1 mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
			Tu reputación y tu contacto, en un solo toque.
		</h1>
		<p class="piece piece-bottom piece-d2 mx-auto mt-6 max-w-2xl text-lg text-zinc-400">
			096matics lleva tarjetas NFC a negocios y profesionales de la Comunidad Valenciana: reseñas de Google
			sin fricción, y tarjetas de contacto digitales para tu equipo.
		</p>
		<div class="piece piece-bottom piece-d3 mt-10 flex items-center justify-center gap-6">
			<WhatsAppCTA texto="Habla con nosotros" mensaje="Hola, quiero información sobre 096matics" />
			<a href="#producto-personal" class="text-sm font-medium text-zinc-300 transition-colors hover:text-white">
				Ver cómo funciona ↓
			</a>
		</div>
	</div>
</section>
