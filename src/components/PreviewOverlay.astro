---
---

<div id="previewOverlay" class="preview-overlay" aria-hidden="true">
	<div class="preview-backdrop"></div>
	<button id="previewPrev" class="preview-arrow preview-arrow-prev" aria-label="Anterior">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
	</button>
	<button id="previewNext" class="preview-arrow preview-arrow-next" aria-label="Siguiente">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
	</button>
	<div class="preview-panel">
		<button id="previewClose" class="preview-close" aria-label="Cerrar">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
		</button>
		<div class="preview-media">
			<img id="previewImg" src="" alt="" />
		</div>
		<div class="preview-info">
			<div class="preview-info-top">
				<p id="previewSector" class="preview-sector"></p>
				<p id="previewCounter" class="preview-counter"></p>
			</div>
			<h3 id="previewTitle" class="preview-title"></h3>
			<p id="previewDesc" class="preview-desc"></p>
			<ul id="previewNotes" class="preview-notes"></ul>
			<a id="previewCta" class="preview-cta" href="#" target="_blank" rel="noopener noreferrer">Ver página →</a>
		</div>
	</div>
</div>

<style>
	.preview-overlay {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}
	.preview-overlay.is-open {
		opacity: 1;
		pointer-events: auto;
	}
	.preview-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(5, 5, 8, 0.8);
		backdrop-filter: blur(6px);
	}
	.preview-panel {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 720px;
		max-height: 88vh;
		background: #111114;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 20px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transform: scale(0.94) translateY(10px);
		transition: transform 0.25s cubic-bezier(0.19, 1, 0.22, 1);
	}
	@media (min-width: 720px) {
		.preview-panel {
			flex-direction: row;
			max-height: 78vh;
		}
	}
	.preview-overlay.is-open .preview-panel {
		transform: scale(1) translateY(0);
	}
	.preview-close {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 2;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #fff;
		cursor: pointer;
	}
	.preview-close svg {
		width: 16px;
		height: 16px;
	}
	.preview-arrow {
		position: absolute;
		top: 50%;
		z-index: 2;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(20, 20, 24, 0.7);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #fff;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			background-color 0.2s ease,
			transform 0.2s ease;
	}
	.preview-overlay.is-open .preview-arrow.is-active {
		opacity: 1;
		pointer-events: auto;
	}
	.preview-arrow:hover {
		background: rgba(40, 40, 46, 0.9);
	}
	.preview-arrow svg {
		width: 20px;
		height: 20px;
	}
	.preview-arrow-prev {
		left: 10px;
	}
	.preview-arrow-next {
		right: 10px;
	}
	@media (min-width: 640px) {
		.preview-arrow-prev {
			left: 24px;
		}
		.preview-arrow-next {
			right: 24px;
		}
	}
	.preview-media {
		flex-shrink: 0;
		background: #000;
		display: flex;
		align-items: center;
		justify-content: center;
		max-height: 40vh;
		overflow: hidden;
	}
	@media (min-width: 720px) {
		.preview-media {
			width: 42%;
			max-height: none;
		}
	}
	.preview-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.preview-media.is-empty {
		display: none;
	}
	.preview-info {
		padding: 28px 28px 30px;
		overflow-y: auto;
	}
	.preview-info-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
	}
	.preview-sector {
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #f59e0b;
		margin: 0 0 8px;
	}
	.preview-counter {
		font-size: 11px;
		color: #71717a;
		margin: 0 0 8px;
		white-space: nowrap;
	}
	.preview-title {
		font-size: 22px;
		font-weight: 600;
		color: #fff;
		margin: 0 0 10px;
	}
	.preview-desc {
		font-size: 14px;
		line-height: 1.6;
		color: #a1a1aa;
		margin: 0 0 16px;
	}
	.preview-notes {
		display: none;
		flex-direction: column;
		gap: 8px;
		margin: 0 0 22px;
		padding: 0;
		list-style: none;
	}
	.preview-notes.has-notes {
		display: flex;
	}
	.preview-notes li {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		font-size: 12.5px;
		line-height: 1.5;
		color: #d4d4d8;
	}
	.preview-notes li::before {
		content: '';
		flex-shrink: 0;
		width: 5px;
		height: 5px;
		margin-top: 6px;
		border-radius: 50%;
		background: #818cf8;
	}
	.preview-cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 11px 18px;
		border-radius: 999px;
		background: linear-gradient(135deg, #3b82f6, #a855f7);
		color: #fff;
		text-decoration: none;
		font-size: 13.5px;
		font-weight: 500;
	}
</style>

<script>
	const overlay = document.getElementById('previewOverlay');
	const img = document.getElementById('previewImg') as HTMLImageElement | null;
	const sectorEl = document.getElementById('previewSector');
	const titleEl = document.getElementById('previewTitle');
	const descEl = document.getElementById('previewDesc');
	const notesEl = document.getElementById('previewNotes');
	const ctaEl = document.getElementById('previewCta') as HTMLAnchorElement | null;
	const counterEl = document.getElementById('previewCounter');
	const prevBtn = document.getElementById('previewPrev');
	const nextBtn = document.getElementById('previewNext');

	let group: HTMLElement[] = [];
	let groupIndex = -1;

	function collectGroup(trigger: HTMLElement) {
		const groupName = trigger.dataset.previewGroup;
		const all = Array.from(document.querySelectorAll<HTMLElement>('[data-preview-trigger]'));
		return groupName ? all.filter((el) => el.dataset.previewGroup === groupName) : all;
	}

	function show(trigger: HTMLElement) {
		if (!overlay) return;
		const { previewImg, previewSector, previewTitle, previewDesc, previewHref, previewCta, previewNotes } = trigger.dataset;
		if (img) {
			if (previewImg) {
				img.src = previewImg;
				img.closest('.preview-media')?.classList.remove('is-empty');
			} else {
				img.closest('.preview-media')?.classList.add('is-empty');
			}
		}
		if (sectorEl) sectorEl.textContent = previewSector ?? '';
		if (titleEl) titleEl.textContent = previewTitle ?? '';
		if (descEl) descEl.textContent = previewDesc ?? '';
		if (notesEl) {
			const notes = (previewNotes ?? '').split('|').filter(Boolean);
			notesEl.innerHTML = '';
			notes.forEach((note) => {
				const li = document.createElement('li');
				li.textContent = note;
				notesEl.appendChild(li);
			});
			notesEl.classList.toggle('has-notes', notes.length > 0);
		}
		if (ctaEl && previewHref) {
			ctaEl.href = previewHref;
			ctaEl.textContent = previewCta ?? 'Ver página →';
		}

		group = collectGroup(trigger);
		groupIndex = group.indexOf(trigger);
		const hasMultiple = group.length > 1;
		if (counterEl) counterEl.textContent = hasMultiple ? `${groupIndex + 1} / ${group.length}` : '';
		prevBtn?.classList.toggle('is-active', hasMultiple);
		nextBtn?.classList.toggle('is-active', hasMultiple);

		overlay.classList.add('is-open');
		overlay.setAttribute('aria-hidden', 'false');
		document.documentElement.classList.add('overflow-hidden');
	}

	function step(delta: number) {
		if (group.length < 2) return;
		groupIndex = (groupIndex + delta + group.length) % group.length;
		show(group[groupIndex]);
	}

	function hide() {
		overlay?.classList.remove('is-open');
		overlay?.setAttribute('aria-hidden', 'true');
		document.documentElement.classList.remove('overflow-hidden');
	}

	prevBtn?.addEventListener('click', () => step(-1));
	nextBtn?.addEventListener('click', () => step(1));

	document.addEventListener('click', (e) => {
		const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-preview-trigger]');
		if (trigger) {
			e.preventDefault();
			show(trigger);
			return;
		}
		if ((e.target as HTMLElement).closest('#previewClose')) {
			hide();
			return;
		}
		if (e.target === overlay) hide();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' || e.key === ' ') {
			const trigger = (e.target as HTMLElement)?.closest?.<HTMLElement>('[data-preview-trigger]');
			if (trigger) {
				e.preventDefault();
				show(trigger);
			}
			return;
		}
		if (!overlay?.classList.contains('is-open')) return;
		if (e.key === 'Escape') hide();
		if (e.key === 'ArrowRight') step(1);
		if (e.key === 'ArrowLeft') step(-1);
	});
</script>
