---
interface Props {
	texto: string;
	autor: string;
	negocio: string;
}

const { texto, autor, negocio } = Astro.props;
---

<blockquote class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
	<p class="leading-relaxed text-zinc-200">"{texto}"</p>
	<footer class="mt-4 text-sm text-zinc-400">— {autor}, {negocio}</footer>
</blockquote>
