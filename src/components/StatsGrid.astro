---
const stats = [
	{ valor: '0', etiqueta: 'apps' },
	{ valor: '3s', etiqueta: 'toque → reseña' },
	{ valor: '1', etiqueta: 'toque, nada de escribir' },
	{ valor: 'NFC', etiqueta: 'cualquier móvil moderno' },
];
---

<dl class="grid grid-cols-2 gap-2 sm:grid-cols-4">
	{
		stats.map((stat) => (
			<div class="stat-card rounded-xl border border-zinc-800 bg-zinc-900/40 px-3 py-2.5">
				<dd class="text-lg font-semibold text-amber-400">{stat.valor}</dd>
				<dt class="mt-0.5 text-[11px] leading-tight font-normal text-zinc-500">{stat.etiqueta}</dt>
			</div>
		))
	}
</dl>

<style>
	.stat-card {
		opacity: 0;
	}
	:global([data-page].stack-enter-forward) .stat-card,
	:global([data-page].stack-enter-back) .stat-card {
		animation: stat-pop-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}
	.stat-card:nth-child(1) {
		animation-delay: 0.6s;
	}
	.stat-card:nth-child(2) {
		animation-delay: 0.68s;
	}
	.stat-card:nth-child(3) {
		animation-delay: 0.76s;
	}
	.stat-card:nth-child(4) {
		animation-delay: 0.84s;
	}
	@keyframes stat-pop-in {
		0% {
			opacity: 0;
			transform: scale(0.7) translateY(8px);
		}
		100% {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global([data-page].stack-enter-forward) .stat-card,
		:global([data-page].stack-enter-back) .stat-card {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
