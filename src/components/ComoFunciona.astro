---
interface Paso {
	titulo: string;
	descripcion: string;
}

interface Props {
	kicker: string;
	titulo: string;
	pasos: Paso[];
	accent?: 'amber' | 'brand';
}

const { kicker, titulo, pasos, accent = 'brand' } = Astro.props;
const accentText = accent === 'brand' ? 'text-indigo-400' : 'text-amber-400';
const accentBorder = accent === 'brand' ? 'border-indigo-400/40' : 'border-amber-400/40';
---

<div>
	<p class={`text-xs tracking-widest uppercase ${accentText}`}>{kicker}</p>
	<h3 class="mt-1.5 text-lg font-semibold text-white">{titulo}</h3>
	<ol class="mt-4 grid grid-cols-3 gap-3">
		{
			pasos.map((paso, i) => (
				<li class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-3">
					<span
						class={`flex h-6 w-6 items-center justify-center rounded-full border text-xs font-semibold ${accentBorder} ${accentText}`}
					>
						{i + 1}
					</span>
					<p class="mt-2 text-xs leading-snug font-medium text-white">{paso.titulo}</p>
				</li>
			))
		}
	</ol>
</div>
