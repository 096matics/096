---
interface Paso {
	titulo: string;
	descripcion: string;
}

interface Props {
	kicker: string;
	titulo: string;
	pasos: Paso[];
	accent?: 'amber' | 'brand';
}

const { kicker, titulo, pasos, accent = 'brand' } = Astro.props;
const accentText = accent === 'brand' ? 'text-indigo-400' : 'text-amber-400';
const accentBorder = accent === 'brand' ? 'border-indigo-400/40' : 'border-amber-400/40';
---

<div>
	<p class={`text-xs tracking-widest uppercase ${accentText}`}>{kicker}</p>
	<h3 class="mt-1 text-lg font-semibold text-white sm:mt-1.5">{titulo}</h3>
	<ol data-hscroll class="steps-scroll mt-2 flex gap-2 sm:mt-4 sm:grid sm:grid-cols-3 sm:gap-3">
		{
			pasos.map((paso, i) => (
				<li class="step-card steps-scroll-item rounded-xl border border-zinc-800 bg-zinc-900/40 p-2.5 sm:p-3">
					<span
						class={`flex h-6 w-6 items-center justify-center rounded-full border text-xs font-semibold ${accentBorder} ${accentText}`}
					>
						{i + 1}
					</span>
					<p class="mt-2 text-xs leading-snug font-medium text-white">{paso.titulo}</p>
					<p class="step-desc mt-1 text-[11px] leading-snug text-zinc-500 sm:hidden [@media(max-width:639px)_and_(max-height:780px)]:hidden">
						{paso.descripcion}
					</p>
				</li>
			))
		}
	</ol>
</div>

<style>
	.steps-scroll {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		margin-left: -1.5rem;
		margin-right: -1.5rem;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
		padding-bottom: 2px;
	}
	.steps-scroll::-webkit-scrollbar {
		display: none;
	}
	.steps-scroll-item {
		width: 62%;
		min-width: 0;
		flex-shrink: 0;
		scroll-snap-align: center;
	}
	@media (max-width: 639px) {
		.steps-scroll {
			mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
			-webkit-mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
		}
	}
	@media (min-width: 640px) {
		.steps-scroll {
			margin-left: 0;
			margin-right: 0;
			padding-left: 0;
			padding-right: 0;
		}
		.steps-scroll-item {
			width: auto;
			flex-shrink: 1;
		}
	}
	.step-card {
		opacity: 0;
	}
	:global([data-page].is-revealing) .step-card {
		animation: step-flip-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}
	.step-card:nth-child(1) {
		animation-delay: 0.4s;
	}
	.step-card:nth-child(2) {
		animation-delay: 0.5s;
	}
	.step-card:nth-child(3) {
		animation-delay: 0.6s;
	}
	@keyframes step-flip-in {
		0% {
			opacity: 0;
			transform: perspective(600px) rotateX(-55deg) translateY(10px);
		}
		100% {
			opacity: 1;
			transform: perspective(600px) rotateX(0) translateY(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global([data-page].is-revealing) .step-card {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
