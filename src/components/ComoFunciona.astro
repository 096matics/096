---
interface Paso {
	titulo: string;
	descripcion: string;
}

interface Props {
	kicker: string;
	titulo: string;
	pasos: Paso[];
	accent?: 'amber' | 'brand';
}

const { kicker, titulo, pasos, accent = 'brand' } = Astro.props;
const accentText = accent === 'brand' ? 'text-indigo-400' : 'text-amber-400';
const accentBorder = accent === 'brand' ? 'border-indigo-400/40' : 'border-amber-400/40';
---

<div>
	<p class={`text-sm tracking-widest uppercase ${accentText}`}>{kicker}</p>
	<h3 class="mt-3 text-2xl font-semibold text-white">{titulo}</h3>
	<ol class="mt-8 space-y-8">
		{
			pasos.map((paso, i) => (
				<li class="flex gap-4">
					<div class="flex flex-col items-center">
						<span
							class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full border text-sm font-semibold ${accentBorder} ${accentText}`}
						>
							{i + 1}
						</span>
						{i < pasos.length - 1 && <span class="mt-1 w-px flex-1 bg-zinc-800" />}
					</div>
					<div class="pb-2">
						<h4 class="text-base font-medium text-white">{paso.titulo}</h4>
						<p class="mt-1 text-sm text-zinc-400">{paso.descripcion}</p>
					</div>
				</li>
			))
		}
	</ol>
</div>
