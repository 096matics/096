---
interface Paso {
	titulo: string;
	descripcion: string;
}

interface Props {
	kicker: string;
	titulo: string;
	pasos: Paso[];
	accent?: 'amber' | 'brand';
}

const { kicker, titulo, pasos, accent = 'brand' } = Astro.props;
const accentText = accent === 'brand' ? 'text-indigo-400' : 'text-amber-400';
const accentBorder = accent === 'brand' ? 'border-indigo-400/40' : 'border-amber-400/40';
---

<div>
	<p class={`text-xs tracking-widest uppercase ${accentText}`}>{kicker}</p>
	<h3 class="mt-1.5 text-lg font-semibold text-white">{titulo}</h3>
	<ol class="mt-4 grid grid-cols-3 gap-3">
		{
			pasos.map((paso, i) => (
				<li class="step-card rounded-xl border border-zinc-800 bg-zinc-900/40 p-3">
					<span
						class={`flex h-6 w-6 items-center justify-center rounded-full border text-xs font-semibold ${accentBorder} ${accentText}`}
					>
						{i + 1}
					</span>
					<p class="mt-2 text-xs leading-snug font-medium text-white">{paso.titulo}</p>
				</li>
			))
		}
	</ol>
</div>

<style>
	.step-card {
		opacity: 0;
	}
	:global([data-page].is-revealing) .step-card {
		animation: step-flip-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}
	.step-card:nth-child(1) {
		animation-delay: 0.4s;
	}
	.step-card:nth-child(2) {
		animation-delay: 0.5s;
	}
	.step-card:nth-child(3) {
		animation-delay: 0.6s;
	}
	@keyframes step-flip-in {
		0% {
			opacity: 0;
			transform: perspective(600px) rotateX(-55deg) translateY(10px);
		}
		100% {
			opacity: 1;
			transform: perspective(600px) rotateX(0) translateY(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global([data-page].is-revealing) .step-card {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
