---
interface Props {
	texto?: string;
	mensaje?: string;
	class?: string;
}

const {
	texto = 'Habla con nosotros por WhatsApp',
	mensaje = 'Hola, quiero información sobre las tarjetas NFC de 096matics',
	class: className = '',
} = Astro.props;

const href = `https://wa.me/34727700065?text=${encodeURIComponent(mensaje)}`;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class={`inline-flex items-center gap-2 rounded-full bg-amber-400 px-5 py-3 text-sm font-medium text-zinc-950 transition-colors hover:bg-amber-300 ${className}`}
>
	{texto}
</a>
