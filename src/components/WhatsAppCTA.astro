---
interface Props {
	texto?: string;
	mensaje?: string;
	class?: string;
	variant?: 'brand' | 'amber';
}

const {
	texto = 'Habla con nosotros por WhatsApp',
	mensaje = 'Hola, quiero información sobre las tarjetas NFC de 096matics',
	class: className = '',
	variant = 'brand',
} = Astro.props;

const href = `https://wa.me/34727700065?text=${encodeURIComponent(mensaje)}`;

const styles =
	variant === 'amber'
		? 'bg-amber-400 text-zinc-950 hover:bg-amber-300'
		: 'bg-gradient-to-r from-blue-600 to-purple-600 text-white hover:from-blue-500 hover:to-purple-500';
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class={`whatsapp-cta relative inline-flex items-center gap-2 overflow-hidden rounded-full px-5 py-3 text-sm font-medium transition-colors ${styles} ${className}`}
>
	{texto}
</a>

<style>
	.whatsapp-cta {
		isolation: isolate;
	}
	.whatsapp-cta::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.35) 50%, transparent 70%);
		background-size: 200% 100%;
		background-position: 150% 0;
		animation: cta-sheen 3.5s ease-in-out infinite;
		pointer-events: none;
	}
	@keyframes cta-sheen {
		0%,
		40% {
			background-position: 150% 0;
		}
		100% {
			background-position: -50% 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.whatsapp-cta::after {
			animation: none;
			display: none;
		}
	}
</style>
